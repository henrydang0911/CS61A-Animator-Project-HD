{"data":{"deltas":[{"range":{"end":{"character":0,"line":39},"start":{"character":0,"line":35}},"text":"  let s = 80 + shape_slider * 2\n  [\n    Path(Line(Point(0 - s, s / 2), Point(s, s / 2)), 0, 12, 4),\n    Path(Line(Point(s, s / 2), Point(0, 0 - s)), 8, 22, 4),\n    Path(Line(Point(0, 0 - s), Point(0 - s, s / 2)), 16, 30, 4),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"aac1f0977b6b45cc38d6f856b8536f74f25627f2f9dfdcbc8ab22d45d6d2f5fc","kind":"doc.change","prev_hash":"138032a5bfd7bc21652181142861874a99d92cb14f8d916bf3abaa6efd0bffb4","seq":435,"t":7077954,"wall":"2026-11-23T00:26:12.804Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":98},"start":{"character":0,"line":71}},"text":"    // Passed into draw(shape_slider); changes geometry only, never speed.\n    shape_slider: Int,\n    // Animation speed as a percent of normal: 100 = 1×,\n    // negatives play backward (−500 = −5× … 500 = 5×).\n    speed_percent: Int,\n    // When True, the clock is frozen (rate 0) until Play.\n    paused: Bool,\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  SetShape(Int)\n  SetSpeed(Int)\n  PauseAnimation\n  PlayAnimation\n  RestartAnimation\n\n  // Layout controls\n  ToggleCode\n}\n\n// ── Init ───────────────────────────────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  #(\n    Model(\n      source: \"\",\n      code_open: True,\n      error: None,\n      shape_slider: 10,\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"3697ba06e068a54e65736d1b37ab00ff0fed1821b341b8b6a5c49661d36d89e0","kind":"doc.change","prev_hash":"aac1f0977b6b45cc38d6f856b8536f74f25627f2f9dfdcbc8ab22d45d6d2f5fc","seq":436,"t":7080991,"wall":"2026-11-23T00:26:15.841Z"}
{"data":{"active_file":"src/app.gleam","focused":true,"idle_since_ms":778.5937999999151},"hash":"cbfa3f7f9abdb5e37510f16f5bbc7f6b1ea9d707b1b36df254eb05578739b651","kind":"session.heartbeat","prev_hash":"3697ba06e068a54e65736d1b37ab00ff0fed1821b341b8b6a5c49661d36d89e0","seq":437,"t":7081769,"wall":"2026-11-23T00:26:16.619Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":167},"start":{"character":0,"line":154}},"text":"fn to_render_paths(paths: List(Path)) -> List(render.RenderPath) {\n  list.index_map(paths, fn(path, i) {\n    render.render_path(path, manim_color(i))\n  })\n}\n\n/// Turn Paths into RenderPaths with cycling Manim colours, then push them to\n/// the canvas and restart the clock so each edit plays like a fresh construction.\nfn animate(paths: List(Path), speed_percent: Int, paused: Bool) -> Effect(Msg) {\n  let rendered = to_render_paths(paths)\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n    render.set_drawing(rendered)\n  })\n}\n\n/// Swap geometry for a new shape_slider value without touching speed or clock.\nfn update_drawing(paths: List(Path)) -> Effect(Msg) {\n  let rendered = to_render_paths(paths)\n  effect.from(fn(_) { render.set_drawing(rendered) })\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"04700e95fa5bda48d2ce97b0d4c3e9fa862d73679f26d74c02c298eedc11acf1","kind":"doc.change","prev_hash":"cbfa3f7f9abdb5e37510f16f5bbc7f6b1ea9d707b1b36df254eb05578739b651","seq":438,"t":7083907,"wall":"2026-11-23T00:26:18.757Z"}
{"data":{"intercepted_count":0,"large_insert_count":2},"hash":"5f49bf0d642c927ee382e792d4fbcd6bc2745213bbe9587be74cb887fa03b9e9","kind":"paste.anomaly","prev_hash":"04700e95fa5bda48d2ce97b0d4c3e9fa862d73679f26d74c02c298eedc11acf1","seq":439,"t":7085797,"wall":"2026-11-23T00:26:20.647Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":259},"start":{"character":0,"line":223}},"text":"    SetShape(value) -> {\n      let shape_slider = int.clamp(value, 0, 100)\n      let model = Model(..model, shape_slider: shape_slider)\n      case run_source(shape_slider, model.source) {\n        Ok(paths) -> #(\n          Model(..model, error: None),\n          // Geometry only — do not call set_speed or reset_clock.\n          update_drawing(paths),\n        )\n        Error(err) -> #(\n          Model(..model, error: Some(err)),\n          clear_drawing(),\n        )\n      }\n    }\n\n    SetSpeed(percent) -> {\n      let speed_percent = int.clamp(percent, -500, 500)\n      // Dragging the slider resumes playback at the new rate.\n      let paused = False\n      #(\n        Model(..model, speed_percent: speed_percent, paused: paused),\n        apply_speed(speed_percent, paused),\n      )\n    }\n\n    PauseAnimation -> #(\n      Model(..model, paused: True),\n      apply_speed(model.speed_percent, True),\n    )\n\n    PlayAnimation -> {\n      // If the slider is at 0×, bump to 1× so Play actually moves.\n      let speed_percent = case model.speed_percent {\n        0 -> 100\n        n -> n\n      }\n      #(\n        Model(..model, paused: False, speed_percent: speed_percent),\n        apply_speed(speed_percent, False),\n      )\n    }\n\n    RestartAnimation -> #(\n      model,\n      restart_animation(model.speed_percent, model.paused),\n    )\n\n    // After each keystroke in the editor, evaluate user code and animate (or\n    // report an error).\n    SetCode(text) ->\n      case run_source(model.shape_slider, text) {\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"62525855b1e340fec306426068b34a7768cbe8d066e8145453db2a59f2822fd6","kind":"doc.change","prev_hash":"5f49bf0d642c927ee382e792d4fbcd6bc2745213bbe9587be74cb887fa03b9e9","seq":440,"t":7088638,"wall":"2026-11-23T00:26:23.488Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":324},"start":{"character":0,"line":310}},"text":"    view_controls(model),\n    html.canvas([attr.id(\"animation-canvas\"), attr.class(\"canvas\")]),\n    view_error(model),\n  ])\n}\n\nfn view_controls(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"anim-controls\")], [\n    html.label([attr.class(\"slider-label\")], [\n      html.span([], [\n        html.text(\"Shape \" <> int.to_string(model.shape_slider)),\n      ]),\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"0\"),\n        attr.max(\"100\"),\n        attr.step(\"1\"),\n        attr.value(int.to_string(model.shape_slider)),\n        attr.attribute(\"data-test-id\", \"shape-slider\"),\n        attr.attribute(\"title\", \"shape_slider passed to draw (not speed)\"),\n        event.on_input(fn(raw) {\n          SetShape(result.unwrap(int.parse(raw), model.shape_slider))\n        }),\n      ]),\n    ]),\n    html.label([attr.class(\"slider-label\")], [\n      html.span([], [\n        html.text(\n          \"Speed \" <> float.to_string(speed_rate(model.speed_percent)) <> \"×\",\n        ),\n      ]),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"7795241e5f5e34dda27de5c028cff041659feabbc0a9d4e6de97f8415b825803","kind":"doc.change","prev_hash":"62525855b1e340fec306426068b34a7768cbe8d066e8145453db2a59f2822fd6","seq":441,"t":7095654,"wall":"2026-11-23T00:26:30.504Z"}
