{"data":{"content":"fn restart_animation(speed_percent: Int) -> Effect(Msg) {\n  let rate = speed_rate(speed_percent)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n  })\n}\n\n","length":179,"path":"src\\app.gleam","range":{"end":{"character":0,"line":166},"start":{"character":0,"line":166}},"sha256":"49e892de736f0efeb6eaec34a7909d14456692fd48d09d95690d7440020bfa9d"},"hash":"ae13b6369f2c755055b4317251b46b100d40f8d56ec8fe70d828f77123c5f629","kind":"paste","prev_hash":"92c96340ddb657b644001379463d4e69d55614e4909b3cdd7d193539a93b17ea","seq":371,"t":6145533,"wall":"2026-11-23T00:10:40.383Z"}
