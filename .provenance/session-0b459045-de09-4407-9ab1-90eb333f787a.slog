{"data":{"deltas":[{"range":{"end":{"character":0,"line":90},"start":{"character":0,"line":70}},"text":"    // Animation speed as a percent of normal: 100 = 1×,\n    // negatives play backward (−500 = −5× … 500 = 5×).\n    speed_percent: Int,\n    // When True, the clock is frozen (rate 0) until Play.\n    paused: Bool,\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  SetSpeed(Int)\n  PauseAnimation\n  PlayAnimation\n  RestartAnimation\n\n  // Layout controls\n  ToggleCode\n}\n\n// ── Init ───────────────────────────────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  #(\n    Model(\n      source: \"\",\n      code_open: True,\n      error: None,\n      speed_percent: 100,\n      paused: False,\n    ),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"0b0b5b8bda6e0566e4f4110db9f3172f2e807bd7f67243ac7e277b984ed2eed3","kind":"doc.change","prev_hash":"38de0a4984b4d741b1c8078490669c357ff7756780bc268c9bf30ee0e2913f50","seq":396,"t":6431359,"wall":"2026-11-23T00:15:26.209Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":187},"start":{"character":0,"line":151}},"text":"fn animate(paths: List(Path), speed_percent: Int, paused: Bool) -> Effect(Msg) {\n  let rendered =\n    list.index_map(paths, fn(path, i) {\n      render.render_path(path, manim_color(i))\n    })\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n    render.set_drawing(rendered)\n  })\n}\n\nfn clear_drawing() -> Effect(Msg) {\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_drawing([])\n  })\n}\n\nfn apply_speed(speed_percent: Int, paused: Bool) -> Effect(Msg) {\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) { render.set_speed(rate) })\n}\n\nfn restart_animation(speed_percent: Int, paused: Bool) -> Effect(Msg) {\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n  })\n}\n\n/// Slider percent → canvas clock multiplier (100 → 1.0×).\nfn speed_rate(speed_percent: Int) -> Float {\n  int.to_float(speed_percent) /. 100.0\n}\n\nfn effective_rate(speed_percent: Int, paused: Bool) -> Float {\n  case paused {\n    True -> 0.0\n    False -> speed_rate(speed_percent)\n  }\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"f06c95d54b7f91320ef248ba2ecf9f52a1341e8b7bb11ef9c7e852dcb834824d","kind":"doc.change","prev_hash":"0b0b5b8bda6e0566e4f4110db9f3172f2e807bd7f67243ac7e277b984ed2eed3","seq":397,"t":6434394,"wall":"2026-11-23T00:15:29.244Z"}
{"data":{"intercepted_count":0,"large_insert_count":2},"hash":"1045988d510d06fab55a2b1efdc564c21a108c3d20803cd627c3b0b612ec79d1","kind":"paste.anomaly","prev_hash":"f06c95d54b7f91320ef248ba2ecf9f52a1341e8b7bb11ef9c7e852dcb834824d","seq":398,"t":6434710,"wall":"2026-11-23T00:15:29.560Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":226},"start":{"character":0,"line":211}},"text":"      // Dragging the slider resumes playback at the new rate.\n      let paused = False\n      #(\n        Model(..model, speed_percent: speed_percent, paused: paused),\n        apply_speed(speed_percent, paused),\n      )\n    }\n\n    PauseAnimation -> #(\n      Model(..model, paused: True),\n      apply_speed(model.speed_percent, True),\n    )\n\n    PlayAnimation -> {\n      // If the slider is at 0×, bump to 1× so Play actually moves.\n      let speed_percent = case model.speed_percent {\n        0 -> 100\n        n -> n\n      }\n      #(\n        Model(..model, paused: False, speed_percent: speed_percent),\n        apply_speed(speed_percent, False),\n      )\n    }\n\n    RestartAnimation -> #(\n      model,\n      restart_animation(model.speed_percent, model.paused),\n    )\n\n    // After each keystroke in the editor, evaluate user code and animate (or\n    // report an error).\n    SetCode(text) ->\n      case run_source(10, text) {\n        Ok(paths) -> #(\n          Model(..model, error: None, source: text),\n          animate(paths, model.speed_percent, model.paused),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"5e292d01eb552a3915b99fb49652edde64c3147fff9ef3f507dca4005f5888e8","kind":"doc.change","prev_hash":"1045988d510d06fab55a2b1efdc564c21a108c3d20803cd627c3b0b612ec79d1","seq":399,"t":6437000,"wall":"2026-11-23T00:15:31.850Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":316},"start":{"character":0,"line":307}},"text":"    html.div([attr.class(\"playback-btns\")], [\n      html.button(\n        [\n          attr.class(case model.paused {\n            False -> \"icon-btn icon-btn-active\"\n            True -> \"icon-btn\"\n          }),\n          attr.attribute(\"title\", \"Play\"),\n          attr.type_(\"button\"),\n          attr.disabled(!model.paused && model.speed_percent != 0),\n          event.on_click(PlayAnimation),\n        ],\n        [html.text(\"▶\")],\n      ),\n      html.button(\n        [\n          attr.class(case model.paused {\n            True -> \"icon-btn icon-btn-active\"\n            False -> \"icon-btn\"\n          }),\n          attr.attribute(\"title\", \"Pause\"),\n          attr.type_(\"button\"),\n          attr.disabled(model.paused),\n          event.on_click(PauseAnimation),\n        ],\n        [html.text(\"❚❚\")],\n      ),\n      html.button(\n        [\n          attr.class(\"icon-btn\"),\n          attr.attribute(\"title\", \"Restart animation\"),\n          attr.type_(\"button\"),\n          event.on_click(RestartAnimation),\n        ],\n        [html.text(\"↻\")],\n      ),\n    ]),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"b78b81ec83f2edc868f83c628699bc5e11f993daee844ecc41a692400ec35ef5","kind":"doc.change","prev_hash":"5e292d01eb552a3915b99fb49652edde64c3147fff9ef3f507dca4005f5888e8","seq":400,"t":6438683,"wall":"2026-11-23T00:15:33.533Z"}
