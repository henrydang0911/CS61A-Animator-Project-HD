{"data":{"active_file":"src/app.gleam","focused":true,"idle_since_ms":29533.597099999897},"hash":"a7ac13da17db4b2fd6d0d4b3b331213cb8216d6f02ca2a5f28e4bb337c45f5a4","kind":"session.heartbeat","prev_hash":"9e5722f5dc62aa9b3fbe73528ab515a4b2a7b7b4c4acb8c0d2c6c5e69e2779d5","seq":347,"t":6001523,"wall":"2026-11-23T00:08:16.373Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":8},"start":{"character":0,"line":6}},"text":"import gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/option.{type Option, None, Some}\nimport gleam/result\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"360bbe28210a926cc15babad7f12de5cbd3e9b412d89c3e09dfa8f2f318203b7","kind":"doc.change","prev_hash":"a7ac13da17db4b2fd6d0d4b3b331213cb8216d6f02ca2a5f28e4bb337c45f5a4","seq":348,"t":6005118,"wall":"2026-11-23T00:08:19.968Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":85},"start":{"character":0,"line":70}},"text":"    // Animation speed as a percent of normal: 100 = 1×, 0 = paused, 200 = 2×.\n    speed_percent: Int,\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  SetSpeed(Int)\n\n  // Layout controls\n  ToggleCode\n}\n\n// ── Init ───────────────────────────────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  #(\n    Model(source: \"\", code_open: True, error: None, speed_percent: 100),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"5d856432d320c6152b86b0102c807810bac427aa7dbe4f1ae2a9bc9f1918136f","kind":"doc.change","prev_hash":"360bbe28210a926cc15babad7f12de5cbd3e9b412d89c3e09dfa8f2f318203b7","seq":349,"t":6007168,"wall":"2026-11-23T00:08:22.018Z"}
{"data":{"intercepted_count":0,"large_insert_count":2},"hash":"41917730e30b5af88be6a710814c78363889f51aa8cdcf71194a47fe5e8cdc84","kind":"paste.anomaly","prev_hash":"5d856432d320c6152b86b0102c807810bac427aa7dbe4f1ae2a9bc9f1918136f","seq":350,"t":6009015,"wall":"2026-11-23T00:08:23.865Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":178},"start":{"character":0,"line":139}},"text":"fn animate(paths: List(Path), speed_percent: Int) -> Effect(Msg) {\n  let rendered =\n    list.index_map(paths, fn(path, i) {\n      render.render_path(path, manim_color(i))\n    })\n  let rate = speed_rate(speed_percent)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n    render.set_drawing(rendered)\n  })\n}\n\nfn clear_drawing() -> Effect(Msg) {\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_drawing([])\n  })\n}\n\nfn apply_speed(speed_percent: Int) -> Effect(Msg) {\n  let rate = speed_rate(speed_percent)\n  effect.from(fn(_) { render.set_speed(rate) })\n}\n\n/// Slider percent → canvas clock multiplier (100 → 1.0×).\nfn speed_rate(speed_percent: Int) -> Float {\n  int.to_float(speed_percent) /. 100.0\n}\n\nfn manim_color(index: Int) -> String {\n  let assert Ok(color) =\n    list.drop(manim_palette, index % list.length(manim_palette))\n    |> list.first\n  color\n}\n\n// ── Update ─────────────────────────────────────────────────────────────────────\n\npub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode -> #(Model(..model, code_open: !model.code_open), effect.none())\n\n    SetSpeed(percent) -> {\n      let speed_percent = int.clamp(percent, 0, 200)\n      #(\n        Model(..model, speed_percent: speed_percent),\n        apply_speed(speed_percent),\n      )\n    }\n\n    // After each keystroke in the editor, evaluate user code and animate (or\n    // report an error).\n    SetCode(text) ->\n      case run_source(10, text) {\n        Ok(paths) -> #(\n          Model(..model, error: None, source: text),\n          animate(paths, model.speed_percent),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"00a01a022b11af53f4a4b3eeb0588e10e02135f9f4c50431a5b8b53b5f417ba3","kind":"doc.change","prev_hash":"41917730e30b5af88be6a710814c78363889f51aa8cdcf71194a47fe5e8cdc84","seq":351,"t":6011560,"wall":"2026-11-23T00:08:26.410Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":231},"start":{"character":0,"line":229}},"text":"    view_speed_control(model),\n    html.canvas([attr.id(\"animation-canvas\"), attr.class(\"canvas\")]),\n    view_error(model),\n  ])\n}\n\nfn view_speed_control(model: Model) -> Element(Msg) {\n  let label =\n    \"Speed \"\n    <> float.to_string(speed_rate(model.speed_percent))\n    <> \"×\"\n  html.div([attr.class(\"anim-controls\")], [\n    html.label([attr.class(\"slider-label\")], [\n      html.span([], [html.text(label)]),\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"0\"),\n        attr.max(\"200\"),\n        attr.step(\"5\"),\n        attr.value(int.to_string(model.speed_percent)),\n        attr.attribute(\"data-test-id\", \"speed-slider\"),\n        attr.attribute(\"title\", \"Animation speed\"),\n        event.on_input(fn(raw) {\n          SetSpeed(result.unwrap(int.parse(raw), model.speed_percent))\n        }),\n      ]),\n    ]),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"60fd5f08c1025d921bbb92f167ca12491df3ba61e9e3c067eef95451cfa69215","kind":"doc.change","prev_hash":"00a01a022b11af53f4a4b3eeb0588e10e02135f9f4c50431a5b8b53b5f417ba3","seq":352,"t":6013498,"wall":"2026-11-23T00:08:28.348Z"}
