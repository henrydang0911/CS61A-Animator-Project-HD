{"data":{"deltas":[{"range":{"end":{"character":0,"line":295},"start":{"character":0,"line":229}},"text":"      ComplexStyle(h, _) -> complex_math.path_color(i, h)\n    }\n    render.render_path(path, color)\n  })\n}\n\nfn run_math(model: Model) -> Result(#(math.Plot, MathStyle), AppError) {\n  case model.math_plane {\n    RealPlane ->\n      case\n        math.plot(\n          model.math_fn,\n          model.math_amp,\n          model.math_omega,\n          model.math_shift,\n          model.math_slope,\n        )\n      {\n        Ok(plot) -> Ok(#(plot, RealStyle))\n        Error(err) -> Error(AppError(MathError, math.error_message(err)))\n      }\n    ComplexPlane -> {\n      let #(plot, horiz, sweep) =\n        complex_math.plot(\n          model.complex_fn,\n          model.math_amp,\n          model.math_omega,\n          model.math_shift,\n        )\n      Ok(#(plot, ComplexStyle(horiz, sweep)))\n    }\n    PolarPlane -> {\n      let #(plot, horiz, sweep) =\n        complex_math.plot(\n          model.polar_fn,\n          model.math_amp,\n          model.math_omega,\n          model.math_shift,\n        )\n      Ok(#(plot, ComplexStyle(horiz, sweep)))\n    }\n  }\n}\n\nfn apply_sweep(style: MathStyle) -> Nil {\n  case style {\n    ComplexStyle(_, Some(arrow)) -> render.set_sweep(arrow)\n    _ -> render.clear_sweep()\n  }\n}\n\nfn animate_math(\n  plot: math.Plot,\n  style: MathStyle,\n  speed_percent: Int,\n  paused: Bool,\n) -> Effect(Msg) {\n  let rendered = math_render_paths(plot.paths, style)\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n    render.set_labels(plot.labels)\n    render.set_dots(plot.dots)\n    apply_sweep(style)\n    render.set_drawing(rendered)\n  })\n}\n\nfn update_math_drawing(plot: math.Plot, style: MathStyle) -> Effect(Msg) {\n  let rendered = math_render_paths(plot.paths, style)\n  effect.from(fn(_) {\n    render.set_labels(plot.labels)\n    render.set_dots(plot.dots)\n    apply_sweep(style)\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"3259c9ef818e345d20ec1e5c39cfca322317af100415d2da09b03347efcb0d69","kind":"doc.change","prev_hash":"08159f6691bf87884f88bdf88d4d7421537f400ae448d1a06701b796bb28b9fb","seq":420,"t":6239554,"wall":"2026-11-25T22:49:00.815Z"}
