{"data":{"diff_size":52,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x − b\"\n    Square -> \"y = (x − b)²\"\n    Cube -> \"y = (x − b)³\"\n    ScaledSine -> \"y = a·sin(ω(x − b))\"\n    ScaledCosine -> \"y = a·cos(ω(x − b))\"\n    Tangent -> \"y = tan(x − b)\"\n    Exp -> \"y = exp(x − b)\"\n    Ln -> \"y = ln(x − b)\"\n    Sqrt -> \"y = √(x − b)\"\n    Reciprocal -> \"y = 1/(x − b)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// For waves, `a` is amplitude (−5…5) and `omega` is angular frequency (≥1).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let curve = sample_curve(f, a_f, w_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(f: MathFn, a: Float, omega: Float) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, a, omega) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float, omega: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    ScaledSine -> Ok(a *. js_sin(omega *. x))\n    ScaledCosine -> Ok(a *. js_cos(omega *. x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":8567,"new_hash":"f61468af9eb19f71e7dc158b7011d660c4305c0236fae9b7e2a2bc88b9f101d6","old_hash":"4f89c4c020b21458068c8a39861ce184fa0beb8518b3e64901eebdfefe7e8cfa","operation":"modify","path":"src/math.gleam"},"hash":"6e9ad8fc344e741e352c28204c907c09f75bb95244f09d51d883c0945e52afed","kind":"fs.external_change","prev_hash":"4ffb280a671799817384056df6783155c181caaf56ab1b4ec0ff59d3286d41a9","seq":148,"t":2746317,"wall":"2026-11-25T21:50:55.187Z"}
{"data":{"diff_size":117,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x − b\"\n    Square -> \"y = (x − b)²\"\n    Cube -> \"y = (x − b)³\"\n    ScaledSine -> \"y = a·sin(ω(x − b))\"\n    ScaledCosine -> \"y = a·cos(ω(x − b))\"\n    Tangent -> \"y = tan(x − b)\"\n    Exp -> \"y = exp(x − b)\"\n    Ln -> \"y = ln(x − b)\"\n    Sqrt -> \"y = √(x − b)\"\n    Reciprocal -> \"y = 1/(x − b)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// All plots use horizontal shift `b` as f(x − b). Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(f: MathFn, a: Float, omega: Float) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, a, omega) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float, omega: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    ScaledSine -> Ok(a *. js_sin(omega *. x))\n    ScaledCosine -> Ok(a *. js_cos(omega *. x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":8686,"new_hash":"a37ace650507bf223abbbb038b573896806792041663c45b8df2725de81769b3","old_hash":"f61468af9eb19f71e7dc158b7011d660c4305c0236fae9b7e2a2bc88b9f101d6","operation":"modify","path":"src/math.gleam"},"hash":"a1733b1d579dbb668c69117a560719a13a6c7627b878c6407784d49a398f3f01","kind":"fs.external_change","prev_hash":"6e9ad8fc344e741e352c28204c907c09f75bb95244f09d51d883c0945e52afed","seq":149,"t":2749906,"wall":"2026-11-25T21:50:58.777Z"}
{"data":{"diff_size":111,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x − b\"\n    Square -> \"y = (x − b)²\"\n    Cube -> \"y = (x − b)³\"\n    ScaledSine -> \"y = a·sin(ω(x − b))\"\n    ScaledCosine -> \"y = a·cos(ω(x − b))\"\n    Tangent -> \"y = tan(x − b)\"\n    Exp -> \"y = exp(x − b)\"\n    Ln -> \"y = ln(x − b)\"\n    Sqrt -> \"y = √(x − b)\"\n    Reciprocal -> \"y = 1/(x − b)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// All plots use horizontal shift `b` as f(x − b). Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(f: MathFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      // Horizontal shift: evaluate f at (x − b), plot at world x.\n      case eval(f, x_math -. b, a, omega) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, u: Float, a: Float, omega: Float) -> Result(Float, Nil) {\n  // `u` is already (x − b).\n  case f {\n    Identity -> Ok(u)\n    Square -> Ok(u *. u)\n    Cube -> Ok(u *. u *. u)\n    ScaledSine -> Ok(a *. js_sin(omega *. u))\n    ScaledCosine -> Ok(a *. js_cos(omega *. u))\n    Tangent -> {\n      let c = js_cos(u)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(u))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(u)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(u)\n    Sqrt -> float.square_root(u)\n    Reciprocal ->\n      case float.absolute_value(u) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. u)\n      }\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":8801,"new_hash":"475fd42db8d41821ad074e0cd8bef5e76ec73e9d2368a1c9d6dbe4867306748e","old_hash":"a37ace650507bf223abbbb038b573896806792041663c45b8df2725de81769b3","operation":"modify","path":"src/math.gleam"},"hash":"c3e3c31e931c72d68991d7c61ff233f0f231a2fdd8b27fa4fe805b068c592563","kind":"fs.external_change","prev_hash":"a1733b1d579dbb668c69117a560719a13a6c7627b878c6407784d49a398f3f01","seq":150,"t":2758060,"wall":"2026-11-25T21:51:06.930Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":96},"start":{"character":0,"line":82}},"text":"    // Amplitude a for y = a·sin(ω(x−b)) / a·cos(ω(x−b)), range −5…5 (default 1).\n    math_amp: Int,\n    // Angular frequency ω for those waves, range 1…10 (default 1).\n    math_omega: Int,\n    // Horizontal shift b for all Math plots: f(x − b), range −5…5 (default 0).\n    math_shift: Int,\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  SelectDrawing(String)\n  SetMode(AppMode)\n  SetMathFn(MathFn)\n  SetMathAmp(Int)\n  SetMathOmega(Int)\n  SetMathShift(Int)\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"5515073cec354845a4241811de0d4895f53707a074d9f8d4150deafcd0775d99","kind":"doc.change","prev_hash":"c3e3c31e931c72d68991d7c61ff233f0f231a2fdd8b27fa4fe805b068c592563","seq":151,"t":2760543,"wall":"2026-11-25T21:51:09.414Z"}
