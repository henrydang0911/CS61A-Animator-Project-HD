{"data":{"deltas":[{"range":{"end":{"character":0,"line":397},"start":{"character":0,"line":383}},"text":"      case run_source(shape_slider, model.source) {\n        Ok(paths) -> #(\n          Model(..model, error: None),\n          // Geometry only — do not call set_speed or reset_clock.\n          update_drawing(paths),\n        )\n        Error(err) -> #(\n          Model(..model, error: Some(err)),\n          clear_drawing(),\n        )\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"3f3532d9fe5be8339e8da3f1ebd1ddf44fd74946892ebcabe6a71a80fad446b0","kind":"doc.change","prev_hash":"eb50f711ce0beb731369fd529b886caee55fe0a6285d5b4c567f455545dc1314","seq":135,"t":2537509,"wall":"2026-11-25T21:47:26.380Z"}
