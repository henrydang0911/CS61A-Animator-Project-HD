{"data":{"diff_size":7,"new_content":"//// Complex / Polar submodes of Math on the Argand plane (Re / Im).\n//// — Complex maps: grid → w = a · f(ω(z − b))\n//// — Polar curves: r(θ) drawn on the same plane (calc-class classics + spirals)\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport math.{type Plot, Plot}\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan2\")\nfn js_atan2(y: Float, x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"zeta\")\nfn js_zeta(re: Float, im: Float) -> #(Float, Float)\n\n@external(javascript, \"./math_ffi.mjs\", \"is_finite\")\nfn js_is_finite(x: Float) -> Bool\n\n/// Maps ℂ→ℂ and polar r(θ) curves shown in the Complex dropdown.\npub type ComplexFn {\n  // ── Complex maps (grid images) ───────────────────────────────────────────\n  Identity\n  Square\n  Cube\n  Reciprocal\n  Conjugate\n  Exp\n  Sin\n  Cos\n  Sqrt\n  Log\n  /// w = z^ω via exp(ω Log z)\n  Power\n  Modulus\n  Arg\n  /// Approximate Riemann ζ via Dirichlet η (fun / illustrative).\n  Zeta\n  // ── Polar curves on the Argand plane ─────────────────────────────────────\n  UnitCircle\n  ArchimedesSpiral\n  LogSpiral\n  RoseCos\n  RoseSin\n  Cardioid\n  Limacon\n  Lemniscate\n}\n\npub type C {\n  C(re: Float, im: Float)\n}\n\n/// Axes + integer ticks (same layout count as real math mode).\npub const decoration_count = 18\n\nconst world_half = 450.0\n\nconst x_math_max = 5.0\n\nconst y_clip = 480.0\n\nconst domain_min = -2.0\n\nconst domain_max = 2.0\n\nconst samples_per_line = 48\n\nconst polar_samples = 360\n\nconst pi = 3.141592653589793\n\npub fn fn_id(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w=z\"\n    Square -> \"w=z^2\"\n    Cube -> \"w=z^3\"\n    Reciprocal -> \"w=1/z\"\n    Conjugate -> \"w=conj(z)\"\n    Exp -> \"w=exp(z)\"\n    Sin -> \"w=sin(z)\"\n    Cos -> \"w=cos(z)\"\n    Sqrt -> \"w=sqrt(z)\"\n    Log -> \"w=log(z)\"\n    Power -> \"w=z^w\"\n    Modulus -> \"w=|z|\"\n    Arg -> \"w=arg(z)\"\n    Zeta -> \"w=zeta(z)\"\n    UnitCircle -> \"r=1\"\n    ArchimedesSpiral -> \"r=a*theta\"\n    LogSpiral -> \"r=a*e^(k*theta)\"\n    RoseCos -> \"r=a*cos(n*theta)\"\n    RoseSin -> \"r=a*sin(n*theta)\"\n    Cardioid -> \"r=a*(1-cos(theta))\"\n    Limacon -> \"r=a+b*cos(theta)\"\n    Lemniscate -> \"r^2=a^2*cos(2*theta)\"\n  }\n}\n\npub fn fn_label(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w = z\"\n    Square -> \"w = z²\"\n    Cube -> \"w = z³\"\n    Reciprocal -> \"w = 1/z\"\n    Conjugate -> \"w = z̄\"\n    Exp -> \"w = exp(z)\"\n    Sin -> \"w = sin(z)\"\n    Cos -> \"w = cos(z)\"\n    Sqrt -> \"w = √z\"\n    Log -> \"w = Log(z)\"\n    Power -> \"w = z^ω\"\n    Modulus -> \"w = |z|\"\n    Arg -> \"w = Arg(z)\"\n    Zeta -> \"w = ζ(z)  (approx.)\"\n    UnitCircle -> \"r = 1  (unit circle)\"\n    ArchimedesSpiral -> \"r = aθ  (Archimedes)\"\n    LogSpiral -> \"r = a e^{kθ}  (log spiral)\"\n    RoseCos -> \"r = a cos(ωθ)  (rose)\"\n    RoseSin -> \"r = a sin(ωθ)  (rose)\"\n    Cardioid -> \"r = a(1 − cos θ)  (cardioid)\"\n    Limacon -> \"r = a + cos θ  (limaçon)\"\n    Lemniscate -> \"r² = a² cos(2θ)  (lemniscate)\"\n  }\n}\n\npub fn all_functions() -> List(ComplexFn) {\n  [\n    // Maps\n    Identity,\n    Square,\n    Cube,\n    Reciprocal,\n    Conjugate,\n    Exp,\n    Sin,\n    Cos,\n    Sqrt,\n    Log,\n    Power,\n    Modulus,\n    Arg,\n    Zeta,\n    // Polar\n    UnitCircle,\n    ArchimedesSpiral,\n    LogSpiral,\n    RoseCos,\n    RoseSin,\n    Cardioid,\n    Limacon,\n    Lemniscate,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> ComplexFn {\n  case id {\n    \"w=z\" -> Identity\n    \"w=z^2\" -> Square\n    \"w=z^3\" -> Cube\n    \"w=1/z\" -> Reciprocal\n    \"w=conj(z)\" -> Conjugate\n    \"w=exp(z)\" -> Exp\n    \"w=sin(z)\" -> Sin\n    \"w=cos(z)\" -> Cos\n    \"w=sqrt(z)\" -> Sqrt\n    \"w=log(z)\" -> Log\n    \"w=z^w\" -> Power\n    \"w=|z|\" -> Modulus\n    \"w=arg(z)\" -> Arg\n    \"w=zeta(z)\" -> Zeta\n    \"r=1\" -> UnitCircle\n    \"r=a*theta\" -> ArchimedesSpiral\n    \"r=a*e^(k*theta)\" -> LogSpiral\n    \"r=a*cos(n*theta)\" -> RoseCos\n    \"r=a*sin(n*theta)\" -> RoseSin\n    \"r=a*(1-cos(theta))\" -> Cardioid\n    \"r=a+b*cos(theta)\" -> Limacon\n    \"r^2=a^2*cos(2*theta)\" -> Lemniscate\n    _ -> Identity\n  }\n}\n\npub fn is_polar(f: ComplexFn) -> Bool {\n  case f {\n    UnitCircle\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// ω: maps (exp/sin/cos/power) and polar roses / spirals / lemniscate petals.\npub fn uses_omega(f: ComplexFn) -> Bool {\n  case f {\n    Exp | Sin | Cos | Power -> True\n    ArchimedesSpiral | LogSpiral | RoseCos | RoseSin | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// Stroke color: axes muted; images of horizontal lines teal; vertical magenta.\n/// Polar curves use teal only (horizontal_count covers all curve paths).\npub fn path_color(index: Int, horizontal_count: Int) -> String {\n  case index < decoration_count {\n    True -> \"#8a8aaa\"\n    False -> {\n      let j = index - decoration_count\n      case j < horizontal_count {\n        True -> \"#58C4DD\"\n        False -> \"#C77DFF\"\n      }\n    }\n  }\n}\n\npub fn plot(f: ComplexFn, a: Int, omega: Int, b: Int) -> #(Plot, Int) {\n  let a_f = int.to_float(int.clamp(a, -5, 5))\n  let w_f = int.to_float(int.clamp(omega, 1, 10))\n  let b_f = int.to_float(int.clamp(b, -5, 5))\n  let #(axis_paths, labels) = argand_decorations()\n  case is_polar(f) {\n    True -> {\n      let curves = polar_plot(f, a_f, w_f, b_f)\n      let n = list.length(curves)\n      #(Plot(list.append(axis_paths, curves), labels, []), n)\n    }\n    False -> {\n      let #(horiz, vert) = mapped_grid(f, a_f, w_f, b_f)\n      let horiz_n = list.length(horiz)\n      #(Plot(list.flatten([axis_paths, horiz, vert]), labels, []), horiz_n)\n    }\n  }\n}\n\nfn argand_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n\n  let re_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      0.0,\n      8.0,\n      axis_t,\n    )\n  let im_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      4.0,\n      12.0,\n      axis_t,\n    )\n\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let re_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let im_ticks =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let re_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        math_to_world(int.to_float(k)),\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let im_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        0.0 -. 28.0,\n        0.0 -. math_to_world(int.to_float(k)),\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 36.0, 36.0, \"Re\", \"#e8e8ff\", 28.0, 10.0, 14.0),\n    RenderLabel(\n      40.0,\n      0.0 -. world_half +. 28.0,\n      \"Im\",\n      \"#e8e8ff\",\n      28.0,\n      10.0,\n      14.0,\n    ),\n  ]\n\n  let paths = list.flatten([[re_axis, im_axis], re_ticks, im_ticks])\n  let labels = list.flatten([re_labels, im_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world(t: Float) -> Float {\n  t *. { world_half /. x_math_max }\n}\n\n// ── Polar curves ─────────────────────────────────────────────────────────────\n\nfn polar_plot(f: ComplexFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let amp = case float.absolute_value(a) <. 0.01 {\n    True -> 1.0\n    False -> float.absolute_value(a)\n  }\n  let points =\n    list.repeat(Nil, polar_samples + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(polar_samples)\n      case polar_point(f, t, amp, omega, b) {\n        Error(Nil) -> Error(Nil)\n        Ok(w) -> {\n          let #(wx, wy) = to_world(w)\n          case\n            float.absolute_value(wx) >. y_clip\n            || float.absolute_value(wy) >. y_clip\n          {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n    |> list.filter_map(fn(r) { r })\n  segments(points, 14.0, 40.0, 3.0)\n}\n\n/// t ∈ [0,1] parameter along the polar sweep.\nfn polar_point(\n  f: ComplexFn,\n  t: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  case f {\n    UnitCircle -> {\n      let theta = t *. 2.0 *. pi\n      Ok(from_polar(a, theta, b))\n    }\n    ArchimedesSpiral -> {\n      // θ ∈ [0, 2πω]; r = (a/8) θ  — more turns with larger ω\n      let theta = t *. 2.0 *. pi *. omega\n      let r = { a /. 8.0 } *. theta\n      Ok(from_polar(r, theta, b))\n    }\n    LogSpiral -> {\n      let theta = t *. 2.0 *. pi *. omega\n      let k = 0.12\n      let r = { a /. 3.0 } *. float.exponential(k *. theta)\n      case r >. 8.0 {\n        True -> Error(Nil)\n        False -> Ok(from_polar(r, theta, b))\n      }\n    }\n    RoseCos -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_cos(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseSin -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_sin(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Cardioid -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. { 1.0 -. js_cos(theta) }\n      Ok(from_polar(r, theta, b))\n    }\n    Limacon -> {\n      // Classic dimpled/looped limaçon: r = a + cos θ (a from slider)\n      let theta = t *. 2.0 *. pi\n      let r = a +. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Lemniscate -> {\n      // r² = a² cos(ωθ); classic figure-eight uses ω = 2\n      let theta = t *. 2.0 *. pi\n      let c = js_cos(omega *. theta)\n      case c <. 0.0 {\n        True -> Error(Nil)\n        False ->\n          case float.square_root(a *. a *. c) {\n            Error(Nil) -> Error(Nil)\n            Ok(r) -> Ok(from_polar(r, theta, b))\n          }\n      }\n    }\n    _ -> Error(Nil)\n  }\n}\n\nfn from_polar(r: Float, theta: Float, b_re: Float) -> C {\n  C(r *. js_cos(theta) +. b_re, r *. js_sin(theta))\n}\n\n// ── Grid maps ────────────────────────────────────────────────────────────────\n\nfn mapped_grid(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> #(List(Path), List(Path)) {\n  let levels = case f {\n    Zeta -> [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5]\n    _ -> [-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]\n  }\n  let dmin = case f {\n    Zeta -> 0.2\n    _ -> domain_min\n  }\n  let dmax = case f {\n    Zeta -> 2.8\n    _ -> domain_max\n  }\n  let horiz =\n    list.index_map(levels, fn(im, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        True,\n        im,\n        dmin,\n        dmax,\n        14.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  let vert_levels = case f {\n    Zeta -> [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5]\n    _ -> levels\n  }\n  let vert =\n    list.index_map(vert_levels, fn(re, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        False,\n        re,\n        case f {\n          Zeta -> -2.5\n          _ -> dmin\n        },\n        case f {\n          Zeta -> 2.5\n          _ -> dmax\n        },\n        26.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  #(horiz, vert)\n}\n\nfn sample_line(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  horizontal: Bool,\n  fixed: Float,\n  varying_min: Float,\n  varying_max: Float,\n  start_base: Float,\n) -> List(Path) {\n  let points =\n    list.repeat(Nil, samples_per_line + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(samples_per_line)\n      let varying = varying_min +. t *. { varying_max -. varying_min }\n      let z = case horizontal {\n        True -> C(varying, fixed)\n        False -> C(fixed, varying)\n      }\n      case apply_map(f, z, a, omega, b) {\n        Error(Nil) -> Error(Nil)\n        Ok(w) -> {\n          let #(wx, wy) = to_world(w)\n          case\n            float.absolute_value(wx) >. y_clip\n            || float.absolute_value(wy) >. y_clip\n          {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n    |> list.filter_map(fn(r) { r })\n  segments(points, start_base, 10.0, 2.2)\n}\n\nfn apply_map(\n  f: ComplexFn,\n  z: C,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  let shifted = C(z.re -. b, z.im)\n  let scaled_in = case f {\n    Exp | Sin | Cos | Power -> c_scale(shifted, omega)\n    _ -> shifted\n  }\n  use w <- result.try(eval(f, scaled_in, omega))\n  Ok(c_scale(w, a))\n}\n\nfn eval(f: ComplexFn, z: C, omega: Float) -> Result(C, Nil) {\n  case f {\n    Identity -> Ok(z)\n    Square -> Ok(c_mul(z, z))\n    Cube -> Ok(c_mul(c_mul(z, z), z))\n    Reciprocal -> c_inv(z)\n    Conjugate -> Ok(C(z.re, 0.0 -. z.im))\n    Exp -> Ok(c_exp(z))\n    Sin -> Ok(c_sin(z))\n    Cos -> Ok(c_cos(z))\n    Sqrt -> c_sqrt(z)\n    Log -> c_log(z)\n    Power -> c_pow(z, omega)\n    Modulus -> Ok(C(c_abs(z), 0.0))\n    Arg -> Ok(C(js_atan2(z.im, z.re), 0.0))\n    Zeta -> c_zeta(z)\n    // Polar variants never reach eval.\n    UnitCircle\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> Error(Nil)\n  }\n}\n\nfn c_scale(z: C, s: Float) -> C {\n  C(z.re *. s, z.im *. s)\n}\n\nfn c_mul(z: C, w: C) -> C {\n  C(z.re *. w.re -. z.im *. w.im, z.re *. w.im +. z.im *. w.re)\n}\n\nfn c_abs(z: C) -> Float {\n  float.square_root(z.re *. z.re +. z.im *. z.im)\n  |> result_or_zero\n}\n\nfn result_or_zero(r: Result(Float, Nil)) -> Float {\n  case r {\n    Ok(v) -> v\n    Error(Nil) -> 0.0\n  }\n}\n\nfn c_inv(z: C) -> Result(C, Nil) {\n  let n = z.re *. z.re +. z.im *. z.im\n  case n <. 0.04 {\n    True -> Error(Nil)\n    False -> Ok(C(z.re /. n, 0.0 -. z.im /. n))\n  }\n}\n\nfn c_exp(z: C) -> C {\n  let ex = float.exponential(z.re)\n  C(ex *. js_cos(z.im), ex *. js_sin(z.im))\n}\n\nfn sinh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e -. inv } /. 2.0\n}\n\nfn cosh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e +. inv } /. 2.0\n}\n\nfn c_sin(z: C) -> C {\n  C(js_sin(z.re) *. cosh(z.im), js_cos(z.re) *. sinh(z.im))\n}\n\nfn c_cos(z: C) -> C {\n  C(js_cos(z.re) *. cosh(z.im), 0.0 -. js_sin(z.re) *. sinh(z.im))\n}\n\nfn c_sqrt(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.0001 {\n    True -> Ok(C(0.0, 0.0))\n    False -> {\n      let theta = js_atan2(z.im, z.re)\n      let half = theta /. 2.0\n      case float.square_root(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(root) -> Ok(C(root *. js_cos(half), root *. js_sin(half)))\n      }\n    }\n  }\n}\n\nfn c_log(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.05 {\n    True -> Error(Nil)\n    False ->\n      case float.logarithm(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(ln_r) -> Ok(C(ln_r, js_atan2(z.im, z.re)))\n      }\n  }\n}\n\nfn c_pow(z: C, omega: Float) -> Result(C, Nil) {\n  // z^ω = exp(ω Log z)\n  use lg <- result.try(c_log(z))\n  Ok(c_exp(c_scale(lg, omega)))\n}\n\nfn c_zeta(z: C) -> Result(C, Nil) {\n  // Pole at s = 1; also skip far left where the η approx is poor.\n  let dx = z.re -. 1.0\n  let dist = dx *. dx +. z.im *. z.im\n  case dist <. 0.04 || z.re <. 0.15 {\n    True -> Error(Nil)\n    False -> {\n      let #(re, im) = js_zeta(z.re, z.im)\n      case js_is_finite(re) && js_is_finite(im) {\n        False -> Error(Nil)\n        True ->\n          case\n            float.absolute_value(re) >. 12.0 || float.absolute_value(im) >. 12.0\n          {\n            True -> Error(Nil)\n            False -> Ok(C(re, im))\n          }\n      }\n    }\n  }\n}\n\nfn to_world(w: C) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  #(w.re *. scale, 0.0 -. w.im *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 90.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":17538,"new_hash":"0b888dc1db3dcc1d05f403bf50144e167408e54f44fdb3d2e102e8e5855f7abf","old_hash":"734cee337ff6d69f4f4a21183ff00c39207f5ea256fe27f8238180eedc068c87","operation":"modify","path":"src/complex_math.gleam"},"hash":"ac25b1f7e2e054cfc9d15a6989e9efc889e47b6696b840bb75b32c0409841230","kind":"fs.external_change","prev_hash":"cda6bcc6de3f67ff7a561ba38e2263b7ce291613b57ef8c5601eb3d5b9e3c108","seq":312,"t":5026840,"wall":"2026-11-25T22:28:48.101Z"}
{"data":{"diff_size":4,"new_content":"//// Complex / Polar submodes of Math on the Argand plane (Re / Im).\n//// — Complex maps: grid → w = a · f(ω(z − b))\n//// — Polar curves: r(θ) drawn on the same plane (calc-class classics + spirals)\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport math.{type Plot, Plot}\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan2\")\nfn js_atan2(y: Float, x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"zeta\")\nfn js_zeta(re: Float, im: Float) -> #(Float, Float)\n\n@external(javascript, \"./math_ffi.mjs\", \"is_finite\")\nfn js_is_finite(x: Float) -> Bool\n\n/// Maps ℂ→ℂ (Complex tab) and polar r(θ) curves (Polar tab).\npub type ComplexFn {\n  // ── Complex maps (grid images) ───────────────────────────────────────────\n  Identity\n  Square\n  Cube\n  Reciprocal\n  Conjugate\n  Exp\n  Sin\n  Cos\n  Sqrt\n  Log\n  /// w = z^ω via exp(ω Log z)\n  Power\n  Modulus\n  Arg\n  /// Approximate Riemann ζ via Dirichlet η (fun / illustrative).\n  Zeta\n  // ── Polar curves on the Argand plane ─────────────────────────────────────\n  UnitCircle\n  ArchimedesSpiral\n  LogSpiral\n  RoseCos\n  RoseSin\n  Cardioid\n  Limacon\n  Lemniscate\n}\n\npub type C {\n  C(re: Float, im: Float)\n}\n\n/// Axes + integer ticks (same layout count as real math mode).\npub const decoration_count = 18\n\nconst world_half = 450.0\n\nconst x_math_max = 5.0\n\nconst y_clip = 480.0\n\nconst domain_min = -2.0\n\nconst domain_max = 2.0\n\nconst samples_per_line = 48\n\nconst polar_samples = 360\n\nconst pi = 3.141592653589793\n\npub fn fn_id(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w=z\"\n    Square -> \"w=z^2\"\n    Cube -> \"w=z^3\"\n    Reciprocal -> \"w=1/z\"\n    Conjugate -> \"w=conj(z)\"\n    Exp -> \"w=exp(z)\"\n    Sin -> \"w=sin(z)\"\n    Cos -> \"w=cos(z)\"\n    Sqrt -> \"w=sqrt(z)\"\n    Log -> \"w=log(z)\"\n    Power -> \"w=z^w\"\n    Modulus -> \"w=|z|\"\n    Arg -> \"w=arg(z)\"\n    Zeta -> \"w=zeta(z)\"\n    UnitCircle -> \"r=1\"\n    ArchimedesSpiral -> \"r=a*theta\"\n    LogSpiral -> \"r=a*e^(k*theta)\"\n    RoseCos -> \"r=a*cos(n*theta)\"\n    RoseSin -> \"r=a*sin(n*theta)\"\n    Cardioid -> \"r=a*(1-cos(theta))\"\n    Limacon -> \"r=a+b*cos(theta)\"\n    Lemniscate -> \"r^2=a^2*cos(2*theta)\"\n  }\n}\n\npub fn fn_label(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w = z\"\n    Square -> \"w = z²\"\n    Cube -> \"w = z³\"\n    Reciprocal -> \"w = 1/z\"\n    Conjugate -> \"w = z̄\"\n    Exp -> \"w = exp(z)\"\n    Sin -> \"w = sin(z)\"\n    Cos -> \"w = cos(z)\"\n    Sqrt -> \"w = √z\"\n    Log -> \"w = Log(z)\"\n    Power -> \"w = z^ω\"\n    Modulus -> \"w = |z|\"\n    Arg -> \"w = Arg(z)\"\n    Zeta -> \"w = ζ(z)  (approx.)\"\n    UnitCircle -> \"r = 1  (unit circle)\"\n    ArchimedesSpiral -> \"r = aθ  (Archimedes)\"\n    LogSpiral -> \"r = a e^{kθ}  (log spiral)\"\n    RoseCos -> \"r = a cos(ωθ)  (rose)\"\n    RoseSin -> \"r = a sin(ωθ)  (rose)\"\n    Cardioid -> \"r = a(1 − cos θ)  (cardioid)\"\n    Limacon -> \"r = a + cos θ  (limaçon)\"\n    Lemniscate -> \"r² = a² cos(2θ)  (lemniscate)\"\n  }\n}\n\npub fn all_functions() -> List(ComplexFn) {\n  [\n    // Maps\n    Identity,\n    Square,\n    Cube,\n    Reciprocal,\n    Conjugate,\n    Exp,\n    Sin,\n    Cos,\n    Sqrt,\n    Log,\n    Power,\n    Modulus,\n    Arg,\n    Zeta,\n    // Polar\n    UnitCircle,\n    ArchimedesSpiral,\n    LogSpiral,\n    RoseCos,\n    RoseSin,\n    Cardioid,\n    Limacon,\n    Lemniscate,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> ComplexFn {\n  case id {\n    \"w=z\" -> Identity\n    \"w=z^2\" -> Square\n    \"w=z^3\" -> Cube\n    \"w=1/z\" -> Reciprocal\n    \"w=conj(z)\" -> Conjugate\n    \"w=exp(z)\" -> Exp\n    \"w=sin(z)\" -> Sin\n    \"w=cos(z)\" -> Cos\n    \"w=sqrt(z)\" -> Sqrt\n    \"w=log(z)\" -> Log\n    \"w=z^w\" -> Power\n    \"w=|z|\" -> Modulus\n    \"w=arg(z)\" -> Arg\n    \"w=zeta(z)\" -> Zeta\n    \"r=1\" -> UnitCircle\n    \"r=a*theta\" -> ArchimedesSpiral\n    \"r=a*e^(k*theta)\" -> LogSpiral\n    \"r=a*cos(n*theta)\" -> RoseCos\n    \"r=a*sin(n*theta)\" -> RoseSin\n    \"r=a*(1-cos(theta))\" -> Cardioid\n    \"r=a+b*cos(theta)\" -> Limacon\n    \"r^2=a^2*cos(2*theta)\" -> Lemniscate\n    _ -> Identity\n  }\n}\n\npub fn is_polar(f: ComplexFn) -> Bool {\n  case f {\n    UnitCircle\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// ω: maps (exp/sin/cos/power) and polar roses / spirals / lemniscate petals.\npub fn uses_omega(f: ComplexFn) -> Bool {\n  case f {\n    Exp | Sin | Cos | Power -> True\n    ArchimedesSpiral | LogSpiral | RoseCos | RoseSin | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// Stroke color: axes muted; images of horizontal lines teal; vertical magenta.\n/// Polar curves use teal only (horizontal_count covers all curve paths).\npub fn path_color(index: Int, horizontal_count: Int) -> String {\n  case index < decoration_count {\n    True -> \"#8a8aaa\"\n    False -> {\n      let j = index - decoration_count\n      case j < horizontal_count {\n        True -> \"#58C4DD\"\n        False -> \"#C77DFF\"\n      }\n    }\n  }\n}\n\npub fn plot(f: ComplexFn, a: Int, omega: Int, b: Int) -> #(Plot, Int) {\n  let a_f = int.to_float(int.clamp(a, -5, 5))\n  let w_f = int.to_float(int.clamp(omega, 1, 10))\n  let b_f = int.to_float(int.clamp(b, -5, 5))\n  let #(axis_paths, labels) = argand_decorations()\n  case is_polar(f) {\n    True -> {\n      let curves = polar_plot(f, a_f, w_f, b_f)\n      let n = list.length(curves)\n      #(Plot(list.append(axis_paths, curves), labels, []), n)\n    }\n    False -> {\n      let #(horiz, vert) = mapped_grid(f, a_f, w_f, b_f)\n      let horiz_n = list.length(horiz)\n      #(Plot(list.flatten([axis_paths, horiz, vert]), labels, []), horiz_n)\n    }\n  }\n}\n\nfn argand_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n\n  let re_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      0.0,\n      8.0,\n      axis_t,\n    )\n  let im_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      4.0,\n      12.0,\n      axis_t,\n    )\n\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let re_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let im_ticks =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let re_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        math_to_world(int.to_float(k)),\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let im_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        0.0 -. 28.0,\n        0.0 -. math_to_world(int.to_float(k)),\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 36.0, 36.0, \"Re\", \"#e8e8ff\", 28.0, 10.0, 14.0),\n    RenderLabel(\n      40.0,\n      0.0 -. world_half +. 28.0,\n      \"Im\",\n      \"#e8e8ff\",\n      28.0,\n      10.0,\n      14.0,\n    ),\n  ]\n\n  let paths = list.flatten([[re_axis, im_axis], re_ticks, im_ticks])\n  let labels = list.flatten([re_labels, im_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world(t: Float) -> Float {\n  t *. { world_half /. x_math_max }\n}\n\n// ── Polar curves ─────────────────────────────────────────────────────────────\n\nfn polar_plot(f: ComplexFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let amp = case float.absolute_value(a) <. 0.01 {\n    True -> 1.0\n    False -> float.absolute_value(a)\n  }\n  let points =\n    list.repeat(Nil, polar_samples + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(polar_samples)\n      case polar_point(f, t, amp, omega, b) {\n        Error(Nil) -> Error(Nil)\n        Ok(w) -> {\n          let #(wx, wy) = to_world(w)\n          case\n            float.absolute_value(wx) >. y_clip\n            || float.absolute_value(wy) >. y_clip\n          {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n    |> list.filter_map(fn(r) { r })\n  segments(points, 14.0, 40.0, 3.0)\n}\n\n/// t ∈ [0,1] parameter along the polar sweep.\nfn polar_point(\n  f: ComplexFn,\n  t: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  case f {\n    UnitCircle -> {\n      let theta = t *. 2.0 *. pi\n      Ok(from_polar(a, theta, b))\n    }\n    ArchimedesSpiral -> {\n      // θ ∈ [0, 2πω]; r = (a/8) θ  — more turns with larger ω\n      let theta = t *. 2.0 *. pi *. omega\n      let r = { a /. 8.0 } *. theta\n      Ok(from_polar(r, theta, b))\n    }\n    LogSpiral -> {\n      let theta = t *. 2.0 *. pi *. omega\n      let k = 0.12\n      let r = { a /. 3.0 } *. float.exponential(k *. theta)\n      case r >. 8.0 {\n        True -> Error(Nil)\n        False -> Ok(from_polar(r, theta, b))\n      }\n    }\n    RoseCos -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_cos(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseSin -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_sin(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Cardioid -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. { 1.0 -. js_cos(theta) }\n      Ok(from_polar(r, theta, b))\n    }\n    Limacon -> {\n      // Classic dimpled/looped limaçon: r = a + cos θ (a from slider)\n      let theta = t *. 2.0 *. pi\n      let r = a +. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Lemniscate -> {\n      // r² = a² cos(ωθ); classic figure-eight uses ω = 2\n      let theta = t *. 2.0 *. pi\n      let c = js_cos(omega *. theta)\n      case c <. 0.0 {\n        True -> Error(Nil)\n        False ->\n          case float.square_root(a *. a *. c) {\n            Error(Nil) -> Error(Nil)\n            Ok(r) -> Ok(from_polar(r, theta, b))\n          }\n      }\n    }\n    _ -> Error(Nil)\n  }\n}\n\nfn from_polar(r: Float, theta: Float, b_re: Float) -> C {\n  C(r *. js_cos(theta) +. b_re, r *. js_sin(theta))\n}\n\n// ── Grid maps ────────────────────────────────────────────────────────────────\n\nfn mapped_grid(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> #(List(Path), List(Path)) {\n  let levels = case f {\n    Zeta -> [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5]\n    _ -> [-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]\n  }\n  let dmin = case f {\n    Zeta -> 0.2\n    _ -> domain_min\n  }\n  let dmax = case f {\n    Zeta -> 2.8\n    _ -> domain_max\n  }\n  let horiz =\n    list.index_map(levels, fn(im, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        True,\n        im,\n        dmin,\n        dmax,\n        14.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  let vert_levels = case f {\n    Zeta -> [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5]\n    _ -> levels\n  }\n  let vert =\n    list.index_map(vert_levels, fn(re, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        False,\n        re,\n        case f {\n          Zeta -> -2.5\n          _ -> dmin\n        },\n        case f {\n          Zeta -> 2.5\n          _ -> dmax\n        },\n        26.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  #(horiz, vert)\n}\n\nfn sample_line(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  horizontal: Bool,\n  fixed: Float,\n  varying_min: Float,\n  varying_max: Float,\n  start_base: Float,\n) -> List(Path) {\n  let points =\n    list.repeat(Nil, samples_per_line + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(samples_per_line)\n      let varying = varying_min +. t *. { varying_max -. varying_min }\n      let z = case horizontal {\n        True -> C(varying, fixed)\n        False -> C(fixed, varying)\n      }\n      case apply_map(f, z, a, omega, b) {\n        Error(Nil) -> Error(Nil)\n        Ok(w) -> {\n          let #(wx, wy) = to_world(w)\n          case\n            float.absolute_value(wx) >. y_clip\n            || float.absolute_value(wy) >. y_clip\n          {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n    |> list.filter_map(fn(r) { r })\n  segments(points, start_base, 10.0, 2.2)\n}\n\nfn apply_map(\n  f: ComplexFn,\n  z: C,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  let shifted = C(z.re -. b, z.im)\n  let scaled_in = case f {\n    Exp | Sin | Cos | Power -> c_scale(shifted, omega)\n    _ -> shifted\n  }\n  use w <- result.try(eval(f, scaled_in, omega))\n  Ok(c_scale(w, a))\n}\n\nfn eval(f: ComplexFn, z: C, omega: Float) -> Result(C, Nil) {\n  case f {\n    Identity -> Ok(z)\n    Square -> Ok(c_mul(z, z))\n    Cube -> Ok(c_mul(c_mul(z, z), z))\n    Reciprocal -> c_inv(z)\n    Conjugate -> Ok(C(z.re, 0.0 -. z.im))\n    Exp -> Ok(c_exp(z))\n    Sin -> Ok(c_sin(z))\n    Cos -> Ok(c_cos(z))\n    Sqrt -> c_sqrt(z)\n    Log -> c_log(z)\n    Power -> c_pow(z, omega)\n    Modulus -> Ok(C(c_abs(z), 0.0))\n    Arg -> Ok(C(js_atan2(z.im, z.re), 0.0))\n    Zeta -> c_zeta(z)\n    // Polar variants never reach eval.\n    UnitCircle\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> Error(Nil)\n  }\n}\n\nfn c_scale(z: C, s: Float) -> C {\n  C(z.re *. s, z.im *. s)\n}\n\nfn c_mul(z: C, w: C) -> C {\n  C(z.re *. w.re -. z.im *. w.im, z.re *. w.im +. z.im *. w.re)\n}\n\nfn c_abs(z: C) -> Float {\n  float.square_root(z.re *. z.re +. z.im *. z.im)\n  |> result_or_zero\n}\n\nfn result_or_zero(r: Result(Float, Nil)) -> Float {\n  case r {\n    Ok(v) -> v\n    Error(Nil) -> 0.0\n  }\n}\n\nfn c_inv(z: C) -> Result(C, Nil) {\n  let n = z.re *. z.re +. z.im *. z.im\n  case n <. 0.04 {\n    True -> Error(Nil)\n    False -> Ok(C(z.re /. n, 0.0 -. z.im /. n))\n  }\n}\n\nfn c_exp(z: C) -> C {\n  let ex = float.exponential(z.re)\n  C(ex *. js_cos(z.im), ex *. js_sin(z.im))\n}\n\nfn sinh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e -. inv } /. 2.0\n}\n\nfn cosh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e +. inv } /. 2.0\n}\n\nfn c_sin(z: C) -> C {\n  C(js_sin(z.re) *. cosh(z.im), js_cos(z.re) *. sinh(z.im))\n}\n\nfn c_cos(z: C) -> C {\n  C(js_cos(z.re) *. cosh(z.im), 0.0 -. js_sin(z.re) *. sinh(z.im))\n}\n\nfn c_sqrt(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.0001 {\n    True -> Ok(C(0.0, 0.0))\n    False -> {\n      let theta = js_atan2(z.im, z.re)\n      let half = theta /. 2.0\n      case float.square_root(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(root) -> Ok(C(root *. js_cos(half), root *. js_sin(half)))\n      }\n    }\n  }\n}\n\nfn c_log(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.05 {\n    True -> Error(Nil)\n    False ->\n      case float.logarithm(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(ln_r) -> Ok(C(ln_r, js_atan2(z.im, z.re)))\n      }\n  }\n}\n\nfn c_pow(z: C, omega: Float) -> Result(C, Nil) {\n  // z^ω = exp(ω Log z)\n  use lg <- result.try(c_log(z))\n  Ok(c_exp(c_scale(lg, omega)))\n}\n\nfn c_zeta(z: C) -> Result(C, Nil) {\n  // Pole at s = 1; also skip far left where the η approx is poor.\n  let dx = z.re -. 1.0\n  let dist = dx *. dx +. z.im *. z.im\n  case dist <. 0.04 || z.re <. 0.15 {\n    True -> Error(Nil)\n    False -> {\n      let #(re, im) = js_zeta(z.re, z.im)\n      case js_is_finite(re) && js_is_finite(im) {\n        False -> Error(Nil)\n        True ->\n          case\n            float.absolute_value(re) >. 12.0 || float.absolute_value(im) >. 12.0\n          {\n            True -> Error(Nil)\n            False -> Ok(C(re, im))\n          }\n      }\n    }\n  }\n}\n\nfn to_world(w: C) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  #(w.re *. scale, 0.0 -. w.im *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 90.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":17534,"new_hash":"7cbec62355bf4f395bd55708f0a9c56e5074e3f9382e8e9faaf579e9309eb78b","old_hash":"0b888dc1db3dcc1d05f403bf50144e167408e54f44fdb3d2e102e8e5855f7abf","operation":"modify","path":"src/complex_math.gleam"},"hash":"ee648ee1bf44eb44a75cabed58476e73c3d81dbbd72e427b5fd471318584c093","kind":"fs.external_change","prev_hash":"ac25b1f7e2e054cfc9d15a6989e9efc889e47b6696b840bb75b32c0409841230","seq":313,"t":5027619,"wall":"2026-11-25T22:28:48.880Z"}
{"data":{"diff_size":244,"new_content":"//// Complex / Polar submodes of Math on the Argand plane (Re / Im).\n//// — Complex maps: grid → w = a · f(ω(z − b))\n//// — Polar curves: r(θ) drawn on the same plane (calc-class classics + spirals)\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport math.{type Plot, Plot}\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan2\")\nfn js_atan2(y: Float, x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"zeta\")\nfn js_zeta(re: Float, im: Float) -> #(Float, Float)\n\n@external(javascript, \"./math_ffi.mjs\", \"is_finite\")\nfn js_is_finite(x: Float) -> Bool\n\n/// Maps ℂ→ℂ (Complex tab) and polar r(θ) curves (Polar tab).\npub type ComplexFn {\n  // ── Complex maps (grid images) ───────────────────────────────────────────\n  Identity\n  Square\n  Cube\n  Reciprocal\n  Conjugate\n  Exp\n  Sin\n  Cos\n  Sqrt\n  Log\n  /// w = z^ω via exp(ω Log z)\n  Power\n  Modulus\n  Arg\n  /// Approximate Riemann ζ via Dirichlet η (fun / illustrative).\n  Zeta\n  // ── Polar curves on the Argand plane ─────────────────────────────────────\n  UnitCircle\n  ArchimedesSpiral\n  LogSpiral\n  RoseCos\n  RoseSin\n  Cardioid\n  Limacon\n  Lemniscate\n}\n\npub type C {\n  C(re: Float, im: Float)\n}\n\n/// Axes + integer ticks (same layout count as real math mode).\npub const decoration_count = 18\n\nconst world_half = 450.0\n\nconst x_math_max = 5.0\n\nconst y_clip = 480.0\n\nconst domain_min = -2.0\n\nconst domain_max = 2.0\n\nconst samples_per_line = 48\n\nconst polar_samples = 360\n\nconst pi = 3.141592653589793\n\npub fn fn_id(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w=z\"\n    Square -> \"w=z^2\"\n    Cube -> \"w=z^3\"\n    Reciprocal -> \"w=1/z\"\n    Conjugate -> \"w=conj(z)\"\n    Exp -> \"w=exp(z)\"\n    Sin -> \"w=sin(z)\"\n    Cos -> \"w=cos(z)\"\n    Sqrt -> \"w=sqrt(z)\"\n    Log -> \"w=log(z)\"\n    Power -> \"w=z^w\"\n    Modulus -> \"w=|z|\"\n    Arg -> \"w=arg(z)\"\n    Zeta -> \"w=zeta(z)\"\n    UnitCircle -> \"r=1\"\n    ArchimedesSpiral -> \"r=a*theta\"\n    LogSpiral -> \"r=a*e^(k*theta)\"\n    RoseCos -> \"r=a*cos(n*theta)\"\n    RoseSin -> \"r=a*sin(n*theta)\"\n    Cardioid -> \"r=a*(1-cos(theta))\"\n    Limacon -> \"r=a+b*cos(theta)\"\n    Lemniscate -> \"r^2=a^2*cos(2*theta)\"\n  }\n}\n\npub fn fn_label(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w = z\"\n    Square -> \"w = z²\"\n    Cube -> \"w = z³\"\n    Reciprocal -> \"w = 1/z\"\n    Conjugate -> \"w = z̄\"\n    Exp -> \"w = exp(z)\"\n    Sin -> \"w = sin(z)\"\n    Cos -> \"w = cos(z)\"\n    Sqrt -> \"w = √z\"\n    Log -> \"w = Log(z)\"\n    Power -> \"w = z^ω\"\n    Modulus -> \"w = |z|\"\n    Arg -> \"w = Arg(z)\"\n    Zeta -> \"w = ζ(z)  (approx.)\"\n    UnitCircle -> \"r = 1  (unit circle)\"\n    ArchimedesSpiral -> \"r = aθ  (Archimedes)\"\n    LogSpiral -> \"r = a e^{kθ}  (log spiral)\"\n    RoseCos -> \"r = a cos(ωθ)  (rose)\"\n    RoseSin -> \"r = a sin(ωθ)  (rose)\"\n    Cardioid -> \"r = a(1 − cos θ)  (cardioid)\"\n    Limacon -> \"r = a + cos θ  (limaçon)\"\n    Lemniscate -> \"r² = a² cos(2θ)  (lemniscate)\"\n  }\n}\n\n/// Complex-tab presets (grid maps only).\npub fn all_map_functions() -> List(ComplexFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Reciprocal,\n    Conjugate,\n    Exp,\n    Sin,\n    Cos,\n    Sqrt,\n    Log,\n    Power,\n    Modulus,\n    Arg,\n    Zeta,\n  ]\n}\n\n/// Polar-tab presets (r(θ) curves on the Argand plane).\npub fn all_polar_functions() -> List(ComplexFn) {\n  [\n    UnitCircle,\n    ArchimedesSpiral,\n    LogSpiral,\n    RoseCos,\n    RoseSin,\n    Cardioid,\n    Limacon,\n    Lemniscate,\n  ]\n}\n\npub fn all_functions() -> List(ComplexFn) {\n  list.append(all_map_functions(), all_polar_functions())\n}\n\npub fn parse_fn_id(id: String) -> ComplexFn {\n  case id {\n    \"w=z\" -> Identity\n    \"w=z^2\" -> Square\n    \"w=z^3\" -> Cube\n    \"w=1/z\" -> Reciprocal\n    \"w=conj(z)\" -> Conjugate\n    \"w=exp(z)\" -> Exp\n    \"w=sin(z)\" -> Sin\n    \"w=cos(z)\" -> Cos\n    \"w=sqrt(z)\" -> Sqrt\n    \"w=log(z)\" -> Log\n    \"w=z^w\" -> Power\n    \"w=|z|\" -> Modulus\n    \"w=arg(z)\" -> Arg\n    \"w=zeta(z)\" -> Zeta\n    \"r=1\" -> UnitCircle\n    \"r=a*theta\" -> ArchimedesSpiral\n    \"r=a*e^(k*theta)\" -> LogSpiral\n    \"r=a*cos(n*theta)\" -> RoseCos\n    \"r=a*sin(n*theta)\" -> RoseSin\n    \"r=a*(1-cos(theta))\" -> Cardioid\n    \"r=a+b*cos(theta)\" -> Limacon\n    \"r^2=a^2*cos(2*theta)\" -> Lemniscate\n    _ -> Identity\n  }\n}\n\npub fn is_polar(f: ComplexFn) -> Bool {\n  case f {\n    UnitCircle\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// ω: maps (exp/sin/cos/power) and polar roses / spirals / lemniscate petals.\npub fn uses_omega(f: ComplexFn) -> Bool {\n  case f {\n    Exp | Sin | Cos | Power -> True\n    ArchimedesSpiral | LogSpiral | RoseCos | RoseSin | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// Stroke color: axes muted; images of horizontal lines teal; vertical magenta.\n/// Polar curves use teal only (horizontal_count covers all curve paths).\npub fn path_color(index: Int, horizontal_count: Int) -> String {\n  case index < decoration_count {\n    True -> \"#8a8aaa\"\n    False -> {\n      let j = index - decoration_count\n      case j < horizontal_count {\n        True -> \"#58C4DD\"\n        False -> \"#C77DFF\"\n      }\n    }\n  }\n}\n\npub fn plot(f: ComplexFn, a: Int, omega: Int, b: Int) -> #(Plot, Int) {\n  let a_f = int.to_float(int.clamp(a, -5, 5))\n  let w_f = int.to_float(int.clamp(omega, 1, 10))\n  let b_f = int.to_float(int.clamp(b, -5, 5))\n  let #(axis_paths, labels) = argand_decorations()\n  case is_polar(f) {\n    True -> {\n      let curves = polar_plot(f, a_f, w_f, b_f)\n      let n = list.length(curves)\n      #(Plot(list.append(axis_paths, curves), labels, []), n)\n    }\n    False -> {\n      let #(horiz, vert) = mapped_grid(f, a_f, w_f, b_f)\n      let horiz_n = list.length(horiz)\n      #(Plot(list.flatten([axis_paths, horiz, vert]), labels, []), horiz_n)\n    }\n  }\n}\n\nfn argand_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n\n  let re_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      0.0,\n      8.0,\n      axis_t,\n    )\n  let im_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      4.0,\n      12.0,\n      axis_t,\n    )\n\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let re_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let im_ticks =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let re_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        math_to_world(int.to_float(k)),\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let im_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        0.0 -. 28.0,\n        0.0 -. math_to_world(int.to_float(k)),\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 36.0, 36.0, \"Re\", \"#e8e8ff\", 28.0, 10.0, 14.0),\n    RenderLabel(\n      40.0,\n      0.0 -. world_half +. 28.0,\n      \"Im\",\n      \"#e8e8ff\",\n      28.0,\n      10.0,\n      14.0,\n    ),\n  ]\n\n  let paths = list.flatten([[re_axis, im_axis], re_ticks, im_ticks])\n  let labels = list.flatten([re_labels, im_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world(t: Float) -> Float {\n  t *. { world_half /. x_math_max }\n}\n\n// ── Polar curves ─────────────────────────────────────────────────────────────\n\nfn polar_plot(f: ComplexFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let amp = case float.absolute_value(a) <. 0.01 {\n    True -> 1.0\n    False -> float.absolute_value(a)\n  }\n  let points =\n    list.repeat(Nil, polar_samples + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(polar_samples)\n      case polar_point(f, t, amp, omega, b) {\n        Error(Nil) -> Error(Nil)\n        Ok(w) -> {\n          let #(wx, wy) = to_world(w)\n          case\n            float.absolute_value(wx) >. y_clip\n            || float.absolute_value(wy) >. y_clip\n          {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n    |> list.filter_map(fn(r) { r })\n  segments(points, 14.0, 40.0, 3.0)\n}\n\n/// t ∈ [0,1] parameter along the polar sweep.\nfn polar_point(\n  f: ComplexFn,\n  t: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  case f {\n    UnitCircle -> {\n      let theta = t *. 2.0 *. pi\n      Ok(from_polar(a, theta, b))\n    }\n    ArchimedesSpiral -> {\n      // θ ∈ [0, 2πω]; r = (a/8) θ  — more turns with larger ω\n      let theta = t *. 2.0 *. pi *. omega\n      let r = { a /. 8.0 } *. theta\n      Ok(from_polar(r, theta, b))\n    }\n    LogSpiral -> {\n      let theta = t *. 2.0 *. pi *. omega\n      let k = 0.12\n      let r = { a /. 3.0 } *. float.exponential(k *. theta)\n      case r >. 8.0 {\n        True -> Error(Nil)\n        False -> Ok(from_polar(r, theta, b))\n      }\n    }\n    RoseCos -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_cos(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseSin -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_sin(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Cardioid -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. { 1.0 -. js_cos(theta) }\n      Ok(from_polar(r, theta, b))\n    }\n    Limacon -> {\n      // Classic dimpled/looped limaçon: r = a + cos θ (a from slider)\n      let theta = t *. 2.0 *. pi\n      let r = a +. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Lemniscate -> {\n      // r² = a² cos(ωθ); classic figure-eight uses ω = 2\n      let theta = t *. 2.0 *. pi\n      let c = js_cos(omega *. theta)\n      case c <. 0.0 {\n        True -> Error(Nil)\n        False ->\n          case float.square_root(a *. a *. c) {\n            Error(Nil) -> Error(Nil)\n            Ok(r) -> Ok(from_polar(r, theta, b))\n          }\n      }\n    }\n    _ -> Error(Nil)\n  }\n}\n\nfn from_polar(r: Float, theta: Float, b_re: Float) -> C {\n  C(r *. js_cos(theta) +. b_re, r *. js_sin(theta))\n}\n\n// ── Grid maps ────────────────────────────────────────────────────────────────\n\nfn mapped_grid(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> #(List(Path), List(Path)) {\n  let levels = case f {\n    Zeta -> [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5]\n    _ -> [-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]\n  }\n  let dmin = case f {\n    Zeta -> 0.2\n    _ -> domain_min\n  }\n  let dmax = case f {\n    Zeta -> 2.8\n    _ -> domain_max\n  }\n  let horiz =\n    list.index_map(levels, fn(im, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        True,\n        im,\n        dmin,\n        dmax,\n        14.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  let vert_levels = case f {\n    Zeta -> [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5]\n    _ -> levels\n  }\n  let vert =\n    list.index_map(vert_levels, fn(re, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        False,\n        re,\n        case f {\n          Zeta -> -2.5\n          _ -> dmin\n        },\n        case f {\n          Zeta -> 2.5\n          _ -> dmax\n        },\n        26.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  #(horiz, vert)\n}\n\nfn sample_line(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  horizontal: Bool,\n  fixed: Float,\n  varying_min: Float,\n  varying_max: Float,\n  start_base: Float,\n) -> List(Path) {\n  let points =\n    list.repeat(Nil, samples_per_line + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(samples_per_line)\n      let varying = varying_min +. t *. { varying_max -. varying_min }\n      let z = case horizontal {\n        True -> C(varying, fixed)\n        False -> C(fixed, varying)\n      }\n      case apply_map(f, z, a, omega, b) {\n        Error(Nil) -> Error(Nil)\n        Ok(w) -> {\n          let #(wx, wy) = to_world(w)\n          case\n            float.absolute_value(wx) >. y_clip\n            || float.absolute_value(wy) >. y_clip\n          {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n    |> list.filter_map(fn(r) { r })\n  segments(points, start_base, 10.0, 2.2)\n}\n\nfn apply_map(\n  f: ComplexFn,\n  z: C,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  let shifted = C(z.re -. b, z.im)\n  let scaled_in = case f {\n    Exp | Sin | Cos | Power -> c_scale(shifted, omega)\n    _ -> shifted\n  }\n  use w <- result.try(eval(f, scaled_in, omega))\n  Ok(c_scale(w, a))\n}\n\nfn eval(f: ComplexFn, z: C, omega: Float) -> Result(C, Nil) {\n  case f {\n    Identity -> Ok(z)\n    Square -> Ok(c_mul(z, z))\n    Cube -> Ok(c_mul(c_mul(z, z), z))\n    Reciprocal -> c_inv(z)\n    Conjugate -> Ok(C(z.re, 0.0 -. z.im))\n    Exp -> Ok(c_exp(z))\n    Sin -> Ok(c_sin(z))\n    Cos -> Ok(c_cos(z))\n    Sqrt -> c_sqrt(z)\n    Log -> c_log(z)\n    Power -> c_pow(z, omega)\n    Modulus -> Ok(C(c_abs(z), 0.0))\n    Arg -> Ok(C(js_atan2(z.im, z.re), 0.0))\n    Zeta -> c_zeta(z)\n    // Polar variants never reach eval.\n    UnitCircle\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> Error(Nil)\n  }\n}\n\nfn c_scale(z: C, s: Float) -> C {\n  C(z.re *. s, z.im *. s)\n}\n\nfn c_mul(z: C, w: C) -> C {\n  C(z.re *. w.re -. z.im *. w.im, z.re *. w.im +. z.im *. w.re)\n}\n\nfn c_abs(z: C) -> Float {\n  float.square_root(z.re *. z.re +. z.im *. z.im)\n  |> result_or_zero\n}\n\nfn result_or_zero(r: Result(Float, Nil)) -> Float {\n  case r {\n    Ok(v) -> v\n    Error(Nil) -> 0.0\n  }\n}\n\nfn c_inv(z: C) -> Result(C, Nil) {\n  let n = z.re *. z.re +. z.im *. z.im\n  case n <. 0.04 {\n    True -> Error(Nil)\n    False -> Ok(C(z.re /. n, 0.0 -. z.im /. n))\n  }\n}\n\nfn c_exp(z: C) -> C {\n  let ex = float.exponential(z.re)\n  C(ex *. js_cos(z.im), ex *. js_sin(z.im))\n}\n\nfn sinh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e -. inv } /. 2.0\n}\n\nfn cosh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e +. inv } /. 2.0\n}\n\nfn c_sin(z: C) -> C {\n  C(js_sin(z.re) *. cosh(z.im), js_cos(z.re) *. sinh(z.im))\n}\n\nfn c_cos(z: C) -> C {\n  C(js_cos(z.re) *. cosh(z.im), 0.0 -. js_sin(z.re) *. sinh(z.im))\n}\n\nfn c_sqrt(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.0001 {\n    True -> Ok(C(0.0, 0.0))\n    False -> {\n      let theta = js_atan2(z.im, z.re)\n      let half = theta /. 2.0\n      case float.square_root(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(root) -> Ok(C(root *. js_cos(half), root *. js_sin(half)))\n      }\n    }\n  }\n}\n\nfn c_log(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.05 {\n    True -> Error(Nil)\n    False ->\n      case float.logarithm(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(ln_r) -> Ok(C(ln_r, js_atan2(z.im, z.re)))\n      }\n  }\n}\n\nfn c_pow(z: C, omega: Float) -> Result(C, Nil) {\n  // z^ω = exp(ω Log z)\n  use lg <- result.try(c_log(z))\n  Ok(c_exp(c_scale(lg, omega)))\n}\n\nfn c_zeta(z: C) -> Result(C, Nil) {\n  // Pole at s = 1; also skip far left where the η approx is poor.\n  let dx = z.re -. 1.0\n  let dist = dx *. dx +. z.im *. z.im\n  case dist <. 0.04 || z.re <. 0.15 {\n    True -> Error(Nil)\n    False -> {\n      let #(re, im) = js_zeta(z.re, z.im)\n      case js_is_finite(re) && js_is_finite(im) {\n        False -> Error(Nil)\n        True ->\n          case\n            float.absolute_value(re) >. 12.0 || float.absolute_value(im) >. 12.0\n          {\n            True -> Error(Nil)\n            False -> Ok(C(re, im))\n          }\n      }\n    }\n  }\n}\n\nfn to_world(w: C) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  #(w.re *. scale, 0.0 -. w.im *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 90.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":17779,"new_hash":"3c3c246a7cc8f0663eb14a02a37df1c30c2c7c34ed95b5ea8975dfb14cb81e99","old_hash":"7cbec62355bf4f395bd55708f0a9c56e5074e3f9382e8e9faaf579e9309eb78b","operation":"modify","path":"src/complex_math.gleam"},"hash":"c184ce3a289ee4fed146b02b0ac17fb0495099f51c319a75e98ed8e6ea83dc03","kind":"fs.external_change","prev_hash":"ee648ee1bf44eb44a75cabed58476e73c3d81dbbd72e427b5fd471318584c093","seq":314,"t":5029636,"wall":"2026-11-25T22:28:50.897Z"}
