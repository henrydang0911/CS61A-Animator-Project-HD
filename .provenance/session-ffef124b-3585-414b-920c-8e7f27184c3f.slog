{"data":{"diff_size":147,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Unit step (Heaviside): 0 for x < b, 1 for x ≥ b.\n  Step\n  /// Discrete-style impulse at x = b (Kronecker / δ spike on the plot).\n  Kronecker\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// True when the slope slider m applies (line y = mx − b).\npub fn uses_slope(f: MathFn) -> Bool {\n  case f {\n    Identity -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = mx − b\"\n    Square -> \"y = (x − b)²\"\n    Cube -> \"y = (x − b)³\"\n    ScaledSine -> \"y = a·sin(ω(x − b))\"\n    ScaledCosine -> \"y = a·cos(ω(x − b))\"\n    Tangent -> \"y = tan(x − b)\"\n    Exp -> \"y = exp(x − b)\"\n    Ln -> \"y = ln(x − b)\"\n    Sqrt -> \"y = √(x − b)\"\n    Reciprocal -> \"y = 1/(x − b)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// Most plots use f(x − b). The line is y = mx − b. Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n  m: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let m_f = int.to_float(int.clamp(m, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f, m_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(\n  f: MathFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, a, omega, b, m) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(\n  f: MathFn,\n  x: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> Result(Float, Nil) {\n  let u = x -. b\n  case f {\n    // Line through slope-intercept form y = mx − b (b from the shift slider).\n    Identity -> Ok(m *. x -. b)\n    Square -> Ok(u *. u)\n    Cube -> Ok(u *. u *. u)\n    ScaledSine -> Ok(a *. js_sin(omega *. u))\n    ScaledCosine -> Ok(a *. js_cos(omega *. u))\n    Tangent -> {\n      let c = js_cos(u)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(u))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(u)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(u)\n    Sqrt -> float.square_root(u)\n    Reciprocal ->\n      case float.absolute_value(u) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. u)\n      }\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":9242,"new_hash":"1dfd9fcd2025529387485d49d9baf4e98ca7898a686bf33028333cced7d9bc1b","old_hash":"66f732216770d775c8bb14f2a6cdae66f1d8bed9f18f56da5f904cc6d73e1451","operation":"modify","path":"src/math.gleam"},"hash":"3e99b8f785d21c1a4d3829476adc1be6f865aac7f51c2eefdfe6688606390803","kind":"fs.external_change","prev_hash":"65389f5abb2e7a27cc2cde3575fa40a537bdb08c42096e5d47a84149ffad77aa","seq":212,"t":3654687,"wall":"2026-11-25T22:06:03.557Z"}
{"data":{"diff_size":219,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Unit step (Heaviside): 0 for x < b, 1 for x ≥ b.\n  Step\n  /// Discrete-style impulse at x = b (Kronecker / δ spike on the plot).\n  Kronecker\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// True when the slope slider m applies (line y = mx − b).\npub fn uses_slope(f: MathFn) -> Bool {\n  case f {\n    Identity -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    Step -> \"y=step\"\n    Kronecker -> \"y=delta\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = mx − b\"\n    Square -> \"y = (x − b)²\"\n    Cube -> \"y = (x − b)³\"\n    ScaledSine -> \"y = a·sin(ω(x − b))\"\n    ScaledCosine -> \"y = a·cos(ω(x − b))\"\n    Tangent -> \"y = tan(x − b)\"\n    Exp -> \"y = exp(x − b)\"\n    Ln -> \"y = ln(x − b)\"\n    Sqrt -> \"y = √(x − b)\"\n    Reciprocal -> \"y = 1/(x − b)\"\n    Step -> \"y = u(x − b)  (step / Heaviside)\"\n    Kronecker -> \"y = δ(x − b)  (Kronecker spike)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Step,\n    Kronecker,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=step\" -> Step\n    \"y=delta\" -> Kronecker\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// Most plots use f(x − b). The line is y = mx − b. Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n  m: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let m_f = int.to_float(int.clamp(m, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f, m_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(\n  f: MathFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, a, omega, b, m) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(\n  f: MathFn,\n  x: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> Result(Float, Nil) {\n  let u = x -. b\n  case f {\n    // Line through slope-intercept form y = mx − b (b from the shift slider).\n    Identity -> Ok(m *. x -. b)\n    Square -> Ok(u *. u)\n    Cube -> Ok(u *. u *. u)\n    ScaledSine -> Ok(a *. js_sin(omega *. u))\n    ScaledCosine -> Ok(a *. js_cos(omega *. u))\n    Tangent -> {\n      let c = js_cos(u)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(u))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(u)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(u)\n    Sqrt -> float.square_root(u)\n    Reciprocal ->\n      case float.absolute_value(u) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. u)\n      }\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":9466,"new_hash":"cd2179a840f6fab1d3a3ac0b2c076d8b441b1ae2583b655cc52a26aba0766926","old_hash":"1dfd9fcd2025529387485d49d9baf4e98ca7898a686bf33028333cced7d9bc1b","operation":"modify","path":"src/math.gleam"},"hash":"2a68aab03584c9eca926b25a9cd6dd5a82f2618bf4c3f8b268eaf5fb940d832c","kind":"fs.external_change","prev_hash":"3e99b8f785d21c1a4d3829476adc1be6f865aac7f51c2eefdfe6688606390803","seq":213,"t":3659674,"wall":"2026-11-25T22:06:08.545Z"}
{"data":{"active_file":"src/app.gleam","focused":true,"idle_since_ms":191005.35149999987},"hash":"30361e94c2061933be898966c1d03f55768b0c550efa8c3846345ab32e20b542","kind":"session.heartbeat","prev_hash":"2a68aab03584c9eca926b25a9cd6dd5a82f2618bf4c3f8b268eaf5fb940d832c","seq":214,"t":3660767,"wall":"2026-11-25T22:06:09.638Z"}
