{"data":{"deltas":[{"range":{"end":{"character":0,"line":635},"start":{"character":0,"line":606}},"text":"      PolarPlane -> view_polar_math_controls(model)\n    },\n  ])\n}\n\nfn view_plane_toggle(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"plane-toggle\")], [\n    plane_tab(model, RealPlane, \"Real\"),\n    plane_tab(model, ComplexPlane, \"Complex\"),\n    plane_tab(model, PolarPlane, \"Polar\"),\n  ])\n}\n\nfn plane_tab(model: Model, plane: MathPlane, label: String) -> Element(Msg) {\n  html.button(\n    [\n      attr.class(case model.math_plane == plane {\n        True -> \"mode-btn mode-btn-active\"\n        False -> \"mode-btn\"\n      }),\n      attr.type_(\"button\"),\n      event.on_click(SetMathPlane(plane)),\n    ],\n    [html.text(label)],\n  )\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"2bc38985b5369b6517a86c5731384125db8464af431045937885c3ff6fa6aa0d","kind":"doc.change","prev_hash":"5eb9a910a55c9117f969ac4adf8ead9d2fc3d860815d128ffe11fc7f259398ed","seq":324,"t":5040669,"wall":"2026-11-25T22:29:01.930Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":697},"start":{"character":0,"line":665}},"text":"    list.map(complex_math.all_map_functions(), fn(f) {\n      html.option(\n        [\n          attr.value(complex_math.fn_id(f)),\n          attr.selected(f == model.complex_fn),\n        ],\n        complex_math.fn_label(f),\n      )\n    })\n  html.div([attr.class(\"math-controls\")], [\n    html.p([attr.class(\"math-blurb\")], [\n      html.text(\n        \"Argand plane: grid images under w = a·f(ω(z − b)). Teal = horizontal lines, violet = vertical.\",\n      ),\n    ]),\n    html.label([attr.class(\"drawing-select-label\")], [\n      html.span([], [html.text(\"Map\")]),\n      html.select(\n        [\n          attr.attribute(\"data-test-id\", \"complex-fn-select\"),\n          attr.class(\"drawing-select\"),\n          event.on_change(fn(id) {\n            SetComplexFn(complex_math.parse_fn_id(id))\n          }),\n        ],\n        options,\n      ),\n    ]),\n    html.p([attr.class(\"math-formula\")], [\n      html.text(complex_math.fn_label(model.complex_fn)),\n    ]),\n    view_argand_param_sliders(model, model.complex_fn),\n  ])\n}\n\nfn view_polar_math_controls(model: Model) -> Element(Msg) {\n  let options =\n    list.map(complex_math.all_polar_functions(), fn(f) {\n      html.option(\n        [\n          attr.value(complex_math.fn_id(f)),\n          attr.selected(f == model.polar_fn),\n        ],\n        complex_math.fn_label(f),\n      )\n    })\n  html.div([attr.class(\"math-controls\")], [\n    html.p([attr.class(\"math-blurb\")], [\n      html.text(\n        \"Polar curves r(θ) on the Argand plane. a scales size, ω sets petals/turns, b shifts along Re.\",\n      ),\n    ]),\n    html.label([attr.class(\"drawing-select-label\")], [\n      html.span([], [html.text(\"Curve\")]),\n      html.select(\n        [\n          attr.attribute(\"data-test-id\", \"polar-fn-select\"),\n          attr.class(\"drawing-select\"),\n          event.on_change(fn(id) {\n            SetPolarFn(complex_math.parse_fn_id(id))\n          }),\n        ],\n        options,\n      ),\n    ]),\n    html.p([attr.class(\"math-formula\")], [\n      html.text(complex_math.fn_label(model.polar_fn)),\n    ]),\n    view_argand_param_sliders(model, model.polar_fn),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"4168bd78c088afd3bce35b74f3ddbf4c7bf454defc2c7f2778b15a45d983189f","kind":"doc.change","prev_hash":"2bc38985b5369b6517a86c5731384125db8464af431045937885c3ff6fa6aa0d","seq":325,"t":5047604,"wall":"2026-11-25T22:29:08.865Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":868},"start":{"character":0,"line":830}},"text":"fn view_argand_param_sliders(\n  model: Model,\n  f: ComplexFn,\n) -> Element(Msg) {\n  let shift =\n    html.label([attr.class(\"slider-label slider-label-full\")], [\n      html.span([], [\n        html.text(\"b (Re shift) \" <> int.to_string(model.math_shift)),\n      ]),\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"-5\"),\n        attr.max(\"5\"),\n        attr.step(\"1\"),\n        attr.value(int.to_string(model.math_shift)),\n        attr.attribute(\"title\", \"Real-axis shift b\"),\n        event.on_input(fn(raw) {\n          SetMathShift(result.unwrap(int.parse(raw), model.math_shift))\n        }),\n      ]),\n    ])\n\n  let scale =\n    html.label([attr.class(\"slider-label slider-label-full\")], [\n      html.span([], [\n        html.text(\"a (scale) \" <> int.to_string(model.math_amp)),\n      ]),\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"-5\"),\n        attr.max(\"5\"),\n        attr.step(\"1\"),\n        attr.value(int.to_string(model.math_amp)),\n        attr.attribute(\"title\", \"Scale a; default 1\"),\n        event.on_input(fn(raw) {\n          SetMathAmp(result.unwrap(int.parse(raw), model.math_amp))\n        }),\n      ]),\n    ])\n\n  let omega = case complex_math.uses_omega(f) {\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"bbf28584f1350d04852905175ebd0fdaac57671b4ac73ba480e95c58f7fc269a","kind":"doc.change","prev_hash":"4168bd78c088afd3bce35b74f3ddbf4c7bf454defc2c7f2778b15a45d983189f","seq":326,"t":5053079,"wall":"2026-11-25T22:29:14.340Z"}
