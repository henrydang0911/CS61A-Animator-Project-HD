{"data":{"content":"    SetMathShift(b) ->\n      refresh_math(Model(..model, math_shift: int.clamp(b, -5, 5)), False)\n\n","length":99,"path":"src\\app.gleam","range":{"end":{"character":0,"line":373},"start":{"character":0,"line":373}},"sha256":"eb3ea1c24a68ef9be2a5bbc12baa57e0c96a37932891b38bd1c345fdf8a3724c"},"hash":"29dceabbe9c20caec388f1d412fb8671ae1e7d7314aa914b932731da0255db50","kind":"paste","prev_hash":"bbb3e3253d375ca605cd155a781e0d6fe8f7ae90df321243a012d3d8caeea73b","seq":156,"t":2764326,"wall":"2026-11-25T21:51:13.197Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":593},"start":{"character":0,"line":550}},"text":"    view_math_param_sliders(model),\n  ])\n}\n\nfn view_math_param_sliders(model: Model) -> Element(Msg) {\n  let shift =\n    html.label([attr.class(\"slider-label slider-label-full\")], [\n      html.span([], [\n        html.text(\"b (shift) \" <> int.to_string(model.math_shift)),\n      ]),\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"-5\"),\n        attr.max(\"5\"),\n        attr.step(\"1\"),\n        attr.value(int.to_string(model.math_shift)),\n        attr.attribute(\"title\", \"Horizontal shift b in f(x − b)\"),\n        event.on_input(fn(raw) {\n          SetMathShift(result.unwrap(int.parse(raw), model.math_shift))\n        }),\n      ]),\n    ])\n\n  let wave = case math.uses_wave_params(model.math_fn) {\n    False -> []\n    True -> [\n      html.label([attr.class(\"slider-label slider-label-full\")], [\n        html.span([], [\n          html.text(\"a (amplitude) \" <> int.to_string(model.math_amp)),\n        ]),\n        html.input([\n          attr.type_(\"range\"),\n          attr.min(\"-5\"),\n          attr.max(\"5\"),\n          attr.step(\"1\"),\n          attr.value(int.to_string(model.math_amp)),\n          attr.attribute(\"title\", \"Amplitude a (−5…5); default 1\"),\n          event.on_input(fn(raw) {\n            SetMathAmp(result.unwrap(int.parse(raw), model.math_amp))\n          }),\n        ]),\n      ]),\n      html.label([attr.class(\"slider-label slider-label-full\")], [\n        html.span([], [\n          html.text(\"ω (omega) \" <> int.to_string(model.math_omega)),\n        ]),\n        html.input([\n          attr.type_(\"range\"),\n          attr.min(\"1\"),\n          attr.max(\"10\"),\n          attr.step(\"1\"),\n          attr.value(int.to_string(model.math_omega)),\n          attr.attribute(\"title\", \"Angular frequency ω (1…10); default 1\"),\n          event.on_input(fn(raw) {\n            SetMathOmega(result.unwrap(int.parse(raw), model.math_omega))\n          }),\n        ]),\n      ]),\n    ]\n  }\n\n  html.div([attr.class(\"math-wave-sliders\")], [shift, ..wave])\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"58628dd257ba30d1058d3fde68175ef2131e76dee4a7d1b2881cde14f28e9bbf","kind":"doc.change","prev_hash":"29dceabbe9c20caec388f1d412fb8671ae1e7d7314aa914b932731da0255db50","seq":157,"t":2772329,"wall":"2026-11-25T21:51:21.200Z"}
