{"data":{"deltas":[{"range":{"end":{"character":0,"line":729},"start":{"character":0,"line":696}},"text":"  html.div([attr.class(\"math-controls\")], [\n    html.p([attr.class(\"math-formula\")], [\n      html.text(complex_math.fn_label(complex_math.ExpITheta)),\n    ]),\n    html.p([attr.class(\"math-blurb\")], [\n      html.text(\n        \"Tangent arrow for e^iθ. Enter θ (pi, pi/2, 3*pi/2, …) to jump; leave empty to sweep.\",\n      ),\n    ]),\n    html.label([attr.class(\"drawing-select-label\")], [\n      html.span([], [html.text(\"θ\")]),\n      html.input([\n        attr.type_(\"text\"),\n        attr.class(\"drawing-select\"),\n        attr.attribute(\"data-test-id\", \"complex-theta-input\"),\n        attr.value(model.complex_theta_input),\n        attr.placeholder(\"pi/2\"),\n        attr.attribute(\"title\", \"θ in radians: pi, pi/2, 0, 2*pi, …\"),\n        event.on_input(SetComplexTheta),\n      ]),\n    ]),\n    view_argand_param_sliders(model, complex_math.ExpITheta),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"1ffbff053eae58b4a1c562c9a551463b672a54002bee1a0b5c600b83ec02c41d","kind":"doc.change","prev_hash":"73e4561e7af34686e323ead0b7f4946717f05e28814c0c848d19e82127df065b","seq":437,"t":6445922,"wall":"2026-11-25T22:52:27.183Z"}
