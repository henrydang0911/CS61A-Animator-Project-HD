{"data":{"deltas":[{"range":{"end":{"character":0,"line":719},"start":{"character":0,"line":707}},"text":"        \"Tangent arrow for e^iθ. θ is limited to [0, 2π]. Enter pi, pi/2, … to jump; leave empty to sweep.\",\n      ),\n    ]),\n    html.label([attr.class(\"drawing-select-label\")], [\n      html.span([], [html.text(\"θ  (0 … 2π)\")]),\n      html.input([\n        attr.type_(\"text\"),\n        attr.class(\"drawing-select\"),\n        attr.attribute(\"data-test-id\", \"complex-theta-input\"),\n        attr.value(model.complex_theta_input),\n        attr.placeholder(\"pi/2\"),\n        attr.attribute(\n          \"title\",\n          \"θ in [0, 2π]: 0, pi/2, pi, 3*pi/2, 2*pi, …\",\n        ),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"683f0f27b3e4888aa13edf93a5aa59afa2cb3d182e7bf668058089750d49e436","kind":"doc.change","prev_hash":"1ec1b6a97d03ed4483964e801af633c0345e56c6a0b040bafc36909174b93df3","seq":444,"t":6537312,"wall":"2026-11-25T22:53:58.573Z"}
