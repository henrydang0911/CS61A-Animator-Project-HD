,"version":"2.13.1"},{"enabled":true,"id":"hbenl.vscode-test-explorer","version":"2.22.1"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.autopep8","version":"2026.6.0"},{"enabled":false,"id":"ms-python.black-formatter","version":"2026.8.0"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":false,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.44.0"},{"enabled":false,"id":"ms-toolsai.jupyter","version":"2025.9.1"},{"enabled":false,"id":"ms-toolsai.jupyter-keymap","version":"1.1.2"},{"enabled":false,"id":"ms-toolsai.jupyter-renderers","version":"1.3.0"},{"enabled":false,"id":"ms-toolsai.vscode-jupyter-cell-tags","version":"0.1.9"},{"enabled":false,"id":"ms-toolsai.vscode-jupyter-slideshow","version":"0.1.6"},{"enabled":false,"id":"ms-vscode.cmake-tools","version":"1.25.10"},{"enabled":false,"id":"ms-vscode.cpp-devtools","version":"0.7.2"},{"enabled":false,"id":"ms-vscode.cpptools","version":"1.35.6"},{"enabled":false,"id":"ms-vscode.cpptools-extension-pack","version":"1.5.1"},{"enabled":false,"id":"ms-vscode.cpptools-themes","version":"2.0.0"},{"enabled":true,"id":"ms-vscode.test-adapter-converter","version":"0.2.1"},{"enabled":false,"id":"tht13.python","version":"0.2.3"}]},"hash":"da86c391828900b6d0c2e8810e261611c0e8d8d72d44e2f831ca689b7004f371","kind":"ext.snapshot","prev_hash":"72c9a195cb5e9638e9b221ecf0a4edb06396bbe5f6226b7d1d1427425ff19b0b","seq":405,"t":6028519,"wall":"2026-11-25T22:45:29.780Z"}
