{"data":{"deltas":[{"range":{"end":{"character":0,"line":274},"start":{"character":0,"line":260}},"text":"          complex_math.ExpITheta,\n          model.math_amp,\n          model.math_omega,\n          model.math_shift,\n          model.complex_theta,\n        )\n      Ok(#(plot, ComplexStyle(horiz, sweep)))\n    }\n    PolarPlane -> {\n      let #(plot, horiz, sweep) =\n        complex_math.plot(\n          model.polar_fn,\n          model.math_amp,\n          model.math_omega,\n          model.math_shift,\n          None,\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"d6240318eb0f80e15faae689085f80ffec1594ff5c1e66c1f236647ca562c954","kind":"doc.change","prev_hash":"14ab751069901ca1bdc5c6ec54ae634976682ba7c2c8e83dc4c44eb13314ad76","seq":434,"t":6439448,"wall":"2026-11-25T22:52:20.709Z"}
{"data":{"content":"    SetComplexTheta(raw) -> {\n      let pinned = case complex_math.parse_theta(raw) {\n        Ok(theta) -> Some(theta)\n        Error(Nil) -> None\n      }\n      refresh_math(\n        Model(..model, complex_theta_input: raw, complex_theta: pinned),\n        False,\n      )\n    }\n\n","length":277,"path":"src\\app.gleam","range":{"end":{"character":0,"line":461},"start":{"character":0,"line":461}},"sha256":"701b8b4702892bd26c6e6e4b76d17b7da8dc10ae01a2c9f9b601ecca62eb5cd6"},"hash":"0da78c6ea52881a9356bed4bf356fac8e60732ee8539de3a7c8321178231997b","kind":"paste","prev_hash":"d6240318eb0f80e15faae689085f80ffec1594ff5c1e66c1f236647ca562c954","seq":435,"t":6441581,"wall":"2026-11-25T22:52:22.842Z"}
