{"data":{"extensions":[{"enabled":true,"id":"TypeScriptTeam.jsts-chat-features","version":"0.0.7"},{"enabled":false,"id":"vscode.bat","version":"10.0.0"},{"enabled":false,"id":"vscode.clojure","version":"10.0.0"},{"enabled":false,"id":"vscode.coffeescript","version":"10.0.0"},{"enabled":false,"id":"vscode.configuration-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.cpp","version":"10.0.0"},{"enabled":false,"id":"vscode.csharp","version":"10.0.0"},{"enabled":false,"id":"vscode.css","version":"10.0.0"},{"enabled":false,"id":"vscode.css-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.dart","version":"10.0.0"},{"enabled":true,"id":"vscode.debug-auto-launch","version":"10.0.0"},{"enabled":false,"id":"vscode.debug-server-ready","version":"10.0.0"},{"enabled":false,"id":"vscode.diff","version":"10.0.0"},{"enabled":false,"id":"vscode.docker","version":"10.0.0"},{"enabled":false,"id":"vscode.dotenv","version":"10.0.0"},{"enabled":true,"id":"vscode.emmet","version":"10.0.0"},{"enabled":false,"id":"vscode.extension-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.fsharp","version":"10.0.0"},{"enabled":true,"id":"vscode.git","version":"10.0.0"},{"enabled":true,"id":"vscode.git-base","version":"10.0.0"},{"enabled":true,"id":"vscode.github","version":"0.0.1"},{"enabled":true,"id":"vscode.github-authentication","version":"0.0.2"},{"enabled":false,"id":"vscode.go","version":"10.0.0"},{"enabled":false,"id":"vscode.groovy","version":"10.0.0"},{"enabled":false,"id":"vscode.grunt","version":"10.0.0"},{"enabled":false,"id":"vscode.gulp","version":"10.0.0"},{"enabled":false,"id":"vscode.handlebars","version":"10.0.0"},{"enabled":false,"id":"vscode.hlsl","version":"10.0.0"},{"enabled":false,"id":"vscode.html","version":"10.0.0"},{"enabled":false,"id":"vscode.html-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.ini","version":"10.0.0"},{"enabled":false,"id":"vscode.ipynb","version":"10.0.0"},{"enabled":false,"id":"vscode.jake"