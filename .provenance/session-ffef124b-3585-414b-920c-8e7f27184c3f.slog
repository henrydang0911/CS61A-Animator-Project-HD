{"data":{"deltas":[{"range":{"end":{"character":0,"line":542},"start":{"character":0,"line":522}},"text":"    html.label([attr.class(\"drawing-select-label\")], [\n      html.span([], [html.text(\"Function\")]),\n      html.select(\n        [\n          attr.attribute(\"data-test-id\", \"math-fn-select\"),\n          attr.class(\"drawing-select\"),\n          event.on_change(fn(id) { SetMathFn(math.parse_fn_id(id)) }),\n        ],\n        options,\n      ),\n    ]),\n    html.p([attr.class(\"math-formula\")], [\n      html.text(math.fn_label(model.math_fn)),\n    ]),\n    view_math_wave_sliders(model),\n  ])\n}\n\nfn view_math_wave_sliders(model: Model) -> Element(Msg) {\n  case math.uses_wave_params(model.math_fn) {\n    False -> element.none()\n    True ->\n      html.div([attr.class(\"math-wave-sliders\")], [\n        html.label([attr.class(\"slider-label slider-label-full\")], [\n          html.span([], [\n            html.text(\"a (amplitude) \" <> int.to_string(model.math_amp)),\n          ]),\n          html.input([\n            attr.type_(\"range\"),\n            attr.min(\"-5\"),\n            attr.max(\"5\"),\n            attr.step(\"1\"),\n            attr.value(int.to_string(model.math_amp)),\n            attr.attribute(\"title\", \"Amplitude a (−5…5); default 1\"),\n            event.on_input(fn(raw) {\n              SetMathAmp(result.unwrap(int.parse(raw), model.math_amp))\n            }),\n          ]),\n        ]),\n        html.label([attr.class(\"slider-label slider-label-full\")], [\n          html.span([], [\n            html.text(\"ω (omega) \" <> int.to_string(model.math_omega)),\n          ]),\n          html.input([\n            attr.type_(\"range\"),\n            attr.min(\"1\"),\n            attr.max(\"10\"),\n            attr.step(\"1\"),\n            attr.value(int.to_string(model.math_omega)),\n            attr.attribute(\"title\", \"Angular frequency ω (1…10); default 1\"),\n            event.on_input(fn(raw) {\n              SetMathOmega(result.unwrap(int.parse(raw), model.math_omega))\n            }),\n          ]),\n        ]),\n      ])\n  }\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"0d9555f3cd18bde7fc4720d1eed74c69c817c418e6410c8d76bf6febfc149b57","kind":"doc.change","prev_hash":"49da801424453de51addf57a1ff8c509f1216f4a2ab60d35fc1df10a5c8cd2f6","seq":137,"t":2544763,"wall":"2026-11-25T21:47:33.634Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":701},"start":{"character":0,"line":678}},"text":"    case model.mode {\n      MathMode -> element.none()\n      DrawMode ->\n        html.label([attr.class(\"slider-label slider-label-full\")], [\n          html.span([], [\n            html.text(\"Shape \" <> int.to_string(model.shape_slider)),\n          ]),\n          html.input([\n            attr.type_(\"range\"),\n            attr.min(\"0\"),\n            attr.max(\"100\"),\n            attr.step(\"1\"),\n            attr.value(int.to_string(model.shape_slider)),\n            attr.attribute(\"data-test-id\", \"shape-slider\"),\n            attr.attribute(\"title\", \"shape_slider passed to draw (not speed)\"),\n            event.on_input(fn(raw) {\n              SetShape(result.unwrap(int.parse(raw), model.shape_slider))\n            }),\n          ]),\n        ])\n    },\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"cccabd0c8303ffcf5d2ce651044035dcf032c6899cd16b3e2eee042d9799a965","kind":"doc.change","prev_hash":"0d9555f3cd18bde7fc4720d1eed74c69c817c418e6410c8d76bf6febfc149b57","seq":138,"t":2548179,"wall":"2026-11-25T21:47:37.050Z"}
