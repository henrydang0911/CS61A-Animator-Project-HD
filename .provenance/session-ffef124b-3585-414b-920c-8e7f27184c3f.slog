{"data":{"diff_size":237,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport render.{type RenderDot, type RenderLabel, RenderDot, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"asin\")\nfn js_asin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"acos\")\nfn js_acos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan\")\nfn js_atan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Absolute\n  Signum\n  ScaledSine\n  ScaledCosine\n  Tangent\n  ArcSine\n  ArcCosine\n  ArcTangent\n  ArcSecant\n  ArcCosecant\n  ArcCotangent\n  Exp\n  /// Exponential with adjustable base: y = aˣ (a from the base slider).\n  Power\n  Ln\n  Sqrt\n  Reciprocal\n  /// Unit step (Heaviside): 0 for x < b, 1 for x ≥ b.\n  Step\n  /// Discrete-style impulse at x = b (Kronecker / δ spike on the plot).\n  Kronecker\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// True when the base slider a applies (y = aˣ).\npub fn uses_base_param(f: MathFn) -> Bool {\n  case f {\n    Power -> True\n    _ -> False\n  }\n}\n\n/// True when the slope slider m applies (line y = mx − b).\npub fn uses_slope(f: MathFn) -> Bool {\n  case f {\n    Identity -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Absolute -> \"y=abs(x)\"\n    Signum -> \"y=sgn(x)\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    ArcSine -> \"y=arcsin(x)\"\n    ArcCosine -> \"y=arccos(x)\"\n    ArcTangent -> \"y=arctan(x)\"\n    ArcSecant -> \"y=arcsec(x)\"\n    ArcCosecant -> \"y=arccsc(x)\"\n    ArcCotangent -> \"y=arccot(x)\"\n    Exp -> \"y=exp(x)\"\n    Power -> \"y=a^x\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    Step -> \"y=step\"\n    Kronecker -> \"y=delta\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = mx\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Absolute -> \"y = |x|\"\n    Signum -> \"y = sgn(x)\"\n    ScaledSine -> \"y = a·sin(ωx)\"\n    ScaledCosine -> \"y = a·cos(ωx)\"\n    Tangent -> \"y = tan(x)\"\n    ArcSine -> \"y = arcsin(x)\"\n    ArcCosine -> \"y = arccos(x)\"\n    ArcTangent -> \"y = arctan(x)\"\n    ArcSecant -> \"y = arcsec(x)\"\n    ArcCosecant -> \"y = arccsc(x)\"\n    ArcCotangent -> \"y = arccot(x)\"\n    Exp -> \"y = exp(x)\"\n    Power -> \"y = aˣ\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    Step -> \"y = u(x)  (step / Heaviside)\"\n    Kronecker -> \"y = δ(x)  (Kronecker spike)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Absolute,\n    Signum,\n    Step,\n    Kronecker,\n    Tangent,\n    ArcSine,\n    ArcCosine,\n    ArcTangent,\n    ArcSecant,\n    ArcCosecant,\n    ArcCotangent,\n    Exp,\n    Power,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=abs(x)\" -> Absolute\n    \"y=sgn(x)\" -> Signum\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=arcsin(x)\" -> ArcSine\n    \"y=arccos(x)\" -> ArcCosine\n    \"y=arctan(x)\" -> ArcTangent\n    \"y=arcsec(x)\" -> ArcSecant\n    \"y=arccsc(x)\" -> ArcCosecant\n    \"y=arccot(x)\" -> ArcCotangent\n    \"y=exp(x)\" -> Exp\n    \"y=a^x\" -> Power\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=step\" -> Step\n    \"y=delta\" -> Kronecker\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 360\n\n/// World-space clip; curves clamp to this so asymptotes run off-screen cleanly.\nconst y_clip = 480.0\n\n/// Math-y limit matching y_clip (world_half / x_math_max = 90).\nconst y_math_lim = 5.3\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel), dots: List(RenderDot))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// Most plots use f(x − b). The line is y = mx − b. Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10). Power uses base a (2…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n  m: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    Kronecker -> {\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(\n        list.append(axis_strokes, kronecker_stem(b_f)),\n        labels,\n        kronecker_dots(b_f),\n      ))\n    }\n    f -> {\n      let a_f = case f {\n        Power -> int.to_float(int.clamp(a, 2, 10))\n        _ -> int.to_float(int.clamp(a, -5, 5))\n      }\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let m_f = int.to_float(int.clamp(m, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f, m_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      let dots = case f {\n        Step -> step_dots(b_f)\n        Signum -> signum_dots(b_f)\n        _ -> []\n      }\n      Ok(Plot(list.append(axis_strokes, curve), labels, dots))\n    }\n  }\n}\n\nfn world_y(y_math: Float) -> Float {\n  0.0 -. math_to_world_x(y_math)\n}\n\n/// Lollipop stick: vertical segment from (b, 0) to (b, 1).\nfn kronecker_stem(b: Float) -> List(Path) {\n  let wx = math_to_world_x(b)\n  [\n    Path(\n      Line(Point(wx, world_y(0.0)), Point(wx, world_y(1.0))),\n      12.0,\n      28.0,\n      4.0,\n    ),\n  ]\n}\n\n/// Dot on top of the lollipop at y = 1 (the Kronecker mass at x = b).\nfn kronecker_dots(b: Float) -> List(RenderDot) {\n  [\n    RenderDot(\n      math_to_world_x(b),\n      world_y(1.0),\n      12.0,\n      \"#58C4DD\",\n      True,\n      24.0,\n      32.0,\n    ),\n  ]\n}\n\n/// Step at x = b: open circle at the left limit (0), filled at the value H(0)=1.\nfn step_dots(b: Float) -> List(RenderDot) {\n  let wx = math_to_world_x(b)\n  let color = \"#58C4DD\"\n  [\n    // Left-hand limit y → 0 (not attained if right-continuous).\n    RenderDot(wx, world_y(0.0), 11.0, color, False, 20.0, 28.0),\n    // Value at the jump: H(0) = 1.\n    RenderDot(wx, world_y(1.0), 11.0, color, True, 20.0, 28.0),\n  ]\n}\n\n/// Signum at x = b: open at ±1 (side limits), filled at sgn(0) = 0.\nfn signum_dots(b: Float) -> List(RenderDot) {\n  let wx = math_to_world_x(b)\n  let color = \"#58C4DD\"\n  [\n    RenderDot(wx, world_y(-1.0), 11.0, color, False, 20.0, 28.0),\n    RenderDot(wx, world_y(0.0), 11.0, color, True, 20.0, 28.0),\n    RenderDot(wx, world_y(1.0), 11.0, color, False, 20.0, 28.0),\n  ]\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\n/// Sampling mark: a drawable point, or an explicit break (domain gap / asymptote).\ntype Mark {\n  Pt(Point)\n  Break\n}\n\nfn sample_curve(\n  f: MathFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> List(Path) {\n  let marks =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      let x_math = x_math_min +. t *. { x_math_max -. x_math_min }\n      case eval(f, x_math, a, omega, b, m) {\n        Error(Nil) -> [Break]\n        Ok(y_math) -> {\n          let clipped = float.absolute_value(y_math) >. y_math_lim\n          let y2 = float.clamp(y_math, min: 0.0 -. y_math_lim, max: y_math_lim)\n          let #(wx, wy) = to_world(x_math, y2)\n          case clipped {\n            // Run the curve out to the viewport edge, then break so the other\n            // side of an asymptote starts a fresh stroke.\n            True -> [Pt(Point(wx, wy)), Break]\n            False -> [Pt(Point(wx, wy))]\n          }\n        }\n      }\n    })\n    |> list.flatten\n\n  paths_from_marks(marks, 12.0, 36.0, 3.0)\n}\n\nfn eval(\n  f: MathFn,\n  x: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> Result(Float, Nil) {\n  let u = x -. b\n  case f {\n    // Line through slope-intercept form y = mx − b (b from the shift slider).\n    Identity -> Ok(m *. x -. b)\n    Square -> Ok(u *. u)\n    Cube -> Ok(u *. u *. u)\n    Absolute -> Ok(float.absolute_value(u))\n    Signum ->\n      case u <. 0.0 {\n        True -> Ok(-1.0)\n        False ->\n          case u >. 0.0 {\n            True -> Ok(1.0)\n            False -> Ok(0.0)\n          }\n      }\n    ScaledSine -> Ok(a *. js_sin(omega *. u))\n    ScaledCosine -> Ok(a *. js_cos(omega *. u))\n    Tangent -> {\n      let c = js_cos(u)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(u))\n      }\n    }\n    ArcSine ->\n      case float.absolute_value(u) >. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_asin(u))\n      }\n    ArcCosine ->\n      case float.absolute_value(u) >. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_acos(u))\n      }\n    ArcTangent -> Ok(js_atan(u))\n    ArcSecant ->\n      case float.absolute_value(u) <. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_acos(1.0 /. u))\n      }\n    ArcCosecant ->\n      case float.absolute_value(u) <. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_asin(1.0 /. u))\n      }\n    // Principal value in (0, π): arccot(x) = atan(1/x) adjusted for x < 0.\n    ArcCotangent ->\n      case u >. 0.0 {\n        True -> Ok(js_atan(1.0 /. u))\n        False ->\n          case u <. 0.0 {\n            True -> Ok(js_atan(1.0 /. u) +. 3.141592653589793)\n            False -> Ok(1.5707963267948966)\n          }\n      }\n    Exp -> {\n      let y = float.exponential(u)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Power -> {\n      use y <- result.try(float.power(a, u))\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(u)\n    Sqrt -> float.square_root(u)\n    Reciprocal ->\n      case float.absolute_value(u) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. u)\n      }\n    // Heaviside, right-continuous: H(u)=0 for u<0, H(0)=1, H(u)=1 for u>0.\n    // Markers at x=b show the open/filled circles for the jump.\n    Step ->\n      case u <. 0.0 {\n        True -> Ok(0.0)\n        False -> Ok(1.0)\n      }\n    // Drawn as a lollipop via special geometry; sampling unused.\n    Kronecker -> Ok(0.0)\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":14815,"new_hash":"388fd89891f6b8041a805488908b1d98c840a36dca5cfba78bc8e4d9d4591991","old_hash":"f6b066478febef0a46c5c483a0cb0165fb5b7e040f75a78c2687f88529005dae","operation":"modify","path":"src/math.gleam"},"hash":"69e960a62cce5b2f1cd5d80228fc61f73729281dcdaea4a4668aff95db3578cd","kind":"fs.external_change","prev_hash":"4a91c62e121972dbc840187632fab5168f8042bb6bab8212f5d6e4c4ceab728a","seq":336,"t":5193930,"wall":"2026-11-25T22:31:35.191Z"}
{"data":{"diff_size":84,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport render.{type RenderDot, type RenderLabel, RenderDot, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"asin\")\nfn js_asin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"acos\")\nfn js_acos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan\")\nfn js_atan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Absolute\n  Signum\n  ScaledSine\n  ScaledCosine\n  Tangent\n  ArcSine\n  ArcCosine\n  ArcTangent\n  ArcSecant\n  ArcCosecant\n  ArcCotangent\n  Exp\n  /// Exponential with adjustable base: y = aˣ (a from the base slider).\n  Power\n  Ln\n  Sqrt\n  Reciprocal\n  /// Unit step (Heaviside): 0 for x < b, 1 for x ≥ b.\n  Step\n  /// Discrete-style impulse at x = b (Kronecker / δ spike on the plot).\n  Kronecker\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// True when the base slider a applies (y = aˣ).\npub fn uses_base_param(f: MathFn) -> Bool {\n  case f {\n    Power -> True\n    _ -> False\n  }\n}\n\n/// True when the slope slider m applies (line y = mx − b).\npub fn uses_slope(f: MathFn) -> Bool {\n  case f {\n    Identity -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Absolute -> \"y=abs(x)\"\n    Signum -> \"y=sgn(x)\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    ArcSine -> \"y=arcsin(x)\"\n    ArcCosine -> \"y=arccos(x)\"\n    ArcTangent -> \"y=arctan(x)\"\n    ArcSecant -> \"y=arcsec(x)\"\n    ArcCosecant -> \"y=arccsc(x)\"\n    ArcCotangent -> \"y=arccot(x)\"\n    Exp -> \"y=exp(x)\"\n    Power -> \"y=a^x\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    Step -> \"y=step\"\n    Kronecker -> \"y=delta\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = mx\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Absolute -> \"y = |x|\"\n    Signum -> \"y = sgn(x)\"\n    ScaledSine -> \"y = a·sin(ωx)\"\n    ScaledCosine -> \"y = a·cos(ωx)\"\n    Tangent -> \"y = tan(x)\"\n    ArcSine -> \"y = arcsin(x)\"\n    ArcCosine -> \"y = arccos(x)\"\n    ArcTangent -> \"y = arctan(x)\"\n    ArcSecant -> \"y = arcsec(x)\"\n    ArcCosecant -> \"y = arccsc(x)\"\n    ArcCotangent -> \"y = arccot(x)\"\n    Exp -> \"y = exp(x)\"\n    Power -> \"y = aˣ\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    Step -> \"y = u(x)  (step / Heaviside)\"\n    Kronecker -> \"y = δ(x)  (Kronecker spike)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Absolute,\n    Signum,\n    Step,\n    Kronecker,\n    Tangent,\n    ArcSine,\n    ArcCosine,\n    ArcTangent,\n    ArcSecant,\n    ArcCosecant,\n    ArcCotangent,\n    Exp,\n    Power,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=abs(x)\" -> Absolute\n    \"y=sgn(x)\" -> Signum\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=arcsin(x)\" -> ArcSine\n    \"y=arccos(x)\" -> ArcCosine\n    \"y=arctan(x)\" -> ArcTangent\n    \"y=arcsec(x)\" -> ArcSecant\n    \"y=arccsc(x)\" -> ArcCosecant\n    \"y=arccot(x)\" -> ArcCotangent\n    \"y=exp(x)\" -> Exp\n    \"y=a^x\" -> Power\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=step\" -> Step\n    \"y=delta\" -> Kronecker\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 360\n\n/// World-space clip; curves clamp to this so asymptotes run off-screen cleanly.\nconst y_clip = 480.0\n\n/// Math-y limit matching y_clip (world_half / x_math_max = 90).\nconst y_math_lim = 5.3\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel), dots: List(RenderDot))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// Most plots use f(x − b). The line is y = mx − b. Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10). Power uses base a (2…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n  m: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    Kronecker -> {\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(\n        list.append(axis_strokes, kronecker_stem(b_f)),\n        labels,\n        kronecker_dots(b_f),\n      ))\n    }\n    f -> {\n      let a_f = case f {\n        Power -> int.to_float(int.clamp(a, 2, 10))\n        _ -> int.to_float(int.clamp(a, -5, 5))\n      }\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let m_f = int.to_float(int.clamp(m, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f, m_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      let dots = case f {\n        Step -> step_dots(b_f)\n        Signum -> signum_dots(b_f)\n        _ -> []\n      }\n      Ok(Plot(list.append(axis_strokes, curve), labels, dots))\n    }\n  }\n}\n\nfn world_y(y_math: Float) -> Float {\n  0.0 -. math_to_world_x(y_math)\n}\n\n/// Lollipop stick: vertical segment from (b, 0) to (b, 1).\nfn kronecker_stem(b: Float) -> List(Path) {\n  let wx = math_to_world_x(b)\n  [\n    Path(\n      Line(Point(wx, world_y(0.0)), Point(wx, world_y(1.0))),\n      12.0,\n      28.0,\n      4.0,\n    ),\n  ]\n}\n\n/// Dot on top of the lollipop at y = 1 (the Kronecker mass at x = b).\nfn kronecker_dots(b: Float) -> List(RenderDot) {\n  [\n    RenderDot(\n      math_to_world_x(b),\n      world_y(1.0),\n      12.0,\n      \"#58C4DD\",\n      True,\n      24.0,\n      32.0,\n    ),\n  ]\n}\n\n/// Step at x = b: open circle at the left limit (0), filled at the value H(0)=1.\nfn step_dots(b: Float) -> List(RenderDot) {\n  let wx = math_to_world_x(b)\n  let color = \"#58C4DD\"\n  [\n    // Left-hand limit y → 0 (not attained if right-continuous).\n    RenderDot(wx, world_y(0.0), 11.0, color, False, 20.0, 28.0),\n    // Value at the jump: H(0) = 1.\n    RenderDot(wx, world_y(1.0), 11.0, color, True, 20.0, 28.0),\n  ]\n}\n\n/// Signum at x = b: open at ±1 (side limits), filled at sgn(0) = 0.\nfn signum_dots(b: Float) -> List(RenderDot) {\n  let wx = math_to_world_x(b)\n  let color = \"#58C4DD\"\n  [\n    RenderDot(wx, world_y(-1.0), 11.0, color, False, 20.0, 28.0),\n    RenderDot(wx, world_y(0.0), 11.0, color, True, 20.0, 28.0),\n    RenderDot(wx, world_y(1.0), 11.0, color, False, 20.0, 28.0),\n  ]\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\n/// Sampling mark: a drawable point, or an explicit break (domain gap / asymptote).\ntype Mark {\n  Pt(Point)\n  Break\n}\n\nfn sample_curve(\n  f: MathFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> List(Path) {\n  let marks =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      let x_math = x_math_min +. t *. { x_math_max -. x_math_min }\n      case eval(f, x_math, a, omega, b, m) {\n        Error(Nil) -> [Break]\n        Ok(y_math) -> {\n          let clipped = float.absolute_value(y_math) >. y_math_lim\n          let y2 = float.clamp(y_math, min: 0.0 -. y_math_lim, max: y_math_lim)\n          let #(wx, wy) = to_world(x_math, y2)\n          case clipped {\n            // Run the curve out to the viewport edge, then break so the other\n            // side of an asymptote starts a fresh stroke.\n            True -> [Pt(Point(wx, wy)), Break]\n            False -> [Pt(Point(wx, wy))]\n          }\n        }\n      }\n    })\n    |> list.flatten\n\n  paths_from_marks(marks, 12.0, 36.0, 3.0)\n}\n\nfn eval(\n  f: MathFn,\n  x: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> Result(Float, Nil) {\n  // Horizontal shift: every real preset uses u = x − b (line is y = m·u).\n  let u = x -. b\n  case f {\n    Identity -> Ok(m *. u)\n    Square -> Ok(u *. u)\n    Cube -> Ok(u *. u *. u)\n    Absolute -> Ok(float.absolute_value(u))\n    Signum ->\n      case u <. 0.0 {\n        True -> Ok(-1.0)\n        False ->\n          case u >. 0.0 {\n            True -> Ok(1.0)\n            False -> Ok(0.0)\n          }\n      }\n    ScaledSine -> Ok(a *. js_sin(omega *. u))\n    ScaledCosine -> Ok(a *. js_cos(omega *. u))\n    Tangent -> {\n      let c = js_cos(u)\n      // Gap only at the asymptote itself; large |tan| is clamped in the sampler.\n      case float.absolute_value(c) <. 0.012 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(u))\n      }\n    }\n    ArcSine ->\n      case float.absolute_value(u) >. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_asin(u))\n      }\n    ArcCosine ->\n      case float.absolute_value(u) >. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_acos(u))\n      }\n    ArcTangent -> Ok(js_atan(u))\n    ArcSecant ->\n      case float.absolute_value(u) <. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_acos(1.0 /. u))\n      }\n    ArcCosecant ->\n      case float.absolute_value(u) <. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_asin(1.0 /. u))\n      }\n    // Principal value in (0, π): arccot(x) = atan(1/x) adjusted for x < 0.\n    ArcCotangent ->\n      case u >. 0.0 {\n        True -> Ok(js_atan(1.0 /. u))\n        False ->\n          case u <. 0.0 {\n            True -> Ok(js_atan(1.0 /. u) +. 3.141592653589793)\n            False -> Ok(1.5707963267948966)\n          }\n      }\n    // Let the sampler clamp runaway growth so the curve reaches the edge.\n    Exp -> Ok(float.exponential(u))\n    Power -> float.power(a, u)\n    Ln ->\n      case u <=. 0.0 {\n        True -> Error(Nil)\n        False -> float.logarithm(u)\n      }\n    Sqrt ->\n      case u <. 0.0 {\n        True -> Error(Nil)\n        False -> float.square_root(u)\n      }\n    Reciprocal ->\n      case float.absolute_value(u) <. 0.008 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. u)\n      }\n    // Heaviside, right-continuous: H(u)=0 for u<0, H(0)=1, H(u)=1 for u>0.\n    // Markers at x=b show the open/filled circles for the jump.\n    Step ->\n      case u <. 0.0 {\n        True -> Ok(0.0)\n        False -> Ok(1.0)\n      }\n    // Drawn as a lollipop via special geometry; sampling unused.\n    Kronecker -> Ok(0.0)\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":14900,"new_hash":"ba153a1de55e7e82b41c56a82696883da34b3927ac84335c88386ed544769d8c","old_hash":"388fd89891f6b8041a805488908b1d98c840a36dca5cfba78bc8e4d9d4591991","operation":"modify","path":"src/math.gleam"},"hash":"e4ba4dce5cfa74d09e2d9334f099ff1bf3b752e8dafa7acdbb9226080eea8a36","kind":"fs.external_change","prev_hash":"69e960a62cce5b2f1cd5d80228fc61f73729281dcdaea4a4668aff95db3578cd","seq":337,"t":5203854,"wall":"2026-11-25T22:31:45.115Z"}
{"data":{"diff_size":904,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport render.{type RenderDot, type RenderLabel, RenderDot, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"asin\")\nfn js_asin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"acos\")\nfn js_acos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan\")\nfn js_atan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Absolute\n  Signum\n  ScaledSine\n  ScaledCosine\n  Tangent\n  ArcSine\n  ArcCosine\n  ArcTangent\n  ArcSecant\n  ArcCosecant\n  ArcCotangent\n  Exp\n  /// Exponential with adjustable base: y = aˣ (a from the base slider).\n  Power\n  Ln\n  Sqrt\n  Reciprocal\n  /// Unit step (Heaviside): 0 for x < b, 1 for x ≥ b.\n  Step\n  /// Discrete-style impulse at x = b (Kronecker / δ spike on the plot).\n  Kronecker\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// True when the base slider a applies (y = aˣ).\npub fn uses_base_param(f: MathFn) -> Bool {\n  case f {\n    Power -> True\n    _ -> False\n  }\n}\n\n/// True when the slope slider m applies (line y = mx − b).\npub fn uses_slope(f: MathFn) -> Bool {\n  case f {\n    Identity -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Absolute -> \"y=abs(x)\"\n    Signum -> \"y=sgn(x)\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    ArcSine -> \"y=arcsin(x)\"\n    ArcCosine -> \"y=arccos(x)\"\n    ArcTangent -> \"y=arctan(x)\"\n    ArcSecant -> \"y=arcsec(x)\"\n    ArcCosecant -> \"y=arccsc(x)\"\n    ArcCotangent -> \"y=arccot(x)\"\n    Exp -> \"y=exp(x)\"\n    Power -> \"y=a^x\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    Step -> \"y=step\"\n    Kronecker -> \"y=delta\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = mx\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Absolute -> \"y = |x|\"\n    Signum -> \"y = sgn(x)\"\n    ScaledSine -> \"y = a·sin(ωx)\"\n    ScaledCosine -> \"y = a·cos(ωx)\"\n    Tangent -> \"y = tan(x)\"\n    ArcSine -> \"y = arcsin(x)\"\n    ArcCosine -> \"y = arccos(x)\"\n    ArcTangent -> \"y = arctan(x)\"\n    ArcSecant -> \"y = arcsec(x)\"\n    ArcCosecant -> \"y = arccsc(x)\"\n    ArcCotangent -> \"y = arccot(x)\"\n    Exp -> \"y = exp(x)\"\n    Power -> \"y = aˣ\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    Step -> \"y = u(x)  (step / Heaviside)\"\n    Kronecker -> \"y = δ(x)  (Kronecker spike)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Absolute,\n    Signum,\n    Step,\n    Kronecker,\n    Tangent,\n    ArcSine,\n    ArcCosine,\n    ArcTangent,\n    ArcSecant,\n    ArcCosecant,\n    ArcCotangent,\n    Exp,\n    Power,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=abs(x)\" -> Absolute\n    \"y=sgn(x)\" -> Signum\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=arcsin(x)\" -> ArcSine\n    \"y=arccos(x)\" -> ArcCosine\n    \"y=arctan(x)\" -> ArcTangent\n    \"y=arcsec(x)\" -> ArcSecant\n    \"y=arccsc(x)\" -> ArcCosecant\n    \"y=arccot(x)\" -> ArcCotangent\n    \"y=exp(x)\" -> Exp\n    \"y=a^x\" -> Power\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=step\" -> Step\n    \"y=delta\" -> Kronecker\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 360\n\n/// World-space clip; curves clamp to this so asymptotes run off-screen cleanly.\nconst y_clip = 480.0\n\n/// Math-y limit matching y_clip (world_half / x_math_max = 90).\nconst y_math_lim = 5.3\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel), dots: List(RenderDot))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// Most plots use f(x − b). The line is y = mx − b. Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10). Power uses base a (2…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n  m: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    Kronecker -> {\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(\n        list.append(axis_strokes, kronecker_stem(b_f)),\n        labels,\n        kronecker_dots(b_f),\n      ))\n    }\n    f -> {\n      let a_f = case f {\n        Power -> int.to_float(int.clamp(a, 2, 10))\n        _ -> int.to_float(int.clamp(a, -5, 5))\n      }\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let m_f = int.to_float(int.clamp(m, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f, m_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      let dots = case f {\n        Step -> step_dots(b_f)\n        Signum -> signum_dots(b_f)\n        _ -> []\n      }\n      Ok(Plot(list.append(axis_strokes, curve), labels, dots))\n    }\n  }\n}\n\nfn world_y(y_math: Float) -> Float {\n  0.0 -. math_to_world_x(y_math)\n}\n\n/// Lollipop stick: vertical segment from (b, 0) to (b, 1).\nfn kronecker_stem(b: Float) -> List(Path) {\n  let wx = math_to_world_x(b)\n  [\n    Path(\n      Line(Point(wx, world_y(0.0)), Point(wx, world_y(1.0))),\n      12.0,\n      28.0,\n      4.0,\n    ),\n  ]\n}\n\n/// Dot on top of the lollipop at y = 1 (the Kronecker mass at x = b).\nfn kronecker_dots(b: Float) -> List(RenderDot) {\n  [\n    RenderDot(\n      math_to_world_x(b),\n      world_y(1.0),\n      12.0,\n      \"#58C4DD\",\n      True,\n      24.0,\n      32.0,\n    ),\n  ]\n}\n\n/// Step at x = b: open circle at the left limit (0), filled at the value H(0)=1.\nfn step_dots(b: Float) -> List(RenderDot) {\n  let wx = math_to_world_x(b)\n  let color = \"#58C4DD\"\n  [\n    // Left-hand limit y → 0 (not attained if right-continuous).\n    RenderDot(wx, world_y(0.0), 11.0, color, False, 20.0, 28.0),\n    // Value at the jump: H(0) = 1.\n    RenderDot(wx, world_y(1.0), 11.0, color, True, 20.0, 28.0),\n  ]\n}\n\n/// Signum at x = b: open at ±1 (side limits), filled at sgn(0) = 0.\nfn signum_dots(b: Float) -> List(RenderDot) {\n  let wx = math_to_world_x(b)\n  let color = \"#58C4DD\"\n  [\n    RenderDot(wx, world_y(-1.0), 11.0, color, False, 20.0, 28.0),\n    RenderDot(wx, world_y(0.0), 11.0, color, True, 20.0, 28.0),\n    RenderDot(wx, world_y(1.0), 11.0, color, False, 20.0, 28.0),\n  ]\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\n/// Sampling mark: a drawable point, or an explicit break (domain gap / asymptote).\ntype Mark {\n  Pt(Point)\n  Break\n}\n\nfn sample_curve(\n  f: MathFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> List(Path) {\n  let marks =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      let x_math = x_math_min +. t *. { x_math_max -. x_math_min }\n      case eval(f, x_math, a, omega, b, m) {\n        Error(Nil) -> [Break]\n        Ok(y_math) -> {\n          let clipped = float.absolute_value(y_math) >. y_math_lim\n          let y2 = float.clamp(y_math, min: 0.0 -. y_math_lim, max: y_math_lim)\n          let #(wx, wy) = to_world(x_math, y2)\n          case clipped {\n            // Run the curve out to the viewport edge, then break so the other\n            // side of an asymptote starts a fresh stroke.\n            True -> [Pt(Point(wx, wy)), Break]\n            False -> [Pt(Point(wx, wy))]\n          }\n        }\n      }\n    })\n    |> list.flatten\n\n  paths_from_marks(marks, 12.0, 36.0, 3.0)\n}\n\nfn eval(\n  f: MathFn,\n  x: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> Result(Float, Nil) {\n  // Horizontal shift: every real preset uses u = x − b (line is y = m·u).\n  let u = x -. b\n  case f {\n    Identity -> Ok(m *. u)\n    Square -> Ok(u *. u)\n    Cube -> Ok(u *. u *. u)\n    Absolute -> Ok(float.absolute_value(u))\n    Signum ->\n      case u <. 0.0 {\n        True -> Ok(-1.0)\n        False ->\n          case u >. 0.0 {\n            True -> Ok(1.0)\n            False -> Ok(0.0)\n          }\n      }\n    ScaledSine -> Ok(a *. js_sin(omega *. u))\n    ScaledCosine -> Ok(a *. js_cos(omega *. u))\n    Tangent -> {\n      let c = js_cos(u)\n      // Gap only at the asymptote itself; large |tan| is clamped in the sampler.\n      case float.absolute_value(c) <. 0.012 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(u))\n      }\n    }\n    ArcSine ->\n      case float.absolute_value(u) >. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_asin(u))\n      }\n    ArcCosine ->\n      case float.absolute_value(u) >. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_acos(u))\n      }\n    ArcTangent -> Ok(js_atan(u))\n    ArcSecant ->\n      case float.absolute_value(u) <. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_acos(1.0 /. u))\n      }\n    ArcCosecant ->\n      case float.absolute_value(u) <. 1.0 {\n        True -> Error(Nil)\n        False -> Ok(js_asin(1.0 /. u))\n      }\n    // Principal value in (0, π): arccot(x) = atan(1/x) adjusted for x < 0.\n    ArcCotangent ->\n      case u >. 0.0 {\n        True -> Ok(js_atan(1.0 /. u))\n        False ->\n          case u <. 0.0 {\n            True -> Ok(js_atan(1.0 /. u) +. 3.141592653589793)\n            False -> Ok(1.5707963267948966)\n          }\n      }\n    // Let the sampler clamp runaway growth so the curve reaches the edge.\n    Exp -> Ok(float.exponential(u))\n    Power -> float.power(a, u)\n    Ln ->\n      case u <=. 0.0 {\n        True -> Error(Nil)\n        False -> float.logarithm(u)\n      }\n    Sqrt ->\n      case u <. 0.0 {\n        True -> Error(Nil)\n        False -> float.square_root(u)\n      }\n    Reciprocal ->\n      case float.absolute_value(u) <. 0.008 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. u)\n      }\n    // Heaviside, right-continuous: H(u)=0 for u<0, H(0)=1, H(u)=1 for u>0.\n    // Markers at x=b show the open/filled circles for the jump.\n    Step ->\n      case u <. 0.0 {\n        True -> Ok(0.0)\n        False -> Ok(1.0)\n      }\n    // Drawn as a lollipop via special geometry; sampling unused.\n    Kronecker -> Ok(0.0)\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn paths_from_marks(\n  marks: List(Mark),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  let runs = split_runs(marks, [], [])\n  let n_runs = list.length(runs)\n  let n_f = int.to_float(int.max(n_runs, 1))\n  list.index_map(runs, fn(run, ri) {\n    let t0 = start_base +. int.to_float(ri) /. n_f *. duration\n    let t1 = start_base +. int.to_float(ri + 1) /. n_f *. duration\n    stroke_run(run, t0, t1, thickness)\n  })\n  |> list.flatten\n}\n\nfn split_runs(\n  marks: List(Mark),\n  current: List(Point),\n  acc: List(List(Point)),\n) -> List(List(Point)) {\n  case marks {\n    [] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      list.reverse(acc)\n    }\n    [Break, ..rest] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      split_runs(rest, [], acc)\n    }\n    [Pt(p), ..rest] -> split_runs(rest, [p, ..current], acc)\n  }\n}\n\nfn stroke_run(\n  points: List(Point),\n  t0: Float,\n  t1: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      let span = t1 -. t0\n      do_stroke(a, [b, ..rest], 0, n_f, t0, span, thickness, [])\n    }\n  }\n}\n\nfn do_stroke(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  t0: Float,\n  span: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      // Safety break for any residual huge jump.\n      let acc = case dx +. dy >. 120.0 {\n        True -> acc\n        False -> {\n          let s0 = t0 +. int.to_float(i) /. n_f *. span\n          let s1 = t0 +. int.to_float(i + 1) /. n_f *. span\n          [Path(Line(prev, next), s0, s1, thickness), ..acc]\n        }\n      }\n      do_stroke(next, tail, i + 1, n_f, t0, span, thickness, acc)\n    }\n  }\n}\n","new_content_size":15804,"new_hash":"689d4f36205f03f4916d37be47f18a203bb954f87e74abc2acf05cc872e05012","old_hash":"ba153a1de55e7e82b41c56a82696883da34b3927ac84335c88386ed544769d8c","operation":"modify","path":"src/math.gleam"},"hash":"fff071e41ad5db9f0dfef90b5507da276e0e6cb4eeebc4050983d81eaf19db0d","kind":"fs.external_change","prev_hash":"e4ba4dce5cfa74d09e2d9334f099ff1bf3b752e8dafa7acdbb9226080eea8a36","seq":338,"t":5213360,"wall":"2026-11-25T22:31:54.621Z"}
