{"data":{"content":"    ToggleLoop -> {\n      let looping = !model.looping\n      #(Model(..model, looping: looping), apply_loop(looping))\n    }\n\n","length":125,"path":"src\\app.gleam","range":{"end":{"character":0,"line":563},"start":{"character":0,"line":563}},"sha256":"9aaf480a3e19c12bd8bd1b7143412aea704dde81d2ab7d7f96792453f7ec130a"},"hash":"b2f9921a3b56aaeefcc2db8caa738011ebdc67a30b32ed8336e6049d2a63654d","kind":"paste","prev_hash":"7fc6a220854eb2bdff76c02b1083d665969e0bac6ae1f9558a5226545cf1929a","seq":499,"t":8126553,"wall":"2026-11-25T23:20:27.814Z"}
