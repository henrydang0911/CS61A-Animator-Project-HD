{"data":{"diff_size":194,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    ScaledSine -> \"y = a·sin(ωx)\"\n    ScaledCosine -> \"y = a·cos(ωx)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// `shape_slider` (0–100) scales amplitude for ScaledSine as a ∈ [0.25, 2.5].\npub fn plot(f: MathFn, shape_slider: Int) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let amplitude = amplitude(shape_slider)\n      let curve = sample_curve(f, amplitude)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn amplitude(shape_slider: Int) -> Float {\n  0.25 +. int.to_float(int.clamp(shape_slider, 0, 100)) /. 100.0 *. 2.25\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(f: MathFn, amplitude: Float) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, amplitude) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    Sine -> Ok(js_sin(x))\n    Cosine -> Ok(js_cos(x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ScaledSine -> Ok(a *. js_sin(x))\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":8524,"new_hash":"95df527457860df26681ede5836c9f5c170c01c65bec75ae15a867315693a8ba","old_hash":"9f46f8926f20b129e960584460b122baf068ae3c34cef5c43f640d94b7ca17d2","operation":"modify","path":"src/math.gleam"},"hash":"f3f1ea0bc195966b9feb69c17a981f1f65327c2da893382afa245d42d91c0585","kind":"fs.external_change","prev_hash":"494e6b2cd2b6f7b9c6e869e3713d32aa0a8cfbef4a872c24d8bae0192a2476ce","seq":125,"t":2513857,"wall":"2026-11-25T21:47:02.728Z"}
{"data":{"diff_size":53,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    ScaledSine -> \"y = a·sin(ωx)\"\n    ScaledCosine -> \"y = a·cos(ωx)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// For waves, `a` is amplitude (−5…5) and `omega` is angular frequency (≥1).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let curve = sample_curve(f, a_f, w_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(f: MathFn, amplitude: Float) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, amplitude) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    Sine -> Ok(js_sin(x))\n    Cosine -> Ok(js_cos(x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ScaledSine -> Ok(a *. js_sin(x))\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":8473,"new_hash":"23e9057dffa9e8b52e567fba44405a690feaf956b406bc42ea22136c12b00914","old_hash":"95df527457860df26681ede5836c9f5c170c01c65bec75ae15a867315693a8ba","operation":"modify","path":"src/math.gleam"},"hash":"97aab0ea92d54a39a69f75fb132c141e80e893a50b9590c7d5955f11802f6e6c","kind":"fs.external_change","prev_hash":"f3f1ea0bc195966b9feb69c17a981f1f65327c2da893382afa245d42d91c0585","seq":126,"t":2516776,"wall":"2026-11-25T21:47:05.647Z"}
{"data":{"active_file":"src/app.gleam","focused":true,"idle_since_ms":295752.12600000016},"hash":"83c177ad3ea26f3940e7398c7a1cd52e52cc2e5e49880289f4993ee238ed4dae","kind":"session.heartbeat","prev_hash":"97aab0ea92d54a39a69f75fb132c141e80e893a50b9590c7d5955f11802f6e6c","seq":127,"t":2520570,"wall":"2026-11-25T21:47:09.441Z"}
{"data":{"diff_size":22,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    ScaledSine -> \"y = a·sin(ωx)\"\n    ScaledCosine -> \"y = a·cos(ωx)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// For waves, `a` is amplitude (−5…5) and `omega` is angular frequency (≥1).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let curve = sample_curve(f, a_f, w_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(f: MathFn, a: Float, omega: Float) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, a, omega) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float, omega: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    ScaledSine -> Ok(a *. js_sin(omega *. x))\n    ScaledCosine -> Ok(a *. js_cos(omega *. x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":8495,"new_hash":"4f89c4c020b21458068c8a39861ce184fa0beb8518b3e64901eebdfefe7e8cfa","old_hash":"23e9057dffa9e8b52e567fba44405a690feaf956b406bc42ea22136c12b00914","operation":"modify","path":"src/math.gleam"},"hash":"252aca960be7b5b8b67cb241997e1f34c3aff6172b3b08fc2745306ec96ead5c","kind":"fs.external_change","prev_hash":"83c177ad3ea26f3940e7398c7a1cd52e52cc2e5e49880289f4993ee238ed4dae","seq":128,"t":2524123,"wall":"2026-11-25T21:47:12.994Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":91},"start":{"character":0,"line":73}},"text":"    shape_slider: Int,\n    // Animation speed as a percent of normal: 100 = 1×,\n    // negatives play backward (−500 = −5× … 500 = 5×).\n    speed_percent: Int,\n    // When True, the clock is frozen (rate 0) until Play.\n    paused: Bool,\n    // Draw = user Gleam draw(); Math = preset y = f(x) plots.\n    mode: AppMode,\n    math_fn: MathFn,\n    // Amplitude a for y = a·sin(ωx) / a·cos(ωx), range −5…5 (default 1 → sin/cos).\n    math_amp: Int,\n    // Angular frequency ω for those waves, range 1…10 (default 1).\n    math_omega: Int,\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  SelectDrawing(String)\n  SetMode(AppMode)\n  SetMathFn(MathFn)\n  SetMathAmp(Int)\n  SetMathOmega(Int)\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"d93077f3cdfce853f69b1d9487cbb1c2557eee65357a1eb587588cf4f629c7e9","kind":"doc.change","prev_hash":"252aca960be7b5b8b67cb241997e1f34c3aff6172b3b08fc2745306ec96ead5c","seq":129,"t":2529985,"wall":"2026-11-25T21:47:18.856Z"}
