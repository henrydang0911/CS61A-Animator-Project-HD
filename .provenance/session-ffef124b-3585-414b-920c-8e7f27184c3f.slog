{"data":{"deltas":[{"range":{"end":{"character":0,"line":216},"start":{"character":0,"line":212}},"text":"/// How to color math paths; optional clock-driven tangent arrow for e^{iθ}.\npub type MathStyle {\n  RealStyle\n  ComplexStyle(horizontal_count: Int, sweep: Option(SweepArrow))\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"dd2ab7345c710c631d58565ec29b0a7c7e680240234ee36fc03305cbe2f93818","kind":"doc.change","prev_hash":"eaec6e2707fe4c048afa16277e4edc5f84b2ee52464df00ccf2979f0eda5170b","seq":418,"t":6231821,"wall":"2026-11-25T22:48:53.082Z"}
