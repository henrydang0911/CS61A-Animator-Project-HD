{"data":{"diff_size":222,"new_content":"// Host-side math used by Math mode sampling (gleam/float has no trig).\n\nexport function sin(x) {\n  return Math.sin(x);\n}\n\nexport function cos(x) {\n  return Math.cos(x);\n}\n\nexport function tan(x) {\n  return Math.tan(x);\n}\n","new_content_size":222,"new_hash":"9d139c07384052f3a3cf9ab5b79ab7b623ab620d969b18f983621ac178c72498","old_hash":"","operation":"create","path":"src/math_ffi.mjs"},"hash":"fc8dd5dd93e7f39a0b6b9d2f932465f6b9e4b9ddd0566aa5a32cc8f9c5ec9049","kind":"fs.external_change","prev_hash":"1f7e12381838cd5b3633ab2672552687efc7bca0da7fbea1115b0087e3f78010","seq":83,"t":1967497,"wall":"2026-11-25T21:37:56.367Z"}
{"data":{"active_file":"src/app.gleam","focused":true,"idle_since_ms":894400.5619000001},"hash":"c910ca55dd435a92999844f9cb4ba7632d7e73e027a5cc0aba1de8725c2f3610","kind":"session.heartbeat","prev_hash":"fc8dd5dd93e7f39a0b6b9d2f932465f6b9e4b9ddd0566aa5a32cc8f9c5ec9049","seq":84,"t":1980438,"wall":"2026-11-25T21:38:09.309Z"}
{"data":{"diff_size":6240,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport shape.{type Path, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Sine\n  Cosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  ScaledSine\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Sine -> \"y=sin(x)\"\n    Cosine -> \"y=cos(x)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ScaledSine -> \"y=a*sin(x)\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Sine -> \"y = sin(x)\"\n    Cosine -> \"y = cos(x)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ScaledSine -> \"y = a·sin(x)  (a from shape slider)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Sine,\n    Cosine,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ScaledSine,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=sin(x)\" -> Sine\n    \"y=cos(x)\" -> Cosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=a*sin(x)\" -> ScaledSine\n    \"3d\" -> ThreeDUnsupported\n    _ -> Sine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\n/// Build axes + curve Paths for Manim-style reveal. `shape_slider` (0–100)\n/// scales amplitude for ScaledSine as a ∈ [0.25, 2.5].\npub fn plot(f: MathFn, shape_slider: Int) -> Result(List(Path), MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let amplitude = amplitude(shape_slider)\n      let curve = sample_curve(f, amplitude)\n      let axes = axis_paths()\n      Ok(list.append(axes, curve))\n    }\n  }\n}\n\nfn amplitude(shape_slider: Int) -> Float {\n  0.25 +. int.to_float(int.clamp(shape_slider, 0, 100)) /. 100.0 *. 2.25\n}\n\nfn axis_paths() -> List(Path) {\n  let axis_t = 2.0\n  [\n    // x-axis draws first\n    Path(Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)), 0.0, 8.0, axis_t),\n    // y-axis\n    Path(Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)), 4.0, 12.0, axis_t),\n  ]\n}\n\nfn sample_curve(f: MathFn, amplitude: Float) -> List(Path) {\n  let xs =\n    list.range(0, sample_count)\n    |> list.map(fn(i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, amplitude) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    Sine -> Ok(js_sin(x))\n    Cosine -> Ok(js_cos(x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ScaledSine -> Ok(a *. js_sin(x))\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":6257,"new_hash":"b751dd96c900334c6a65a81115c346383187ef92efc642a08c736cb8138be612","old_hash":"","operation":"create","path":"src/math.gleam"},"hash":"dd36e1f3cc10dbb05444ce533d0d07f22618aa7d4e53ba8311c3656ff675adc9","kind":"fs.external_change","prev_hash":"c910ca55dd435a92999844f9cb4ba7632d7e73e027a5cc0aba1de8725c2f3610","seq":85,"t":1982552,"wall":"2026-11-25T21:38:11.423Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":19},"start":{"character":0,"line":19}},"text":"import math.{type MathFn}\n"}],"path":"src\\app.gleam","source":"typed"},"hash":"c0fee2c1d1d931861e20b2e59bb7225cc084b1cd34a3fca17068fdc9b35efd66","kind":"doc.change","prev_hash":"dd36e1f3cc10dbb05444ce533d0d07f22618aa7d4e53ba8311c3656ff675adc9","seq":86,"t":1987703,"wall":"2026-11-25T21:38:16.573Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":79},"start":{"character":0,"line":50}},"text":"  MathError\n}\n\npub type AppError {\n  AppError(kind: ErrorKind, message: String)\n}\n\npub type AppMode {\n  DrawMode\n  MathMode\n}\n\npub type Model {\n  Model(\n    // Named drawings restored from / saved to localStorage.\n    library: Library,\n    // The code in the editor.\n    source: String,\n    // Whether the code editor is shown.\n    code_open: Bool,\n    // Shown as a small red popup while the drawing cannot run.\n    error: Option(AppError),\n    // Passed into draw(shape_slider); changes geometry only, never speed.\n    // In Math mode, also scales y = a·sin(x).\n    shape_slider: Int,\n    // Animation speed as a percent of normal: 100 = 1×,\n    // negatives play backward (−500 = −5× … 500 = 5×).\n    speed_percent: Int,\n    // When True, the clock is frozen (rate 0) until Play.\n    paused: Bool,\n    // Draw = user Gleam draw(); Math = preset y = f(x) plots.\n    mode: AppMode,\n    math_fn: MathFn,\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  SelectDrawing(String)\n  SetMode(AppMode)\n  SetMathFn(MathFn)\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"cbe4f11888991fe4919bcaad422c89f4a9f7e24a22f79f5c64c85dc79979f1c6","kind":"doc.change","prev_hash":"c0fee2c1d1d931861e20b2e59bb7225cc084b1cd34a3fca17068fdc9b35efd66","seq":87,"t":1990753,"wall":"2026-11-25T21:38:19.624Z"}
{"data":{"content":"      mode: DrawMode,\n      math_fn: math.Sine,\n","length":48,"path":"src\\app.gleam","range":{"end":{"character":0,"line":115},"start":{"character":0,"line":115}},"sha256":"4d33c2eb3b29b07f3e515611c7280ab8c2ff061b8c6485c2f5f19aa95d8fa252"},"hash":"f7094e287e8ac8b1cbed3d629d5d1abf22eb0ec2e5ca3a0e13d0be15762961ae","kind":"paste","prev_hash":"cbe4f11888991fe4919bcaad422c89f4a9f7e24a22f79f5c64c85dc79979f1c6","seq":88,"t":1991468,"wall":"2026-11-25T21:38:20.338Z"}
{"data":{"intercepted_count":0,"large_insert_count":2},"hash":"1e9ef92d6168ec35d6fed38b0cc9ed59d8f3831421583bd438672d3ffd1cb913","kind":"paste.anomaly","prev_hash":"f7094e287e8ac8b1cbed3d629d5d1abf22eb0ec2e5ca3a0e13d0be15762961ae","seq":89,"t":1992762,"wall":"2026-11-25T21:38:21.633Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":173},"start":{"character":0,"line":166}},"text":"    MathError -> \"Math\"\n  }\n}\n\nfn to_render_paths(paths: List(Path)) -> List(render.RenderPath) {\n  list.index_map(paths, fn(path, i) {\n    render.render_path(path, manim_color(i))\n  })\n}\n\n/// Axes in muted white, curve in Manim teal.\nfn math_render_paths(paths: List(Path)) -> List(render.RenderPath) {\n  list.index_map(paths, fn(path, i) {\n    let color = case i < 2 {\n      True -> \"#8a8aaa\"\n      False -> \"#58C4DD\"\n    }\n    render.render_path(path, color)\n  })\n}\n\nfn run_math(\n  math_fn: MathFn,\n  shape_slider: Int,\n) -> Result(List(Path), AppError) {\n  case math.plot(math_fn, shape_slider) {\n    Ok(paths) -> Ok(paths)\n    Error(err) -> Error(AppError(MathError, math.error_message(err)))\n  }\n}\n\nfn animate_math(\n  paths: List(Path),\n  speed_percent: Int,\n  paused: Bool,\n) -> Effect(Msg) {\n  let rendered = math_render_paths(paths)\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n    render.set_drawing(rendered)\n  })\n}\n\nfn update_math_drawing(paths: List(Path)) -> Effect(Msg) {\n  let rendered = math_render_paths(paths)\n  effect.from(fn(_) { render.set_drawing(rendered) })\n}\n\nfn refresh_math(model: Model, restart: Bool) -> #(Model, Effect(Msg)) {\n  case run_math(model.math_fn, model.shape_slider) {\n    Ok(paths) -> {\n      let effect = case restart {\n        True -> animate_math(paths, model.speed_percent, model.paused)\n        False -> update_math_drawing(paths)\n      }\n      #(Model(..model, error: None), effect)\n    }\n    Error(err) -> #(Model(..model, error: Some(err)), clear_drawing())\n  }\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"50b2ad2a24b9e39e78a3944c1eaa39ad03197e2c78a5b276c6d26ee8ee84a1de","kind":"doc.change","prev_hash":"1e9ef92d6168ec35d6fed38b0cc9ed59d8f3831421583bd438672d3ffd1cb913","seq":90,"t":1994680,"wall":"2026-11-25T21:38:23.551Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":342},"start":{"character":0,"line":314}},"text":"    SetMode(mode) -> {\n      let model = Model(..model, mode: mode, error: None)\n      case mode {\n        MathMode -> refresh_math(model, True)\n        DrawMode ->\n          case run_source(model.shape_slider, model.source) {\n            Ok(paths) -> #(\n              model,\n              effect.batch([\n                editor.mount(model.source, SetCode),\n                animate(paths, model.speed_percent, model.paused),\n              ]),\n            )\n            Error(err) -> #(\n              Model(..model, error: Some(err)),\n              effect.batch([\n                editor.mount(model.source, SetCode),\n                clear_drawing(),\n              ]),\n            )\n          }\n      }\n    }\n\n    SetMathFn(math_fn) -> refresh_math(Model(..model, math_fn: math_fn), True)\n\n    SelectDrawing(choice) -> {\n      // Picking a drawing always returns to Draw mode.\n      let model = Model(..model, mode: DrawMode)\n      case choice == data.new_drawing_option {\n        True -> {\n          let name = string.trim(data.prompt_drawing_name())\n          case name {\n            \"\" -> #(model, effect.none())\n            name -> {\n              let library = data.add(model.library, name, data.blank_source)\n              open_current(model, library)\n            }\n          }\n        }\n        False -> open_current(model, data.select(model.library, choice))\n      }\n    }\n\n    SetShape(value) -> {\n      let shape_slider = int.clamp(value, 0, 100)\n      let model = Model(..model, shape_slider: shape_slider)\n      case model.mode {\n        MathMode -> refresh_math(model, False)\n        DrawMode ->\n          case run_source(shape_slider, model.source) {\n            Ok(paths) -> #(\n              Model(..model, error: None),\n              // Geometry only — do not call set_speed or reset_clock.\n              update_drawing(paths),\n            )\n            Error(err) -> #(\n              Model(..model, error: Some(err)),\n              clear_drawing(),\n            )\n          }\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"62075aa73dc7b74c2c43c6360273e3eb1a3b6c596202f221c4e3ff9e65f47e70","kind":"doc.change","prev_hash":"50b2ad2a24b9e39e78a3944c1eaa39ad03197e2c78a5b276c6d26ee8ee84a1de","seq":91,"t":1998573,"wall":"2026-11-25T21:38:27.444Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":424},"start":{"character":0,"line":411}},"text":"    // report an error). Ignored while Math mode owns the canvas.\n    SetCode(text) -> {\n      let library = data.set_current_source(model.library, text)\n      data.save(library)\n      case model.mode {\n        MathMode -> #(\n          Model(..model, library: library, source: text),\n          effect.none(),\n        )\n        DrawMode ->\n          case run_source(model.shape_slider, text) {\n            Ok(paths) -> #(\n              Model(..model, library: library, error: None, source: text),\n              animate(paths, model.speed_percent, model.paused),\n            )\n            Error(err) -> #(\n              Model(..model, library: library, error: Some(err), source: text),\n              clear_drawing(),\n            )\n          }\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"db4de2b2677d883ece1f8e9c62c526c92c728dbc360de8c8aa9fc54bfd89a448","kind":"doc.change","prev_hash":"62075aa73dc7b74c2c43c6360273e3eb1a3b6c596202f221c4e3ff9e65f47e70","seq":92,"t":2000373,"wall":"2026-11-25T21:38:29.244Z"}
