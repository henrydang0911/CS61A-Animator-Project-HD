{"data":{"content":"        html.button(\n          [\n            attr.class(case model.looping {\n              True -> \"icon-btn icon-btn-active\"\n              False -> \"icon-btn\"\n            }),\n            attr.attribute(\n              \"title\",\n              case model.looping {\n                True -> \"Loop on — click to stop looping\"\n                False -> \"Loop off — click to loop animation\"\n              },\n            ),\n            attr.type_(\"button\"),\n            attr.attribute(\"data-test-id\", \"loop-btn\"),\n            event.on_click(ToggleLoop),\n          ],\n          [html.text(\"⟲\")],\n        ),\n","length":602,"path":"src\\app.gleam","range":{"end":{"character":0,"line":1044},"start":{"character":0,"line":1044}},"sha256":"3ffd0cfcaad6c36c0636fe1227bc4aacd991f19b0ea221b66d68c1460394cb99"},"hash":"1affc0ab185b1f4960ca59bfbc0ff898322602a18855ea89ca819a25dc6b582e","kind":"paste","prev_hash":"6942897dd3b713135cd8c07e4d8b0161ae0bb856dcb5ff07bdc26cd00b170803","seq":501,"t":8130141,"wall":"2026-11-25T23:20:31.402Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":304},"start":{"character":0,"line":298}},"text":"  looping: Bool,\n) -> Effect(Msg) {\n  let rendered = math_render_paths(plot.paths, style)\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n    render.set_loop(looping)\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"461164600a321a8eab0f0e6937a09d5efb7ce0775452ee328eac34b1e7de67ac","kind":"doc.change","prev_hash":"1affc0ab185b1f4960ca59bfbc0ff898322602a18855ea89ca819a25dc6b582e","seq":502,"t":8139365,"wall":"2026-11-25T23:20:40.625Z"}
