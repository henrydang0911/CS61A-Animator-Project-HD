{"data":{"diff_size":46,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Sine\n  Cosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  ScaledSine\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Sine -> \"y=sin(x)\"\n    Cosine -> \"y=cos(x)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ScaledSine -> \"y=a*sin(x)\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Sine -> \"y = sin(x)\"\n    Cosine -> \"y = cos(x)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ScaledSine -> \"y = a·sin(x)  (a from shape slider)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Sine,\n    Cosine,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ScaledSine,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=sin(x)\" -> Sine\n    \"y=cos(x)\" -> Cosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=a*sin(x)\" -> ScaledSine\n    \"3d\" -> ThreeDUnsupported\n    _ -> Sine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\n/// Build axes + curve Paths for Manim-style reveal. `shape_slider` (0–100)\n/// scales amplitude for ScaledSine as a ∈ [0.25, 2.5].\npub fn plot(f: MathFn, shape_slider: Int) -> Result(List(Path), MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let amplitude = amplitude(shape_slider)\n      let curve = sample_curve(f, amplitude)\n      let axes = axis_paths()\n      Ok(list.append(axes, curve))\n    }\n  }\n}\n\nfn amplitude(shape_slider: Int) -> Float {\n  0.25 +. int.to_float(int.clamp(shape_slider, 0, 100)) /. 100.0 *. 2.25\n}\n\nfn axis_paths() -> List(Path) {\n  let axis_t = 2.0\n  [\n    // x-axis draws first\n    Path(Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)), 0.0, 8.0, axis_t),\n    // y-axis\n    Path(Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)), 4.0, 12.0, axis_t),\n  ]\n}\n\nfn sample_curve(f: MathFn, amplitude: Float) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, amplitude) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    Sine -> Ok(js_sin(x))\n    Cosine -> Ok(js_cos(x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ScaledSine -> Ok(a *. js_sin(x))\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":6311,"new_hash":"f7b2ebdfa5257c3917b01e6013524e34d861a66584441849f503e1590457eaae","old_hash":"7379c01274a14338f08c31ebcf991372f92ccaea121a67be2bce2b6961ed6251","operation":"modify","path":"src/math.gleam"},"hash":"ac9dd3353a137098cee7b7c6de0d416612493832761deec62ee8ccce976c722c","kind":"fs.external_change","prev_hash":"7e6b5a6267c6193c7745a3c05267862284bf41c067e1d0ba978f4a390d9af016","seq":110,"t":2207019,"wall":"2026-11-25T21:41:55.890Z"}
{"data":{"diff_size":130,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Sine\n  Cosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  ScaledSine\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Sine -> \"y=sin(x)\"\n    Cosine -> \"y=cos(x)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ScaledSine -> \"y=a*sin(x)\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Sine -> \"y = sin(x)\"\n    Cosine -> \"y = cos(x)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ScaledSine -> \"y = a·sin(x)  (a from shape slider)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Sine,\n    Cosine,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ScaledSine,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=sin(x)\" -> Sine\n    \"y=cos(x)\" -> Cosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=a*sin(x)\" -> ScaledSine\n    \"3d\" -> ThreeDUnsupported\n    _ -> Sine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// `shape_slider` (0–100) scales amplitude for ScaledSine as a ∈ [0.25, 2.5].\npub fn plot(f: MathFn, shape_slider: Int) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let amplitude = amplitude(shape_slider)\n      let curve = sample_curve(f, amplitude)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn amplitude(shape_slider: Int) -> Float {\n  0.25 +. int.to_float(int.clamp(shape_slider, 0, 100)) /. 100.0 *. 2.25\n}\n\nfn axis_paths() -> List(Path) {\n  let axis_t = 2.0\n  [\n    // x-axis draws first\n    Path(Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)), 0.0, 8.0, axis_t),\n    // y-axis\n    Path(Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)), 4.0, 12.0, axis_t),\n  ]\n}\n\nfn sample_curve(f: MathFn, amplitude: Float) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, amplitude) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    Sine -> Ok(js_sin(x))\n    Cosine -> Ok(js_cos(x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ScaledSine -> Ok(a *. js_sin(x))\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":6441,"new_hash":"fa04b472a6bd011510aff8f1eacf6d1e50e1c273fe82f57cb7a360720dc83124","old_hash":"f7b2ebdfa5257c3917b01e6013524e34d861a66584441849f503e1590457eaae","operation":"modify","path":"src/math.gleam"},"hash":"abdce62c0ab9f9691b588936a16284fe24e59ec7d61ed1ca4d74ddf7ec143271","kind":"fs.external_change","prev_hash":"ac9dd3353a137098cee7b7c6de0d416612493832761deec62ee8ccce976c722c","seq":111,"t":2208685,"wall":"2026-11-25T21:41:57.555Z"}
{"data":{"diff_size":1872,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Sine\n  Cosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  ScaledSine\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Sine -> \"y=sin(x)\"\n    Cosine -> \"y=cos(x)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ScaledSine -> \"y=a*sin(x)\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Sine -> \"y = sin(x)\"\n    Cosine -> \"y = cos(x)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ScaledSine -> \"y = a·sin(x)  (a from shape slider)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Sine,\n    Cosine,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ScaledSine,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=sin(x)\" -> Sine\n    \"y=cos(x)\" -> Cosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=a*sin(x)\" -> ScaledSine\n    \"3d\" -> ThreeDUnsupported\n    _ -> Sine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// `shape_slider` (0–100) scales amplitude for ScaledSine as a ∈ [0.25, 2.5].\npub fn plot(f: MathFn, shape_slider: Int) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let amplitude = amplitude(shape_slider)\n      let curve = sample_curve(f, amplitude)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn amplitude(shape_slider: Int) -> Float {\n  0.25 +. int.to_float(int.clamp(shape_slider, 0, 100)) /. 100.0 *. 2.25\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(f: MathFn, amplitude: Float) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, amplitude) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    Sine -> Ok(js_sin(x))\n    Cosine -> Ok(js_cos(x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ScaledSine -> Ok(a *. js_sin(x))\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":8321,"new_hash":"9f46f8926f20b129e960584460b122baf068ae3c34cef5c43f640d94b7ca17d2","old_hash":"fa04b472a6bd011510aff8f1eacf6d1e50e1c273fe82f57cb7a360720dc83124","operation":"modify","path":"src/math.gleam"},"hash":"a3d0799db8c4e57455f7184cd04eeba727fc3d3a96329ba910ec33ab5282197b","kind":"fs.external_change","prev_hash":"abdce62c0ab9f9691b588936a16284fe24e59ec7d61ed1ca4d74ddf7ec143271","seq":112,"t":2213992,"wall":"2026-11-25T21:42:02.862Z"}
{"data":{"active_file":"src/app.gleam","focused":true,"idle_since_ms":212835.98630000022},"hash":"f66bcf32c64bf042d31bbdfd49fdedd9dfc607eab1decaef633341485e2a19af","kind":"session.heartbeat","prev_hash":"a3d0799db8c4e57455f7184cd04eeba727fc3d3a96329ba910ec33ab5282197b","seq":113,"t":2220492,"wall":"2026-11-25T21:42:09.362Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":250},"start":{"character":0,"line":176}},"text":"/// Axes + ticks muted; curve in Manim teal. First 18 paths are decorations\n/// (2 axes + 8 x-ticks + 8 y-ticks) from math.axis_decorations.\nconst math_decoration_count = 18\n\nfn math_render_paths(paths: List(Path)) -> List(render.RenderPath) {\n  list.index_map(paths, fn(path, i) {\n    let color = case i < math_decoration_count {\n      True -> \"#8a8aaa\"\n      False -> \"#58C4DD\"\n    }\n    render.render_path(path, color)\n  })\n}\n\nfn run_math(\n  math_fn: MathFn,\n  shape_slider: Int,\n) -> Result(math.Plot, AppError) {\n  case math.plot(math_fn, shape_slider) {\n    Ok(plot) -> Ok(plot)\n    Error(err) -> Error(AppError(MathError, math.error_message(err)))\n  }\n}\n\nfn animate_math(\n  plot: math.Plot,\n  speed_percent: Int,\n  paused: Bool,\n) -> Effect(Msg) {\n  let rendered = math_render_paths(plot.paths)\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n    render.set_labels(plot.labels)\n    render.set_drawing(rendered)\n  })\n}\n\nfn update_math_drawing(plot: math.Plot) -> Effect(Msg) {\n  let rendered = math_render_paths(plot.paths)\n  effect.from(fn(_) {\n    render.set_labels(plot.labels)\n    render.set_drawing(rendered)\n  })\n}\n\nfn refresh_math(model: Model, restart: Bool) -> #(Model, Effect(Msg)) {\n  case run_math(model.math_fn, model.shape_slider) {\n    Ok(plot) -> {\n      let effect = case restart {\n        True -> animate_math(plot, model.speed_percent, model.paused)\n        False -> update_math_drawing(plot)\n      }\n      #(Model(..model, error: None), effect)\n    }\n    Error(err) -> #(Model(..model, error: Some(err)), clear_drawing())\n  }\n}\n\n/// Turn Paths into RenderPaths with cycling Manim colours, then push them to\n/// the canvas and restart the clock so each edit plays like a fresh construction.\nfn animate(paths: List(Path), speed_percent: Int, paused: Bool) -> Effect(Msg) {\n  let rendered = to_render_paths(paths)\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n    render.set_labels([])\n    render.set_drawing(rendered)\n  })\n}\n\n/// Swap geometry for a new shape_slider value without touching speed or clock.\nfn update_drawing(paths: List(Path)) -> Effect(Msg) {\n  let rendered = to_render_paths(paths)\n  effect.from(fn(_) {\n    render.set_labels([])\n    render.set_drawing(rendered)\n  })\n}\n\nfn clear_drawing() -> Effect(Msg) {\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_labels([])\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"bf14855cd5a1da38e8c7044a192c4281d8c9fe1f0e83af8a7f7409894c592a1d","kind":"doc.change","prev_hash":"f66bcf32c64bf042d31bbdfd49fdedd9dfc607eab1decaef633341485e2a19af","seq":114,"t":2224818,"wall":"2026-11-25T21:42:13.688Z"}
