{"data":{"deltas":[{"range":{"end":{"character":0,"line":24},"start":{"character":0,"line":11}},"text":"import gleam/result\nimport gleam/string\nimport lustre\nimport lustre/attribute as attr\nimport lustre/effect.{type Effect}\nimport lustre/element.{type Element}\nimport lustre/element/html\nimport lustre/event\nimport complex_math.{type ComplexFn}\nimport math.{type MathFn}\nimport parser\nimport render.{type SweepArrow}\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"2768f7bf13ba1251f267b27baac3a82dc5220fce59ffaf361d337a7d34a0e711","kind":"doc.change","prev_hash":"35c62934f0cc56ead33fc1e564862effab43695d257548a663ffbbbae7ced341","seq":416,"t":6230868,"wall":"2026-11-25T22:48:52.129Z"}
