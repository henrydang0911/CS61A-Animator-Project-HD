{"data":{"deltas":[{"range":{"end":{"character":0,"line":620},"start":{"character":0,"line":581}},"text":"  let slope = case math.uses_slope(model.math_fn) {\n    False -> []\n    True -> [\n      html.label([attr.class(\"slider-label slider-label-full\")], [\n        html.span([], [\n          html.text(\"m (slope) \" <> int.to_string(model.math_slope)),\n        ]),\n        html.input([\n          attr.type_(\"range\"),\n          attr.min(\"-5\"),\n          attr.max(\"5\"),\n          attr.step(\"1\"),\n          attr.value(int.to_string(model.math_slope)),\n          attr.attribute(\"title\", \"Slope m for y = mx − b (−5…5)\"),\n          event.on_input(fn(raw) {\n            SetMathSlope(result.unwrap(int.parse(raw), model.math_slope))\n          }),\n        ]),\n      ]),\n    ]\n  }\n\n  let wave = case math.uses_wave_params(model.math_fn) {\n    False -> []\n    True -> [\n      html.label([attr.class(\"slider-label slider-label-full\")], [\n        html.span([], [\n          html.text(\"a (amplitude) \" <> int.to_string(model.math_amp)),\n        ]),\n        html.input([\n          attr.type_(\"range\"),\n          attr.min(\"-5\"),\n          attr.max(\"5\"),\n          attr.step(\"1\"),\n          attr.value(int.to_string(model.math_amp)),\n          attr.attribute(\"title\", \"Amplitude a (−5…5); default 1\"),\n          event.on_input(fn(raw) {\n            SetMathAmp(result.unwrap(int.parse(raw), model.math_amp))\n          }),\n        ]),\n      ]),\n      html.label([attr.class(\"slider-label slider-label-full\")], [\n        html.span([], [\n          html.text(\"ω (omega) \" <> int.to_string(model.math_omega)),\n        ]),\n        html.input([\n          attr.type_(\"range\"),\n          attr.min(\"1\"),\n          attr.max(\"10\"),\n          attr.step(\"1\"),\n          attr.value(int.to_string(model.math_omega)),\n          attr.attribute(\"title\", \"Angular frequency ω (1…10); default 1\"),\n          event.on_input(fn(raw) {\n            SetMathOmega(result.unwrap(int.parse(raw), model.math_omega))\n          }),\n        ]),\n      ]),\n    ]\n  }\n\n  html.div(\n    [attr.class(\"math-wave-sliders\")],\n    list.flatten([[shift], slope, wave]),\n  )\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"bd66a1ace4dc10e34f0479753dec53f952352ad52d5f83b6abd3f390f04195c3","kind":"doc.change","prev_hash":"208d2146bb498667e1d5b8d5b08875b784012158cba00fd6a9363bcb92dbfd2a","seq":171,"t":2881180,"wall":"2026-11-25T21:53:10.051Z"}
