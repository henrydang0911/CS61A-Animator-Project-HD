{"data":{"content":"    SetMathSlope(m) ->\n      refresh_math(Model(..model, math_slope: int.clamp(m, -5, 5)), False)\n\n","length":99,"path":"src\\app.gleam","range":{"end":{"character":0,"line":381},"start":{"character":0,"line":381}},"sha256":"72c07b3a8b1ba9fac68af080700c52976c73de64fd16dac638a69ec9f9556d5e"},"hash":"a0cdb6b6b97393ab25a32d42fd56563fa9463fdcf480bab6adbf4f68acbe14f3","kind":"paste","prev_hash":"3d46c5ccbbce9e9765a6454747f827f4f49ea9e1ac7dc1e25ac4d0dc69c68122","seq":168,"t":2873401,"wall":"2026-11-25T21:53:02.272Z"}
