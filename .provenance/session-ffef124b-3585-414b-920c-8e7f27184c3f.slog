{"data":{"deltas":[{"range":{"end":{"character":0,"line":341},"start":{"character":0,"line":331}},"text":"    render.clear_sweep()\n    render.set_drawing(rendered)\n  })\n}\n\n/// Swap geometry for a new shape_slider value without touching speed or clock.\nfn update_drawing(paths: List(Path)) -> Effect(Msg) {\n  let rendered = to_render_paths(paths)\n  effect.from(fn(_) {\n    render.set_labels([])\n    render.set_dots([])\n    render.clear_sweep()\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"329b2b908fd178d6e3f3c3aee1c1914ca1a9bfbf5fc3f5534e470d282f9eb82f","kind":"doc.change","prev_hash":"547cdcf42746e1192d0ee93ddff5d52e4980296da6f12433473dd666aca080f8","seq":422,"t":6246710,"wall":"2026-11-25T22:49:07.971Z"}
