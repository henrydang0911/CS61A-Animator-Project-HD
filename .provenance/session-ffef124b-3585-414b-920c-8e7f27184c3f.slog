{"data":{"diff_size":123,"new_content":"// Host-side math used by Math mode sampling (gleam/float has no trig).\n\nexport function sin(x) {\n  return Math.sin(x);\n}\n\nexport function cos(x) {\n  return Math.cos(x);\n}\n\nexport function tan(x) {\n  return Math.tan(x);\n}\n\nexport function asin(x) {\n  return Math.asin(x);\n}\n\nexport function acos(x) {\n  return Math.acos(x);\n}\n\nexport function atan(x) {\n  return Math.atan(x);\n}\n\nexport function atan2(y, x) {\n  return Math.atan2(y, x);\n}\n\n/// Parse θ expressions: \"pi\", \"pi/2\", \"3*pi/2\", \"0\", \"2pi\", etc.\n/// Returns [ok, value] — ok false when empty/invalid.\nexport function parse_theta(expr) {\n  let s = String(expr ?? \"\")\n    .trim()\n    .toLowerCase()\n    .replace(/π/g, \"pi\")\n    .replace(/\\s+/g, \"\");\n  if (!s) return [false, 0];\n  // Allow digits, pi, * / + - ( ) and decimal points only.\n  if (!/^[0-9pi.*+\\-/()]+$/.test(s)) return [false, 0];\n  // Bare \"2pi\" → \"2*pi\"\n  s = s.replace(/(\\d)pi/g, \"$1*pi\").replace(/pi(\\d)/g, \"pi*$1\");\n  try {\n    const v = Function(\"pi\", `\"use strict\"; return (${s});`)(Math.PI);\n    if (typeof v !== \"number\" || !Number.isFinite(v)) return [false, 0];\n    // Allowed range is [0, 2π] only.\n    const twoPi = 2 * Math.PI;\n    if (v < 0 || v > twoPi + 1e-9) return [false, 0];\n    return [true, v];\n  } catch {\n    return [false, 0];\n  }\n}\n","new_content_size":1287,"new_hash":"2118ba8970a2c16641e793a1fba749cad91579d8566331331d084c2cd03b7479","old_hash":"ecbd45885ce73974f486eefec8700cbeab5168da841cde9a4515327275aa8163","operation":"modify","path":"src/math_ffi.mjs"},"hash":"7eb5e4d314e6d5891256c5a2cd2d83a1ab4528094d5eb409d211184344fa6762","kind":"fs.external_change","prev_hash":"abeef39a60d4aa3c08161eb384bbd1ca8bec4bf6ad57fd2a042801464c40fb4d","seq":446,"t":6541918,"wall":"2026-11-25T22:54:03.179Z"}
