es-view","version":"10.0.0"},{"enabled":false,"id":"vscode.restructuredtext","version":"10.0.0"},{"enabled":false,"id":"vscode.ruby","version":"10.0.0"},{"enabled":false,"id":"vscode.rust","version":"10.0.0"},{"enabled":false,"id":"vscode.scss","version":"10.0.0"},{"enabled":false,"id":"vscode.search-result","version":"10.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"10.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"10.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"10.0.0"},{"enabled":false,"id":"vscode.sql","version":"10.0.0"},{"enabled":false,"id":"vscode.swift","version":"10.0.0"},{"enabled":true,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-modern-icons","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"10.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.vb","version":"10.0.0"},{"enabled":false,"id":"vscode.xml","version":"10.0.0"},{"enabled":false,"id":"vscode.yaml","version":"10.0.0"},{"enabled":true,"id":"berkeley-ai4ed.preceptor","version":"0.1.6"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":true,"id":"hbenl.vscode-test-explorer","version":"2.22.1"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.autopep8","version":"2026.6.0"},{"enabled":false,"id":"ms-python.black-formatter","version":"2026.8.0"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":false,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.44.0"},{"enabled":false,"id":"ms-toolsai.jupyter","version":"2025.9.1"},{"enabled":false,"id":"ms-toolsai.jupyter-keymap","version":"1.1.2"},{"enabled":false,"id":"ms-toolsai.jupyter-renderers","version":"1.3.0"},{"enabled":false,"id":"ms-toolsai.vscode-jupyter-cell-tags","version":"0.1.9"},{"enabled":false,"id":"ms-toolsai.vscode-jupyter-slideshow","version":"0.1.6"},{"enabled":false,"id":"ms-vscode.cmake-tools","version":"1.25.10"},{"enabled":false,"id":"ms-vscode.cpp-devtools","version":"0.7.2"},{"enabled":false,"id":"ms-vscode.cpptools","version":"1.35.6"},{"enabled":false,"id":"ms-vscode.cpptools-extension-pack","version":"1.5.1"},{"enabled":false,"id":"ms-vscode.cpptools-themes","version":"2.0.0"},{"enabled":true,"id":"ms-vscode.test-adapter-converter","version":"0.2.1"},{"enabled":false,"id":"tht13.python","version":"0.2.3"}]},"hash":"9425f01d30df551c572edc93fadfda11f48186b85d951f635dff07d3b2bb1689","kind":"ext.snapshot","prev_hash":"a43f48ee28e7980f3bfa0935faef0a604de08694c41d9c0d723ef6d15fc0b5c0","seq":385,"t":5728518,"wall":"2026-11-25T22:40:29.779Z"}
