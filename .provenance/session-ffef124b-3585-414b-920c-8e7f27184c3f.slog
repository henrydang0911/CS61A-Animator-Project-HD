{"data":{"content":"/// Real y = f(x) plots vs Argand-plane complex maps, both under Math mode.\npub type MathPlane {\n  RealPlane\n  ComplexPlane\n}\n\n","length":127,"path":"src\\app.gleam","range":{"end":{"character":0,"line":63},"start":{"character":0,"line":63}},"sha256":"7ff9b2aa06d064040413ab0b0eeecfd055719df1984744700b40c2b6bd43e91e"},"hash":"a7681c38d4c54e650f2e1d97d3638c3743663eaa3f9c0425725e57fec94a7e4d","kind":"paste","prev_hash":"66780156df1939b143a3de158a9ce8bfd8899dff2e73f9129c72b340cd780459","seq":284,"t":4655531,"wall":"2026-11-25T22:22:36.792Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":105},"start":{"character":0,"line":86}},"text":"    // Draw = user Gleam draw(); Math = preset y = f(x) / complex maps.\n    mode: AppMode,\n    math_plane: MathPlane,\n    math_fn: MathFn,\n    complex_fn: ComplexFn,\n    // Amplitude / complex scale a (−5…5, default 1).\n    math_amp: Int,\n    // Angular frequency ω for waves / complex exp·sin·cos (1…10, default 1).\n    math_omega: Int,\n    // Horizontal / Re-axis shift b (−5…5).\n    math_shift: Int,\n    // Slope m for the line y = mx − b (−5…5, default 1).\n    math_slope: Int,\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  SelectDrawing(String)\n  SetMode(AppMode)\n  SetMathPlane(MathPlane)\n  SetMathFn(MathFn)\n  SetComplexFn(ComplexFn)\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"c435162a64e99b8ff8097811ad451c7aaf9e740fdd5757d6cc8f7f95fd434027","kind":"doc.change","prev_hash":"a7681c38d4c54e650f2e1d97d3638c3743663eaa3f9c0425725e57fec94a7e4d","seq":285,"t":4660656,"wall":"2026-11-25T22:22:41.917Z"}
