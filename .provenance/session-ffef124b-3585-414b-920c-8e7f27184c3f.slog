{"data":{"deltas":[{"range":{"end":{"character":0,"line":264},"start":{"character":0,"line":208}},"text":"/// How to color math paths: real curves all teal; complex splits grid images.\npub type MathStyle {\n  RealStyle\n  ComplexStyle(horizontal_count: Int)\n}\n\nfn math_render_paths(\n  paths: List(Path),\n  style: MathStyle,\n) -> List(render.RenderPath) {\n  list.index_map(paths, fn(path, i) {\n    let color = case style {\n      RealStyle ->\n        case i < math_decoration_count {\n          True -> \"#8a8aaa\"\n          False -> \"#58C4DD\"\n        }\n      ComplexStyle(h) -> complex_math.path_color(i, h)\n    }\n    render.render_path(path, color)\n  })\n}\n\nfn run_math(model: Model) -> Result(#(math.Plot, MathStyle), AppError) {\n  case model.math_plane {\n    RealPlane ->\n      case\n        math.plot(\n          model.math_fn,\n          model.math_amp,\n          model.math_omega,\n          model.math_shift,\n          model.math_slope,\n        )\n      {\n        Ok(plot) -> Ok(#(plot, RealStyle))\n        Error(err) -> Error(AppError(MathError, math.error_message(err)))\n      }\n    ComplexPlane -> {\n      let #(plot, horiz) =\n        complex_math.plot(\n          model.complex_fn,\n          model.math_amp,\n          model.math_omega,\n          model.math_shift,\n        )\n      Ok(#(plot, ComplexStyle(horiz)))\n    }\n  }\n}\n\nfn animate_math(\n  plot: math.Plot,\n  style: MathStyle,\n  speed_percent: Int,\n  paused: Bool,\n) -> Effect(Msg) {\n  let rendered = math_render_paths(plot.paths, style)\n  let rate = effective_rate(speed_percent, paused)\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_speed(rate)\n    render.set_labels(plot.labels)\n    render.set_dots(plot.dots)\n    render.set_drawing(rendered)\n  })\n}\n\nfn update_math_drawing(plot: math.Plot, style: MathStyle) -> Effect(Msg) {\n  let rendered = math_render_paths(plot.paths, style)\n  effect.from(fn(_) {\n    render.set_labels(plot.labels)\n    render.set_dots(plot.dots)\n    render.set_drawing(rendered)\n  })\n}\n\nfn refresh_math(model: Model, restart: Bool) -> #(Model, Effect(Msg)) {\n  case run_math(model) {\n    Ok(#(plot, style)) -> {\n      let effect = case restart {\n        True -> animate_math(plot, style, model.speed_percent, model.paused)\n        False -> update_math_drawing(plot, style)\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"b59911c91e0916641d2b8ccda38586b7592ee8eebe880c2003edf3ef8675f0ec","kind":"doc.change","prev_hash":"a646c075a9766d105a06ca15fd820105e137b7a0e8854d1aa3e9d081089b0e5e","seq":288,"t":4672845,"wall":"2026-11-25T22:22:54.106Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":416},"start":{"character":0,"line":415}},"text":"    SetMathPlane(plane) ->\n      refresh_math(Model(..model, math_plane: plane), True)\n\n    SetMathFn(math_fn) -> refresh_math(Model(..model, math_fn: math_fn), True)\n\n    SetComplexFn(complex_fn) ->\n      refresh_math(Model(..model, complex_fn: complex_fn), True)\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"6890a3cae6fab60954de2d0f6a26f35af85ad1b69ac5877284e1d522d75d9857","kind":"doc.change","prev_hash":"b59911c91e0916641d2b8ccda38586b7592ee8eebe880c2003edf3ef8675f0ec","seq":289,"t":4674590,"wall":"2026-11-25T22:22:55.851Z"}
