{"data":{"diff_size":20,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport shape.{type Path, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Sine\n  Cosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  ScaledSine\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Sine -> \"y=sin(x)\"\n    Cosine -> \"y=cos(x)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ScaledSine -> \"y=a*sin(x)\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Sine -> \"y = sin(x)\"\n    Cosine -> \"y = cos(x)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ScaledSine -> \"y = a·sin(x)  (a from shape slider)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Sine,\n    Cosine,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ScaledSine,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=sin(x)\" -> Sine\n    \"y=cos(x)\" -> Cosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=a*sin(x)\" -> ScaledSine\n    \"3d\" -> ThreeDUnsupported\n    _ -> Sine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\n/// Build axes + curve Paths for Manim-style reveal. `shape_slider` (0–100)\n/// scales amplitude for ScaledSine as a ∈ [0.25, 2.5].\npub fn plot(f: MathFn, shape_slider: Int) -> Result(List(Path), MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let amplitude = amplitude(shape_slider)\n      let curve = sample_curve(f, amplitude)\n      let axes = axis_paths()\n      Ok(list.append(axes, curve))\n    }\n  }\n}\n\nfn amplitude(shape_slider: Int) -> Float {\n  0.25 +. int.to_float(int.clamp(shape_slider, 0, 100)) /. 100.0 *. 2.25\n}\n\nfn axis_paths() -> List(Path) {\n  let axis_t = 2.0\n  [\n    // x-axis draws first\n    Path(Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)), 0.0, 8.0, axis_t),\n    // y-axis\n    Path(Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)), 4.0, 12.0, axis_t),\n  ]\n}\n\nfn sample_curve(f: MathFn, amplitude: Float) -> List(Path) {\n  let xs =\n    list.range(0, sample_count)\n    |> list.map(fn(i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, amplitude) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    Sine -> Ok(js_sin(x))\n    Cosine -> Ok(js_cos(x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ScaledSine -> Ok(a *. js_sin(x))\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":6237,"new_hash":"bfa4ba3b7e0e0ca201534d316eb797bfeb947690459945210f4a8a7cbf2a3288","old_hash":"b751dd96c900334c6a65a81115c346383187ef92efc642a08c736cb8138be612","operation":"modify","path":"src/math.gleam"},"hash":"836365462170b5236ecd3331d8080ee8c8f560890e81dd10bd2201add92fd878","kind":"fs.external_change","prev_hash":"e49c02fa23a96347abde5c09a3228248c90ec50243c6805e8027d3f030cd0416","seq":98,"t":2011411,"wall":"2026-11-25T21:38:40.282Z"}
{"data":{"diff_size":12,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Sine\n  Cosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  ScaledSine\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Sine -> \"y=sin(x)\"\n    Cosine -> \"y=cos(x)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ScaledSine -> \"y=a*sin(x)\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Sine -> \"y = sin(x)\"\n    Cosine -> \"y = cos(x)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ScaledSine -> \"y = a·sin(x)  (a from shape slider)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Sine,\n    Cosine,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ScaledSine,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=sin(x)\" -> Sine\n    \"y=cos(x)\" -> Cosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=a*sin(x)\" -> ScaledSine\n    \"3d\" -> ThreeDUnsupported\n    _ -> Sine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\n/// Build axes + curve Paths for Manim-style reveal. `shape_slider` (0–100)\n/// scales amplitude for ScaledSine as a ∈ [0.25, 2.5].\npub fn plot(f: MathFn, shape_slider: Int) -> Result(List(Path), MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let amplitude = amplitude(shape_slider)\n      let curve = sample_curve(f, amplitude)\n      let axes = axis_paths()\n      Ok(list.append(axes, curve))\n    }\n  }\n}\n\nfn amplitude(shape_slider: Int) -> Float {\n  0.25 +. int.to_float(int.clamp(shape_slider, 0, 100)) /. 100.0 *. 2.25\n}\n\nfn axis_paths() -> List(Path) {\n  let axis_t = 2.0\n  [\n    // x-axis draws first\n    Path(Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)), 0.0, 8.0, axis_t),\n    // y-axis\n    Path(Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)), 4.0, 12.0, axis_t),\n  ]\n}\n\nfn sample_curve(f: MathFn, amplitude: Float) -> List(Path) {\n  let xs =\n    list.range(0, sample_count)\n    |> list.map(fn(i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, amplitude) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    Sine -> Ok(js_sin(x))\n    Cosine -> Ok(js_cos(x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ScaledSine -> Ok(a *. js_sin(x))\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":6249,"new_hash":"ab144e25bc73212abd59542f87f57887a3c1eae3db20335d884a9bb3ffa1e7c5","old_hash":"bfa4ba3b7e0e0ca201534d316eb797bfeb947690459945210f4a8a7cbf2a3288","operation":"modify","path":"src/math.gleam"},"hash":"d1b72fb5db8f4b5e922bc46c0536ab46f5af052c5c2d7d254536f40ab590c00c","kind":"fs.external_change","prev_hash":"836365462170b5236ecd3331d8080ee8c8f560890e81dd10bd2201add92fd878","seq":99,"t":2026614,"wall":"2026-11-25T21:38:55.485Z"}
{"data":{"diff_size":41,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  Sine\n  Cosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  ScaledSine\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    Sine -> \"y=sin(x)\"\n    Cosine -> \"y=cos(x)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    ScaledSine -> \"y=a*sin(x)\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = x\"\n    Square -> \"y = x²\"\n    Cube -> \"y = x³\"\n    Sine -> \"y = sin(x)\"\n    Cosine -> \"y = cos(x)\"\n    Tangent -> \"y = tan(x)\"\n    Exp -> \"y = exp(x)\"\n    Ln -> \"y = ln(x)\"\n    Sqrt -> \"y = √x\"\n    Reciprocal -> \"y = 1/x\"\n    ScaledSine -> \"y = a·sin(x)  (a from shape slider)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Sine,\n    Cosine,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ScaledSine,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=sin(x)\" -> Sine\n    \"y=cos(x)\" -> Cosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=a*sin(x)\" -> ScaledSine\n    \"3d\" -> ThreeDUnsupported\n    _ -> Sine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\n/// Build axes + curve Paths for Manim-style reveal. `shape_slider` (0–100)\n/// scales amplitude for ScaledSine as a ∈ [0.25, 2.5].\npub fn plot(f: MathFn, shape_slider: Int) -> Result(List(Path), MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let amplitude = amplitude(shape_slider)\n      let curve = sample_curve(f, amplitude)\n      let axes = axis_paths()\n      Ok(list.append(axes, curve))\n    }\n  }\n}\n\nfn amplitude(shape_slider: Int) -> Float {\n  0.25 +. int.to_float(int.clamp(shape_slider, 0, 100)) /. 100.0 *. 2.25\n}\n\nfn axis_paths() -> List(Path) {\n  let axis_t = 2.0\n  [\n    // x-axis draws first\n    Path(Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)), 0.0, 8.0, axis_t),\n    // y-axis\n    Path(Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)), 4.0, 12.0, axis_t),\n  ]\n}\n\nfn sample_curve(f: MathFn, amplitude: Float) -> List(Path) {\n  let xs =\n    list.map(list.repeat(Nil, sample_count + 1), fn(_) { Nil })\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, amplitude) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(f: MathFn, x: Float, a: Float) -> Result(Float, Nil) {\n  case f {\n    Identity -> Ok(x)\n    Square -> Ok(x *. x)\n    Cube -> Ok(x *. x *. x)\n    Sine -> Ok(js_sin(x))\n    Cosine -> Ok(js_cos(x))\n    Tangent -> {\n      let c = js_cos(x)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(x))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(x)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(x)\n    Sqrt -> float.square_root(x)\n    Reciprocal ->\n      case float.absolute_value(x) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. x)\n      }\n    ScaledSine -> Ok(a *. js_sin(x))\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":6290,"new_hash":"3b0e693c44af2790bed589c127f29536143505a997d2d793a35e8fb9e7d670f3","old_hash":"ab144e25bc73212abd59542f87f57887a3c1eae3db20335d884a9bb3ffa1e7c5","operation":"modify","path":"src/math.gleam"},"hash":"8e34933a10bba9cc5eda779a962046be4ab71accb39c2e8776cb2d652b6e6818","kind":"fs.external_change","prev_hash":"d1b72fb5db8f4b5e922bc46c0536ab46f5af052c5c2d7d254536f40ab590c00c","seq":100,"t":2027750,"wall":"2026-11-25T21:38:56.621Z"}
