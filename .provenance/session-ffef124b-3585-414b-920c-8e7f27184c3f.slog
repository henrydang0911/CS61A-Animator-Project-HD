{"data":{"deltas":[{"range":{"end":{"character":0,"line":454},"start":{"character":0,"line":450}},"text":"      view_mode_bar(model),\n      case model.mode {\n        DrawMode ->\n          html.div([attr.class(\"code-col-body\")], [\n            view_drawing_select(model),\n            editor.view_panel(ToggleCode),\n          ])\n        MathMode -> view_math_panel(model)\n      },\n    ]),\n    view_anim(model),\n  ])\n}\n\nfn view_mode_bar(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"mode-bar\")], [\n    html.button(\n      [\n        attr.class(case model.mode {\n          DrawMode -> \"mode-btn mode-btn-active\"\n          MathMode -> \"mode-btn\"\n        }),\n        attr.type_(\"button\"),\n        event.on_click(SetMode(DrawMode)),\n      ],\n      [html.text(\"Draw\")],\n    ),\n    html.button(\n      [\n        attr.class(case model.mode {\n          MathMode -> \"mode-btn mode-btn-active\"\n          DrawMode -> \"mode-btn\"\n        }),\n        attr.type_(\"button\"),\n        event.on_click(SetMode(MathMode)),\n      ],\n      [html.text(\"Math\")],\n    ),\n  ])\n}\n\nfn view_math_panel(model: Model) -> Element(Msg) {\n  let options =\n    list.map(math.all_functions(), fn(f) {\n      html.option(\n        [\n          attr.value(math.fn_id(f)),\n          attr.selected(f == model.math_fn),\n        ],\n        math.fn_label(f),\n      )\n    })\n  html.div([attr.class(\"math-panel\")], [\n    html.h2([attr.class(\"math-title\")], [html.text(\"Math mode\")]),\n    html.p([attr.class(\"math-blurb\")], [\n      html.text(\n        \"2D plots only (Desmos-style formula, Manim-style Create). Axes first, then y = f(x). Shape slider sets a in y = a·sin(x).\",\n      ),\n    ]),\n    html.label([attr.class(\"drawing-select-label\")], [\n      html.span([], [html.text(\"Function\")]),\n      html.select(\n        [\n          attr.attribute(\"data-test-id\", \"math-fn-select\"),\n          attr.class(\"drawing-select\"),\n          event.on_change(fn(id) { SetMathFn(math.parse_fn_id(id)) }),\n        ],\n        options,\n      ),\n    ]),\n    html.p([attr.class(\"math-formula\")], [\n      html.text(math.fn_label(model.math_fn)),\n    ]),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"71ade829655d4ff500cad3435db8b27a2c00b41de36b46ca3a095456d41ccfa0","kind":"doc.change","prev_hash":"68c6acc451e5623aa0acbd809f7f88f3f427adb39b69671a1568e1d1d16b9af7","seq":94,"t":2005670,"wall":"2026-11-25T21:38:34.540Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":635},"start":{"character":0,"line":625}},"text":"        html.text(case model.mode {\n          MathMode -> \"a (amp) \" <> int.to_string(model.shape_slider)\n          DrawMode -> \"Shape \" <> int.to_string(model.shape_slider)\n        }),\n      ]),\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"0\"),\n        attr.max(\"100\"),\n        attr.step(\"1\"),\n        attr.value(int.to_string(model.shape_slider)),\n        attr.attribute(\"data-test-id\", \"shape-slider\"),\n        attr.attribute(\"title\", case model.mode {\n          MathMode -> \"Amplitude a for y = a·sin(x)\"\n          DrawMode -> \"shape_slider passed to draw (not speed)\"\n        }),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"6d4d8cb7900b49e11017578b2fe196e35150177525071c761c1798da1e3de727","kind":"doc.change","prev_hash":"71ade829655d4ff500cad3435db8b27a2c00b41de36b46ca3a095456d41ccfa0","seq":95,"t":2007656,"wall":"2026-11-25T21:38:36.526Z"}
