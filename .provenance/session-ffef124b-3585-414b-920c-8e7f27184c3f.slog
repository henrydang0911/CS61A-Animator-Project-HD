{"data":{"diff_size":80,"new_content":"//// Complex / Polar submodes of Math on the Argand plane (Re / Im).\n//// — Complex maps: grid → w = a · f(ω(z − b))\n//// — Polar curves: r(θ) drawn on the same plane (calc-class classics + spirals)\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport math.{type Plot, Plot}\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan2\")\nfn js_atan2(y: Float, x: Float) -> Float\n\n/// Maps ℂ→ℂ (Complex tab) and polar r(θ) curves (Polar tab).\npub type ComplexFn {\n  // ── Complex maps (grid images) ───────────────────────────────────────────\n  Identity\n  Square\n  Cube\n  Reciprocal\n  Conjugate\n  Exp\n  Sin\n  Cos\n  Sqrt\n  Log\n  /// w = z^ω via exp(ω Log z)\n  Power\n  Modulus\n  Arg\n  /// Unit circle e^{iθ} with Create-swept tangent sticks i·e^{iθ}.\n  ExpITheta\n  // ── Polar curves on the Argand plane ─────────────────────────────────────\n  /// |z − b| = |a| — circle centered on the Re axis.\n  Circle\n  /// r = 2a cos θ — circle diameter on the Re axis (calc classic).\n  CircleCos\n  /// r = 2a sin θ — circle diameter on the Im axis (calc classic).\n  CircleSin\n  ArchimedesSpiral\n  LogSpiral\n  RoseCos\n  RoseSin\n  Cardioid\n  Limacon\n  Lemniscate\n}\n\npub type C {\n  C(re: Float, im: Float)\n}\n\n/// Axes + integer ticks (same layout count as real math mode).\npub const decoration_count = 18\n\nconst world_half = 450.0\n\nconst x_math_max = 5.0\n\nconst y_clip = 480.0\n\nconst domain_min = -2.0\n\nconst domain_max = 2.0\n\nconst samples_per_line = 72\n\nconst polar_samples = 360\n\nconst pi = 3.141592653589793\n\n/// Sampling mark: drawable point or explicit break at domain / asymptote gaps.\ntype Mark {\n  Pt(Point)\n  Break\n}\n\npub fn fn_id(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w=z\"\n    Square -> \"w=z^2\"\n    Cube -> \"w=z^3\"\n    Reciprocal -> \"w=1/z\"\n    Conjugate -> \"w=conj(z)\"\n    Exp -> \"w=exp(z)\"\n    Sin -> \"w=sin(z)\"\n    Cos -> \"w=cos(z)\"\n    Sqrt -> \"w=sqrt(z)\"\n    Log -> \"w=log(z)\"\n    Power -> \"w=z^w\"\n    Modulus -> \"w=|z|\"\n    Arg -> \"w=arg(z)\"\n    Circle -> \"r=a\"\n    CircleCos -> \"r=2a*cos(theta)\"\n    CircleSin -> \"r=2a*sin(theta)\"\n    ArchimedesSpiral -> \"r=a*theta\"\n    LogSpiral -> \"r=a*e^(k*theta)\"\n    RoseCos -> \"r=a*cos(n*theta)\"\n    RoseSin -> \"r=a*sin(n*theta)\"\n    Cardioid -> \"r=a*(1-cos(theta))\"\n    Limacon -> \"r=a+cos(theta)\"\n    Lemniscate -> \"r^2=a^2*cos(2*theta)\"\n  }\n}\n\npub fn fn_label(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w = z\"\n    Square -> \"w = z²\"\n    Cube -> \"w = z³\"\n    Reciprocal -> \"w = 1/z\"\n    Conjugate -> \"w = z̄\"\n    Exp -> \"w = exp(z)\"\n    Sin -> \"w = sin(z)\"\n    Cos -> \"w = cos(z)\"\n    Sqrt -> \"w = √z\"\n    Log -> \"w = Log(z)\"\n    Power -> \"w = z^ω\"\n    Modulus -> \"w = |z|\"\n    Arg -> \"w = Arg(z)\"\n    Circle -> \"|z − b| = |a|  (circle)\"\n    CircleCos -> \"r = 2a cos θ  (circle)\"\n    CircleSin -> \"r = 2a sin θ  (circle)\"\n    ArchimedesSpiral -> \"r = aθ  (Archimedes)\"\n    LogSpiral -> \"r = a e^{kθ}  (log spiral)\"\n    RoseCos -> \"r = a cos(ωθ)  (rose)\"\n    RoseSin -> \"r = a sin(ωθ)  (rose)\"\n    Cardioid -> \"r = a(1 − cos θ)  (cardioid)\"\n    Limacon -> \"r = a + cos θ  (limaçon)\"\n    Lemniscate -> \"r² = a² cos(ωθ)  (lemniscate)\"\n  }\n}\n\n/// Complex-tab presets (grid maps only).\npub fn all_map_functions() -> List(ComplexFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Reciprocal,\n    Conjugate,\n    Exp,\n    Sin,\n    Cos,\n    Sqrt,\n    Log,\n    Power,\n    Modulus,\n    Arg,\n  ]\n}\n\n/// Polar-tab presets (r(θ) curves on the Argand plane).\npub fn all_polar_functions() -> List(ComplexFn) {\n  [\n    Circle,\n    CircleCos,\n    CircleSin,\n    ArchimedesSpiral,\n    LogSpiral,\n    RoseCos,\n    RoseSin,\n    Cardioid,\n    Limacon,\n    Lemniscate,\n  ]\n}\n\npub fn all_functions() -> List(ComplexFn) {\n  list.append(all_map_functions(), all_polar_functions())\n}\n\npub fn parse_fn_id(id: String) -> ComplexFn {\n  case id {\n    \"w=z\" -> Identity\n    \"w=z^2\" -> Square\n    \"w=z^3\" -> Cube\n    \"w=1/z\" -> Reciprocal\n    \"w=conj(z)\" -> Conjugate\n    \"w=exp(z)\" -> Exp\n    \"w=sin(z)\" -> Sin\n    \"w=cos(z)\" -> Cos\n    \"w=sqrt(z)\" -> Sqrt\n    \"w=log(z)\" -> Log\n    \"w=z^w\" -> Power\n    \"w=|z|\" -> Modulus\n    \"w=arg(z)\" -> Arg\n    \"r=a\" -> Circle\n    \"r=1\" -> Circle\n    \"r=2a*cos(theta)\" -> CircleCos\n    \"r=2a*sin(theta)\" -> CircleSin\n    \"r=a*theta\" -> ArchimedesSpiral\n    \"r=a*e^(k*theta)\" -> LogSpiral\n    \"r=a*cos(n*theta)\" -> RoseCos\n    \"r=a*sin(n*theta)\" -> RoseSin\n    \"r=a*(1-cos(theta))\" -> Cardioid\n    \"r=a+cos(theta)\" -> Limacon\n    \"r=a+b*cos(theta)\" -> Limacon\n    \"r^2=a^2*cos(2*theta)\" -> Lemniscate\n    _ -> Identity\n  }\n}\n\npub fn is_polar(f: ComplexFn) -> Bool {\n  case f {\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// ω: maps (exp/sin/cos/power) and polar roses / spirals / lemniscate petals.\npub fn uses_omega(f: ComplexFn) -> Bool {\n  case f {\n    Exp | Sin | Cos | Power -> True\n    ArchimedesSpiral | LogSpiral | RoseCos | RoseSin | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// Stroke color: axes muted; images of horizontal lines teal; vertical magenta.\n/// Polar curves use teal only (horizontal_count covers all curve paths).\npub fn path_color(index: Int, horizontal_count: Int) -> String {\n  case index < decoration_count {\n    True -> \"#8a8aaa\"\n    False -> {\n      let j = index - decoration_count\n      case j < horizontal_count {\n        True -> \"#58C4DD\"\n        False -> \"#C77DFF\"\n      }\n    }\n  }\n}\n\npub fn plot(f: ComplexFn, a: Int, omega: Int, b: Int) -> #(Plot, Int) {\n  let a_f = int.to_float(int.clamp(a, -5, 5))\n  let w_f = int.to_float(int.clamp(omega, 1, 10))\n  let b_f = int.to_float(int.clamp(b, -5, 5))\n  let #(axis_paths, labels) = argand_decorations()\n  case is_polar(f) {\n    True -> {\n      let curves = polar_plot(f, a_f, w_f, b_f)\n      let n = list.length(curves)\n      #(Plot(list.append(axis_paths, curves), labels, []), n)\n    }\n    False -> {\n      let #(horiz, vert) = mapped_grid(f, a_f, w_f, b_f)\n      let horiz_n = list.length(horiz)\n      #(Plot(list.flatten([axis_paths, horiz, vert]), labels, []), horiz_n)\n    }\n  }\n}\n\nfn argand_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n\n  let re_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      0.0,\n      8.0,\n      axis_t,\n    )\n  let im_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      4.0,\n      12.0,\n      axis_t,\n    )\n\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let re_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let im_ticks =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let re_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        math_to_world(int.to_float(k)),\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let im_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        0.0 -. 28.0,\n        0.0 -. math_to_world(int.to_float(k)),\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let paths = list.flatten([[re_axis, im_axis], re_ticks, im_ticks])\n  let labels = list.flatten([re_labels, im_labels])\n  #(paths, labels)\n}\n\nfn math_to_world(t: Float) -> Float {\n  t *. { world_half /. x_math_max }\n}\n\n// ── Polar curves ─────────────────────────────────────────────────────────────\n\nfn polar_plot(f: ComplexFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let amp = case float.absolute_value(a) <. 0.01 {\n    True -> 1.0\n    False -> float.absolute_value(a)\n  }\n  let marks =\n    list.repeat(Nil, polar_samples + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(polar_samples)\n      case polar_point(f, t, amp, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, 14.0, 40.0, 3.0)\n}\n\n/// t ∈ [0,1] parameter along the polar sweep.\n/// All curves are translated by b along Re after (r, θ) → ℂ.\nfn polar_point(\n  f: ComplexFn,\n  t: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  case f {\n    Circle -> {\n      // |z − b| = a  (center on Re axis at b)\n      let theta = t *. 2.0 *. pi\n      Ok(from_polar(a, theta, b))\n    }\n    CircleCos -> {\n      // r = 2a cos θ — diameter [0, 2a] on Re, then shift by b\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    CircleSin -> {\n      // r = 2a sin θ — diameter on Im, then shift by b along Re\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_sin(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    ArchimedesSpiral -> {\n      // θ ∈ [0, 2πω]; r = (a/8) θ  — more turns with larger ω\n      let theta = t *. 2.0 *. pi *. omega\n      let r = { a /. 8.0 } *. theta\n      Ok(from_polar(r, theta, b))\n    }\n    LogSpiral -> {\n      let theta = t *. 2.0 *. pi *. omega\n      let k = 0.12\n      let r = { a /. 3.0 } *. float.exponential(k *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseCos -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_cos(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseSin -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_sin(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Cardioid -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. { 1.0 -. js_cos(theta) }\n      Ok(from_polar(r, theta, b))\n    }\n    Limacon -> {\n      // Classic dimpled/looped limaçon: r = a + cos θ\n      let theta = t *. 2.0 *. pi\n      let r = a +. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Lemniscate -> {\n      // r² = a² cos(ωθ); classic figure-eight uses ω = 2\n      let theta = t *. 2.0 *. pi\n      let c = js_cos(omega *. theta)\n      case c <. 0.0 {\n        True -> Error(Nil)\n        False ->\n          case float.square_root(a *. a *. c) {\n            Error(Nil) -> Error(Nil)\n            Ok(r) -> Ok(from_polar(r, theta, b))\n          }\n      }\n    }\n    _ -> Error(Nil)\n  }\n}\n\nfn from_polar(r: Float, theta: Float, b_re: Float) -> C {\n  C(r *. js_cos(theta) +. b_re, r *. js_sin(theta))\n}\n\n/// Clamp runaway images to the viewport edge, then break so asymptotes don't bridge.\nfn world_marks(w: C) -> List(Mark) {\n  let #(wx0, wy0) = to_world(w)\n  let ax = float.absolute_value(wx0)\n  let ay = float.absolute_value(wy0)\n  let m = case ax >. ay {\n    True -> ax\n    False -> ay\n  }\n  case m >. y_clip {\n    True -> {\n      let s = y_clip /. m\n      [Pt(Point(wx0 *. s, wy0 *. s)), Break]\n    }\n    False -> [Pt(Point(wx0, wy0))]\n  }\n}\n\n// ── Grid maps ────────────────────────────────────────────────────────────────\n\nfn mapped_grid(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> #(List(Path), List(Path)) {\n  let levels = [-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]\n  let horiz =\n    list.index_map(levels, fn(im, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        True,\n        im,\n        domain_min,\n        domain_max,\n        14.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  let vert =\n    list.index_map(levels, fn(re, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        False,\n        re,\n        domain_min,\n        domain_max,\n        26.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  #(horiz, vert)\n}\n\nfn sample_line(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  horizontal: Bool,\n  fixed: Float,\n  varying_min: Float,\n  varying_max: Float,\n  start_base: Float,\n) -> List(Path) {\n  let marks =\n    list.repeat(Nil, samples_per_line + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(samples_per_line)\n      let varying = varying_min +. t *. { varying_max -. varying_min }\n      let z = case horizontal {\n        True -> C(varying, fixed)\n        False -> C(fixed, varying)\n      }\n      case apply_map(f, z, a, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, start_base, 10.0, 2.2)\n}\n\nfn apply_map(\n  f: ComplexFn,\n  z: C,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  // Input shift on the Re axis: f(z − b), then optional ω scaling, then a·w.\n  let shifted = C(z.re -. b, z.im)\n  let scaled_in = case f {\n    Exp | Sin | Cos | Power -> c_scale(shifted, omega)\n    _ -> shifted\n  }\n  use w <- result.try(eval(f, scaled_in, omega))\n  Ok(c_scale(w, a))\n}\n\nfn eval(f: ComplexFn, z: C, omega: Float) -> Result(C, Nil) {\n  case f {\n    Identity -> Ok(z)\n    Square -> Ok(c_mul(z, z))\n    Cube -> Ok(c_mul(c_mul(z, z), z))\n    Reciprocal -> c_inv(z)\n    Conjugate -> Ok(C(z.re, 0.0 -. z.im))\n    Exp -> Ok(c_exp(z))\n    Sin -> Ok(c_sin(z))\n    Cos -> Ok(c_cos(z))\n    Sqrt -> c_sqrt(z)\n    Log -> c_log(z)\n    Power -> c_pow(z, omega)\n    Modulus -> Ok(C(c_abs(z), 0.0))\n    Arg -> Ok(C(js_atan2(z.im, z.re), 0.0))\n    // Polar variants never reach eval.\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> Error(Nil)\n  }\n}\n\nfn c_scale(z: C, s: Float) -> C {\n  C(z.re *. s, z.im *. s)\n}\n\nfn c_mul(z: C, w: C) -> C {\n  C(z.re *. w.re -. z.im *. w.im, z.re *. w.im +. z.im *. w.re)\n}\n\nfn c_abs(z: C) -> Float {\n  float.square_root(z.re *. z.re +. z.im *. z.im)\n  |> result_or_zero\n}\n\nfn result_or_zero(r: Result(Float, Nil)) -> Float {\n  case r {\n    Ok(v) -> v\n    Error(Nil) -> 0.0\n  }\n}\n\nfn c_inv(z: C) -> Result(C, Nil) {\n  let n = z.re *. z.re +. z.im *. z.im\n  // Gap only at the pole; large |1/z| is clamped to the viewport edge.\n  case n <. 0.0025 {\n    True -> Error(Nil)\n    False -> Ok(C(z.re /. n, 0.0 -. z.im /. n))\n  }\n}\n\nfn c_exp(z: C) -> C {\n  let ex = float.exponential(z.re)\n  C(ex *. js_cos(z.im), ex *. js_sin(z.im))\n}\n\nfn sinh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e -. inv } /. 2.0\n}\n\nfn cosh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e +. inv } /. 2.0\n}\n\nfn c_sin(z: C) -> C {\n  C(js_sin(z.re) *. cosh(z.im), js_cos(z.re) *. sinh(z.im))\n}\n\nfn c_cos(z: C) -> C {\n  C(js_cos(z.re) *. cosh(z.im), 0.0 -. js_sin(z.re) *. sinh(z.im))\n}\n\nfn c_sqrt(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.0001 {\n    True -> Ok(C(0.0, 0.0))\n    False -> {\n      let theta = js_atan2(z.im, z.re)\n      let half = theta /. 2.0\n      case float.square_root(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(root) -> Ok(C(root *. js_cos(half), root *. js_sin(half)))\n      }\n    }\n  }\n}\n\nfn c_log(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.01 {\n    True -> Error(Nil)\n    False ->\n      case float.logarithm(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(ln_r) -> Ok(C(ln_r, js_atan2(z.im, z.re)))\n      }\n  }\n}\n\nfn c_pow(z: C, omega: Float) -> Result(C, Nil) {\n  // z^ω = exp(ω Log z)\n  use lg <- result.try(c_log(z))\n  Ok(c_exp(c_scale(lg, omega)))\n}\n\nfn to_world(w: C) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  #(w.re *. scale, 0.0 -. w.im *. scale)\n}\n\nfn paths_from_marks(\n  marks: List(Mark),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  let runs = split_runs(marks, [], [])\n  let n_runs = list.length(runs)\n  let n_f = int.to_float(int.max(n_runs, 1))\n  list.index_map(runs, fn(run, ri) {\n    let t0 = start_base +. int.to_float(ri) /. n_f *. duration\n    let t1 = start_base +. int.to_float(ri + 1) /. n_f *. duration\n    stroke_run(run, t0, t1, thickness)\n  })\n  |> list.flatten\n}\n\nfn split_runs(\n  marks: List(Mark),\n  current: List(Point),\n  acc: List(List(Point)),\n) -> List(List(Point)) {\n  case marks {\n    [] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      list.reverse(acc)\n    }\n    [Break, ..rest] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      split_runs(rest, [], acc)\n    }\n    [Pt(p), ..rest] -> split_runs(rest, [p, ..current], acc)\n  }\n}\n\nfn stroke_run(\n  points: List(Point),\n  t0: Float,\n  t1: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      let span = t1 -. t0\n      do_stroke(a, [b, ..rest], 0, n_f, t0, span, thickness, [])\n    }\n  }\n}\n\nfn do_stroke(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  t0: Float,\n  span: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 120.0 {\n        True -> acc\n        False -> {\n          let s0 = t0 +. int.to_float(i) /. n_f *. span\n          let s1 = t0 +. int.to_float(i + 1) /. n_f *. span\n          [Path(Line(prev, next), s0, s1, thickness), ..acc]\n        }\n      }\n      do_stroke(next, tail, i + 1, n_f, t0, span, thickness, acc)\n    }\n  }\n}\n","new_content_size":18373,"new_hash":"a8964b7e292a9dbb57defef572c069991f645b214765e4cfe1630b4a89a12be3","old_hash":"40bd36ddfd1c72300f1f9427370652bdf2354f1db44941f2f50bd2dc4a1dd4df","operation":"modify","path":"src/complex_math.gleam"},"hash":"f7d690f396753af1c621b8f7ea360d33b2a9a0d1831b002a7044daf021aee162","kind":"fs.external_change","prev_hash":"add595bbf3c2fce26880d8bc873bfdd89c211e7c1c1de6db12f5b7b973b7964f","seq":396,"t":5985358,"wall":"2026-11-25T22:44:46.618Z"}
{"data":{"diff_size":34,"new_content":"//// Complex / Polar submodes of Math on the Argand plane (Re / Im).\n//// — Complex maps: grid → w = a · f(ω(z − b))\n//// — Polar curves: r(θ) drawn on the same plane (calc-class classics + spirals)\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport math.{type Plot, Plot}\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan2\")\nfn js_atan2(y: Float, x: Float) -> Float\n\n/// Maps ℂ→ℂ (Complex tab) and polar r(θ) curves (Polar tab).\npub type ComplexFn {\n  // ── Complex maps (grid images) ───────────────────────────────────────────\n  Identity\n  Square\n  Cube\n  Reciprocal\n  Conjugate\n  Exp\n  Sin\n  Cos\n  Sqrt\n  Log\n  /// w = z^ω via exp(ω Log z)\n  Power\n  Modulus\n  Arg\n  /// Unit circle e^{iθ} with Create-swept tangent sticks i·e^{iθ}.\n  ExpITheta\n  // ── Polar curves on the Argand plane ─────────────────────────────────────\n  /// |z − b| = |a| — circle centered on the Re axis.\n  Circle\n  /// r = 2a cos θ — circle diameter on the Re axis (calc classic).\n  CircleCos\n  /// r = 2a sin θ — circle diameter on the Im axis (calc classic).\n  CircleSin\n  ArchimedesSpiral\n  LogSpiral\n  RoseCos\n  RoseSin\n  Cardioid\n  Limacon\n  Lemniscate\n}\n\npub type C {\n  C(re: Float, im: Float)\n}\n\n/// Axes + integer ticks (same layout count as real math mode).\npub const decoration_count = 18\n\nconst world_half = 450.0\n\nconst x_math_max = 5.0\n\nconst y_clip = 480.0\n\nconst domain_min = -2.0\n\nconst domain_max = 2.0\n\nconst samples_per_line = 72\n\nconst polar_samples = 360\n\nconst pi = 3.141592653589793\n\n/// Sampling mark: drawable point or explicit break at domain / asymptote gaps.\ntype Mark {\n  Pt(Point)\n  Break\n}\n\npub fn fn_id(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w=z\"\n    Square -> \"w=z^2\"\n    Cube -> \"w=z^3\"\n    Reciprocal -> \"w=1/z\"\n    Conjugate -> \"w=conj(z)\"\n    Exp -> \"w=exp(z)\"\n    Sin -> \"w=sin(z)\"\n    Cos -> \"w=cos(z)\"\n    Sqrt -> \"w=sqrt(z)\"\n    Log -> \"w=log(z)\"\n    Power -> \"w=z^w\"\n    Modulus -> \"w=|z|\"\n    Arg -> \"w=arg(z)\"\n    ExpITheta -> \"w=exp(i*theta)\"\n    Circle -> \"r=a\"\n    CircleCos -> \"r=2a*cos(theta)\"\n    CircleSin -> \"r=2a*sin(theta)\"\n    ArchimedesSpiral -> \"r=a*theta\"\n    LogSpiral -> \"r=a*e^(k*theta)\"\n    RoseCos -> \"r=a*cos(n*theta)\"\n    RoseSin -> \"r=a*sin(n*theta)\"\n    Cardioid -> \"r=a*(1-cos(theta))\"\n    Limacon -> \"r=a+cos(theta)\"\n    Lemniscate -> \"r^2=a^2*cos(2*theta)\"\n  }\n}\n\npub fn fn_label(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w = z\"\n    Square -> \"w = z²\"\n    Cube -> \"w = z³\"\n    Reciprocal -> \"w = 1/z\"\n    Conjugate -> \"w = z̄\"\n    Exp -> \"w = exp(z)\"\n    Sin -> \"w = sin(z)\"\n    Cos -> \"w = cos(z)\"\n    Sqrt -> \"w = √z\"\n    Log -> \"w = Log(z)\"\n    Power -> \"w = z^ω\"\n    Modulus -> \"w = |z|\"\n    Arg -> \"w = Arg(z)\"\n    Circle -> \"|z − b| = |a|  (circle)\"\n    CircleCos -> \"r = 2a cos θ  (circle)\"\n    CircleSin -> \"r = 2a sin θ  (circle)\"\n    ArchimedesSpiral -> \"r = aθ  (Archimedes)\"\n    LogSpiral -> \"r = a e^{kθ}  (log spiral)\"\n    RoseCos -> \"r = a cos(ωθ)  (rose)\"\n    RoseSin -> \"r = a sin(ωθ)  (rose)\"\n    Cardioid -> \"r = a(1 − cos θ)  (cardioid)\"\n    Limacon -> \"r = a + cos θ  (limaçon)\"\n    Lemniscate -> \"r² = a² cos(ωθ)  (lemniscate)\"\n  }\n}\n\n/// Complex-tab presets (grid maps only).\npub fn all_map_functions() -> List(ComplexFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Reciprocal,\n    Conjugate,\n    Exp,\n    Sin,\n    Cos,\n    Sqrt,\n    Log,\n    Power,\n    Modulus,\n    Arg,\n  ]\n}\n\n/// Polar-tab presets (r(θ) curves on the Argand plane).\npub fn all_polar_functions() -> List(ComplexFn) {\n  [\n    Circle,\n    CircleCos,\n    CircleSin,\n    ArchimedesSpiral,\n    LogSpiral,\n    RoseCos,\n    RoseSin,\n    Cardioid,\n    Limacon,\n    Lemniscate,\n  ]\n}\n\npub fn all_functions() -> List(ComplexFn) {\n  list.append(all_map_functions(), all_polar_functions())\n}\n\npub fn parse_fn_id(id: String) -> ComplexFn {\n  case id {\n    \"w=z\" -> Identity\n    \"w=z^2\" -> Square\n    \"w=z^3\" -> Cube\n    \"w=1/z\" -> Reciprocal\n    \"w=conj(z)\" -> Conjugate\n    \"w=exp(z)\" -> Exp\n    \"w=sin(z)\" -> Sin\n    \"w=cos(z)\" -> Cos\n    \"w=sqrt(z)\" -> Sqrt\n    \"w=log(z)\" -> Log\n    \"w=z^w\" -> Power\n    \"w=|z|\" -> Modulus\n    \"w=arg(z)\" -> Arg\n    \"r=a\" -> Circle\n    \"r=1\" -> Circle\n    \"r=2a*cos(theta)\" -> CircleCos\n    \"r=2a*sin(theta)\" -> CircleSin\n    \"r=a*theta\" -> ArchimedesSpiral\n    \"r=a*e^(k*theta)\" -> LogSpiral\n    \"r=a*cos(n*theta)\" -> RoseCos\n    \"r=a*sin(n*theta)\" -> RoseSin\n    \"r=a*(1-cos(theta))\" -> Cardioid\n    \"r=a+cos(theta)\" -> Limacon\n    \"r=a+b*cos(theta)\" -> Limacon\n    \"r^2=a^2*cos(2*theta)\" -> Lemniscate\n    _ -> Identity\n  }\n}\n\npub fn is_polar(f: ComplexFn) -> Bool {\n  case f {\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// ω: maps (exp/sin/cos/power) and polar roses / spirals / lemniscate petals.\npub fn uses_omega(f: ComplexFn) -> Bool {\n  case f {\n    Exp | Sin | Cos | Power -> True\n    ArchimedesSpiral | LogSpiral | RoseCos | RoseSin | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// Stroke color: axes muted; images of horizontal lines teal; vertical magenta.\n/// Polar curves use teal only (horizontal_count covers all curve paths).\npub fn path_color(index: Int, horizontal_count: Int) -> String {\n  case index < decoration_count {\n    True -> \"#8a8aaa\"\n    False -> {\n      let j = index - decoration_count\n      case j < horizontal_count {\n        True -> \"#58C4DD\"\n        False -> \"#C77DFF\"\n      }\n    }\n  }\n}\n\npub fn plot(f: ComplexFn, a: Int, omega: Int, b: Int) -> #(Plot, Int) {\n  let a_f = int.to_float(int.clamp(a, -5, 5))\n  let w_f = int.to_float(int.clamp(omega, 1, 10))\n  let b_f = int.to_float(int.clamp(b, -5, 5))\n  let #(axis_paths, labels) = argand_decorations()\n  case is_polar(f) {\n    True -> {\n      let curves = polar_plot(f, a_f, w_f, b_f)\n      let n = list.length(curves)\n      #(Plot(list.append(axis_paths, curves), labels, []), n)\n    }\n    False -> {\n      let #(horiz, vert) = mapped_grid(f, a_f, w_f, b_f)\n      let horiz_n = list.length(horiz)\n      #(Plot(list.flatten([axis_paths, horiz, vert]), labels, []), horiz_n)\n    }\n  }\n}\n\nfn argand_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n\n  let re_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      0.0,\n      8.0,\n      axis_t,\n    )\n  let im_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      4.0,\n      12.0,\n      axis_t,\n    )\n\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let re_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let im_ticks =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let re_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        math_to_world(int.to_float(k)),\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let im_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        0.0 -. 28.0,\n        0.0 -. math_to_world(int.to_float(k)),\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let paths = list.flatten([[re_axis, im_axis], re_ticks, im_ticks])\n  let labels = list.flatten([re_labels, im_labels])\n  #(paths, labels)\n}\n\nfn math_to_world(t: Float) -> Float {\n  t *. { world_half /. x_math_max }\n}\n\n// ── Polar curves ─────────────────────────────────────────────────────────────\n\nfn polar_plot(f: ComplexFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let amp = case float.absolute_value(a) <. 0.01 {\n    True -> 1.0\n    False -> float.absolute_value(a)\n  }\n  let marks =\n    list.repeat(Nil, polar_samples + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(polar_samples)\n      case polar_point(f, t, amp, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, 14.0, 40.0, 3.0)\n}\n\n/// t ∈ [0,1] parameter along the polar sweep.\n/// All curves are translated by b along Re after (r, θ) → ℂ.\nfn polar_point(\n  f: ComplexFn,\n  t: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  case f {\n    Circle -> {\n      // |z − b| = a  (center on Re axis at b)\n      let theta = t *. 2.0 *. pi\n      Ok(from_polar(a, theta, b))\n    }\n    CircleCos -> {\n      // r = 2a cos θ — diameter [0, 2a] on Re, then shift by b\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    CircleSin -> {\n      // r = 2a sin θ — diameter on Im, then shift by b along Re\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_sin(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    ArchimedesSpiral -> {\n      // θ ∈ [0, 2πω]; r = (a/8) θ  — more turns with larger ω\n      let theta = t *. 2.0 *. pi *. omega\n      let r = { a /. 8.0 } *. theta\n      Ok(from_polar(r, theta, b))\n    }\n    LogSpiral -> {\n      let theta = t *. 2.0 *. pi *. omega\n      let k = 0.12\n      let r = { a /. 3.0 } *. float.exponential(k *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseCos -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_cos(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseSin -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_sin(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Cardioid -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. { 1.0 -. js_cos(theta) }\n      Ok(from_polar(r, theta, b))\n    }\n    Limacon -> {\n      // Classic dimpled/looped limaçon: r = a + cos θ\n      let theta = t *. 2.0 *. pi\n      let r = a +. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Lemniscate -> {\n      // r² = a² cos(ωθ); classic figure-eight uses ω = 2\n      let theta = t *. 2.0 *. pi\n      let c = js_cos(omega *. theta)\n      case c <. 0.0 {\n        True -> Error(Nil)\n        False ->\n          case float.square_root(a *. a *. c) {\n            Error(Nil) -> Error(Nil)\n            Ok(r) -> Ok(from_polar(r, theta, b))\n          }\n      }\n    }\n    _ -> Error(Nil)\n  }\n}\n\nfn from_polar(r: Float, theta: Float, b_re: Float) -> C {\n  C(r *. js_cos(theta) +. b_re, r *. js_sin(theta))\n}\n\n/// Clamp runaway images to the viewport edge, then break so asymptotes don't bridge.\nfn world_marks(w: C) -> List(Mark) {\n  let #(wx0, wy0) = to_world(w)\n  let ax = float.absolute_value(wx0)\n  let ay = float.absolute_value(wy0)\n  let m = case ax >. ay {\n    True -> ax\n    False -> ay\n  }\n  case m >. y_clip {\n    True -> {\n      let s = y_clip /. m\n      [Pt(Point(wx0 *. s, wy0 *. s)), Break]\n    }\n    False -> [Pt(Point(wx0, wy0))]\n  }\n}\n\n// ── Grid maps ────────────────────────────────────────────────────────────────\n\nfn mapped_grid(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> #(List(Path), List(Path)) {\n  let levels = [-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]\n  let horiz =\n    list.index_map(levels, fn(im, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        True,\n        im,\n        domain_min,\n        domain_max,\n        14.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  let vert =\n    list.index_map(levels, fn(re, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        False,\n        re,\n        domain_min,\n        domain_max,\n        26.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  #(horiz, vert)\n}\n\nfn sample_line(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  horizontal: Bool,\n  fixed: Float,\n  varying_min: Float,\n  varying_max: Float,\n  start_base: Float,\n) -> List(Path) {\n  let marks =\n    list.repeat(Nil, samples_per_line + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(samples_per_line)\n      let varying = varying_min +. t *. { varying_max -. varying_min }\n      let z = case horizontal {\n        True -> C(varying, fixed)\n        False -> C(fixed, varying)\n      }\n      case apply_map(f, z, a, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, start_base, 10.0, 2.2)\n}\n\nfn apply_map(\n  f: ComplexFn,\n  z: C,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  // Input shift on the Re axis: f(z − b), then optional ω scaling, then a·w.\n  let shifted = C(z.re -. b, z.im)\n  let scaled_in = case f {\n    Exp | Sin | Cos | Power -> c_scale(shifted, omega)\n    _ -> shifted\n  }\n  use w <- result.try(eval(f, scaled_in, omega))\n  Ok(c_scale(w, a))\n}\n\nfn eval(f: ComplexFn, z: C, omega: Float) -> Result(C, Nil) {\n  case f {\n    Identity -> Ok(z)\n    Square -> Ok(c_mul(z, z))\n    Cube -> Ok(c_mul(c_mul(z, z), z))\n    Reciprocal -> c_inv(z)\n    Conjugate -> Ok(C(z.re, 0.0 -. z.im))\n    Exp -> Ok(c_exp(z))\n    Sin -> Ok(c_sin(z))\n    Cos -> Ok(c_cos(z))\n    Sqrt -> c_sqrt(z)\n    Log -> c_log(z)\n    Power -> c_pow(z, omega)\n    Modulus -> Ok(C(c_abs(z), 0.0))\n    Arg -> Ok(C(js_atan2(z.im, z.re), 0.0))\n    // Polar variants never reach eval.\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> Error(Nil)\n  }\n}\n\nfn c_scale(z: C, s: Float) -> C {\n  C(z.re *. s, z.im *. s)\n}\n\nfn c_mul(z: C, w: C) -> C {\n  C(z.re *. w.re -. z.im *. w.im, z.re *. w.im +. z.im *. w.re)\n}\n\nfn c_abs(z: C) -> Float {\n  float.square_root(z.re *. z.re +. z.im *. z.im)\n  |> result_or_zero\n}\n\nfn result_or_zero(r: Result(Float, Nil)) -> Float {\n  case r {\n    Ok(v) -> v\n    Error(Nil) -> 0.0\n  }\n}\n\nfn c_inv(z: C) -> Result(C, Nil) {\n  let n = z.re *. z.re +. z.im *. z.im\n  // Gap only at the pole; large |1/z| is clamped to the viewport edge.\n  case n <. 0.0025 {\n    True -> Error(Nil)\n    False -> Ok(C(z.re /. n, 0.0 -. z.im /. n))\n  }\n}\n\nfn c_exp(z: C) -> C {\n  let ex = float.exponential(z.re)\n  C(ex *. js_cos(z.im), ex *. js_sin(z.im))\n}\n\nfn sinh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e -. inv } /. 2.0\n}\n\nfn cosh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e +. inv } /. 2.0\n}\n\nfn c_sin(z: C) -> C {\n  C(js_sin(z.re) *. cosh(z.im), js_cos(z.re) *. sinh(z.im))\n}\n\nfn c_cos(z: C) -> C {\n  C(js_cos(z.re) *. cosh(z.im), 0.0 -. js_sin(z.re) *. sinh(z.im))\n}\n\nfn c_sqrt(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.0001 {\n    True -> Ok(C(0.0, 0.0))\n    False -> {\n      let theta = js_atan2(z.im, z.re)\n      let half = theta /. 2.0\n      case float.square_root(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(root) -> Ok(C(root *. js_cos(half), root *. js_sin(half)))\n      }\n    }\n  }\n}\n\nfn c_log(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.01 {\n    True -> Error(Nil)\n    False ->\n      case float.logarithm(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(ln_r) -> Ok(C(ln_r, js_atan2(z.im, z.re)))\n      }\n  }\n}\n\nfn c_pow(z: C, omega: Float) -> Result(C, Nil) {\n  // z^ω = exp(ω Log z)\n  use lg <- result.try(c_log(z))\n  Ok(c_exp(c_scale(lg, omega)))\n}\n\nfn to_world(w: C) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  #(w.re *. scale, 0.0 -. w.im *. scale)\n}\n\nfn paths_from_marks(\n  marks: List(Mark),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  let runs = split_runs(marks, [], [])\n  let n_runs = list.length(runs)\n  let n_f = int.to_float(int.max(n_runs, 1))\n  list.index_map(runs, fn(run, ri) {\n    let t0 = start_base +. int.to_float(ri) /. n_f *. duration\n    let t1 = start_base +. int.to_float(ri + 1) /. n_f *. duration\n    stroke_run(run, t0, t1, thickness)\n  })\n  |> list.flatten\n}\n\nfn split_runs(\n  marks: List(Mark),\n  current: List(Point),\n  acc: List(List(Point)),\n) -> List(List(Point)) {\n  case marks {\n    [] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      list.reverse(acc)\n    }\n    [Break, ..rest] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      split_runs(rest, [], acc)\n    }\n    [Pt(p), ..rest] -> split_runs(rest, [p, ..current], acc)\n  }\n}\n\nfn stroke_run(\n  points: List(Point),\n  t0: Float,\n  t1: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      let span = t1 -. t0\n      do_stroke(a, [b, ..rest], 0, n_f, t0, span, thickness, [])\n    }\n  }\n}\n\nfn do_stroke(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  t0: Float,\n  span: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 120.0 {\n        True -> acc\n        False -> {\n          let s0 = t0 +. int.to_float(i) /. n_f *. span\n          let s1 = t0 +. int.to_float(i + 1) /. n_f *. span\n          [Path(Line(prev, next), s0, s1, thickness), ..acc]\n        }\n      }\n      do_stroke(next, tail, i + 1, n_f, t0, span, thickness, acc)\n    }\n  }\n}\n","new_content_size":18407,"new_hash":"f41d9341a9102b849dca736458cd0924adb0d0fb14568fe3b506e682d5c4ebef","old_hash":"a8964b7e292a9dbb57defef572c069991f645b214765e4cfe1630b4a89a12be3","operation":"modify","path":"src/complex_math.gleam"},"hash":"78551d6960b1e952dc2472d3267e17ad41d07bbb1681b39871b741a963562f48","kind":"fs.external_change","prev_hash":"f7d690f396753af1c621b8f7ea360d33b2a9a0d1831b002a7044daf021aee162","seq":397,"t":5986454,"wall":"2026-11-25T22:44:47.715Z"}
{"data":{"diff_size":47,"new_content":"//// Complex / Polar submodes of Math on the Argand plane (Re / Im).\n//// — Complex maps: grid → w = a · f(ω(z − b))\n//// — Polar curves: r(θ) drawn on the same plane (calc-class classics + spirals)\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport math.{type Plot, Plot}\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan2\")\nfn js_atan2(y: Float, x: Float) -> Float\n\n/// Maps ℂ→ℂ (Complex tab) and polar r(θ) curves (Polar tab).\npub type ComplexFn {\n  // ── Complex maps (grid images) ───────────────────────────────────────────\n  Identity\n  Square\n  Cube\n  Reciprocal\n  Conjugate\n  Exp\n  Sin\n  Cos\n  Sqrt\n  Log\n  /// w = z^ω via exp(ω Log z)\n  Power\n  Modulus\n  Arg\n  /// Unit circle e^{iθ} with Create-swept tangent sticks i·e^{iθ}.\n  ExpITheta\n  // ── Polar curves on the Argand plane ─────────────────────────────────────\n  /// |z − b| = |a| — circle centered on the Re axis.\n  Circle\n  /// r = 2a cos θ — circle diameter on the Re axis (calc classic).\n  CircleCos\n  /// r = 2a sin θ — circle diameter on the Im axis (calc classic).\n  CircleSin\n  ArchimedesSpiral\n  LogSpiral\n  RoseCos\n  RoseSin\n  Cardioid\n  Limacon\n  Lemniscate\n}\n\npub type C {\n  C(re: Float, im: Float)\n}\n\n/// Axes + integer ticks (same layout count as real math mode).\npub const decoration_count = 18\n\nconst world_half = 450.0\n\nconst x_math_max = 5.0\n\nconst y_clip = 480.0\n\nconst domain_min = -2.0\n\nconst domain_max = 2.0\n\nconst samples_per_line = 72\n\nconst polar_samples = 360\n\nconst pi = 3.141592653589793\n\n/// Sampling mark: drawable point or explicit break at domain / asymptote gaps.\ntype Mark {\n  Pt(Point)\n  Break\n}\n\npub fn fn_id(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w=z\"\n    Square -> \"w=z^2\"\n    Cube -> \"w=z^3\"\n    Reciprocal -> \"w=1/z\"\n    Conjugate -> \"w=conj(z)\"\n    Exp -> \"w=exp(z)\"\n    Sin -> \"w=sin(z)\"\n    Cos -> \"w=cos(z)\"\n    Sqrt -> \"w=sqrt(z)\"\n    Log -> \"w=log(z)\"\n    Power -> \"w=z^w\"\n    Modulus -> \"w=|z|\"\n    Arg -> \"w=arg(z)\"\n    ExpITheta -> \"w=exp(i*theta)\"\n    Circle -> \"r=a\"\n    CircleCos -> \"r=2a*cos(theta)\"\n    CircleSin -> \"r=2a*sin(theta)\"\n    ArchimedesSpiral -> \"r=a*theta\"\n    LogSpiral -> \"r=a*e^(k*theta)\"\n    RoseCos -> \"r=a*cos(n*theta)\"\n    RoseSin -> \"r=a*sin(n*theta)\"\n    Cardioid -> \"r=a*(1-cos(theta))\"\n    Limacon -> \"r=a+cos(theta)\"\n    Lemniscate -> \"r^2=a^2*cos(2*theta)\"\n  }\n}\n\npub fn fn_label(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w = z\"\n    Square -> \"w = z²\"\n    Cube -> \"w = z³\"\n    Reciprocal -> \"w = 1/z\"\n    Conjugate -> \"w = z̄\"\n    Exp -> \"w = exp(z)\"\n    Sin -> \"w = sin(z)\"\n    Cos -> \"w = cos(z)\"\n    Sqrt -> \"w = √z\"\n    Log -> \"w = Log(z)\"\n    Power -> \"w = z^ω\"\n    Modulus -> \"w = |z|\"\n    Arg -> \"w = Arg(z)\"\n    ExpITheta -> \"w = e^{iθ}  (tangent sweep)\"\n    Circle -> \"|z − b| = |a|  (circle)\"\n    CircleCos -> \"r = 2a cos θ  (circle)\"\n    CircleSin -> \"r = 2a sin θ  (circle)\"\n    ArchimedesSpiral -> \"r = aθ  (Archimedes)\"\n    LogSpiral -> \"r = a e^{kθ}  (log spiral)\"\n    RoseCos -> \"r = a cos(ωθ)  (rose)\"\n    RoseSin -> \"r = a sin(ωθ)  (rose)\"\n    Cardioid -> \"r = a(1 − cos θ)  (cardioid)\"\n    Limacon -> \"r = a + cos θ  (limaçon)\"\n    Lemniscate -> \"r² = a² cos(ωθ)  (lemniscate)\"\n  }\n}\n\n/// Complex-tab presets (grid maps only).\npub fn all_map_functions() -> List(ComplexFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Reciprocal,\n    Conjugate,\n    Exp,\n    Sin,\n    Cos,\n    Sqrt,\n    Log,\n    Power,\n    Modulus,\n    Arg,\n  ]\n}\n\n/// Polar-tab presets (r(θ) curves on the Argand plane).\npub fn all_polar_functions() -> List(ComplexFn) {\n  [\n    Circle,\n    CircleCos,\n    CircleSin,\n    ArchimedesSpiral,\n    LogSpiral,\n    RoseCos,\n    RoseSin,\n    Cardioid,\n    Limacon,\n    Lemniscate,\n  ]\n}\n\npub fn all_functions() -> List(ComplexFn) {\n  list.append(all_map_functions(), all_polar_functions())\n}\n\npub fn parse_fn_id(id: String) -> ComplexFn {\n  case id {\n    \"w=z\" -> Identity\n    \"w=z^2\" -> Square\n    \"w=z^3\" -> Cube\n    \"w=1/z\" -> Reciprocal\n    \"w=conj(z)\" -> Conjugate\n    \"w=exp(z)\" -> Exp\n    \"w=sin(z)\" -> Sin\n    \"w=cos(z)\" -> Cos\n    \"w=sqrt(z)\" -> Sqrt\n    \"w=log(z)\" -> Log\n    \"w=z^w\" -> Power\n    \"w=|z|\" -> Modulus\n    \"w=arg(z)\" -> Arg\n    \"r=a\" -> Circle\n    \"r=1\" -> Circle\n    \"r=2a*cos(theta)\" -> CircleCos\n    \"r=2a*sin(theta)\" -> CircleSin\n    \"r=a*theta\" -> ArchimedesSpiral\n    \"r=a*e^(k*theta)\" -> LogSpiral\n    \"r=a*cos(n*theta)\" -> RoseCos\n    \"r=a*sin(n*theta)\" -> RoseSin\n    \"r=a*(1-cos(theta))\" -> Cardioid\n    \"r=a+cos(theta)\" -> Limacon\n    \"r=a+b*cos(theta)\" -> Limacon\n    \"r^2=a^2*cos(2*theta)\" -> Lemniscate\n    _ -> Identity\n  }\n}\n\npub fn is_polar(f: ComplexFn) -> Bool {\n  case f {\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// ω: maps (exp/sin/cos/power) and polar roses / spirals / lemniscate petals.\npub fn uses_omega(f: ComplexFn) -> Bool {\n  case f {\n    Exp | Sin | Cos | Power -> True\n    ArchimedesSpiral | LogSpiral | RoseCos | RoseSin | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// Stroke color: axes muted; images of horizontal lines teal; vertical magenta.\n/// Polar curves use teal only (horizontal_count covers all curve paths).\npub fn path_color(index: Int, horizontal_count: Int) -> String {\n  case index < decoration_count {\n    True -> \"#8a8aaa\"\n    False -> {\n      let j = index - decoration_count\n      case j < horizontal_count {\n        True -> \"#58C4DD\"\n        False -> \"#C77DFF\"\n      }\n    }\n  }\n}\n\npub fn plot(f: ComplexFn, a: Int, omega: Int, b: Int) -> #(Plot, Int) {\n  let a_f = int.to_float(int.clamp(a, -5, 5))\n  let w_f = int.to_float(int.clamp(omega, 1, 10))\n  let b_f = int.to_float(int.clamp(b, -5, 5))\n  let #(axis_paths, labels) = argand_decorations()\n  case is_polar(f) {\n    True -> {\n      let curves = polar_plot(f, a_f, w_f, b_f)\n      let n = list.length(curves)\n      #(Plot(list.append(axis_paths, curves), labels, []), n)\n    }\n    False -> {\n      let #(horiz, vert) = mapped_grid(f, a_f, w_f, b_f)\n      let horiz_n = list.length(horiz)\n      #(Plot(list.flatten([axis_paths, horiz, vert]), labels, []), horiz_n)\n    }\n  }\n}\n\nfn argand_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n\n  let re_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      0.0,\n      8.0,\n      axis_t,\n    )\n  let im_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      4.0,\n      12.0,\n      axis_t,\n    )\n\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let re_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let im_ticks =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let re_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        math_to_world(int.to_float(k)),\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let im_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        0.0 -. 28.0,\n        0.0 -. math_to_world(int.to_float(k)),\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let paths = list.flatten([[re_axis, im_axis], re_ticks, im_ticks])\n  let labels = list.flatten([re_labels, im_labels])\n  #(paths, labels)\n}\n\nfn math_to_world(t: Float) -> Float {\n  t *. { world_half /. x_math_max }\n}\n\n// ── Polar curves ─────────────────────────────────────────────────────────────\n\nfn polar_plot(f: ComplexFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let amp = case float.absolute_value(a) <. 0.01 {\n    True -> 1.0\n    False -> float.absolute_value(a)\n  }\n  let marks =\n    list.repeat(Nil, polar_samples + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(polar_samples)\n      case polar_point(f, t, amp, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, 14.0, 40.0, 3.0)\n}\n\n/// t ∈ [0,1] parameter along the polar sweep.\n/// All curves are translated by b along Re after (r, θ) → ℂ.\nfn polar_point(\n  f: ComplexFn,\n  t: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  case f {\n    Circle -> {\n      // |z − b| = a  (center on Re axis at b)\n      let theta = t *. 2.0 *. pi\n      Ok(from_polar(a, theta, b))\n    }\n    CircleCos -> {\n      // r = 2a cos θ — diameter [0, 2a] on Re, then shift by b\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    CircleSin -> {\n      // r = 2a sin θ — diameter on Im, then shift by b along Re\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_sin(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    ArchimedesSpiral -> {\n      // θ ∈ [0, 2πω]; r = (a/8) θ  — more turns with larger ω\n      let theta = t *. 2.0 *. pi *. omega\n      let r = { a /. 8.0 } *. theta\n      Ok(from_polar(r, theta, b))\n    }\n    LogSpiral -> {\n      let theta = t *. 2.0 *. pi *. omega\n      let k = 0.12\n      let r = { a /. 3.0 } *. float.exponential(k *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseCos -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_cos(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseSin -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_sin(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Cardioid -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. { 1.0 -. js_cos(theta) }\n      Ok(from_polar(r, theta, b))\n    }\n    Limacon -> {\n      // Classic dimpled/looped limaçon: r = a + cos θ\n      let theta = t *. 2.0 *. pi\n      let r = a +. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Lemniscate -> {\n      // r² = a² cos(ωθ); classic figure-eight uses ω = 2\n      let theta = t *. 2.0 *. pi\n      let c = js_cos(omega *. theta)\n      case c <. 0.0 {\n        True -> Error(Nil)\n        False ->\n          case float.square_root(a *. a *. c) {\n            Error(Nil) -> Error(Nil)\n            Ok(r) -> Ok(from_polar(r, theta, b))\n          }\n      }\n    }\n    _ -> Error(Nil)\n  }\n}\n\nfn from_polar(r: Float, theta: Float, b_re: Float) -> C {\n  C(r *. js_cos(theta) +. b_re, r *. js_sin(theta))\n}\n\n/// Clamp runaway images to the viewport edge, then break so asymptotes don't bridge.\nfn world_marks(w: C) -> List(Mark) {\n  let #(wx0, wy0) = to_world(w)\n  let ax = float.absolute_value(wx0)\n  let ay = float.absolute_value(wy0)\n  let m = case ax >. ay {\n    True -> ax\n    False -> ay\n  }\n  case m >. y_clip {\n    True -> {\n      let s = y_clip /. m\n      [Pt(Point(wx0 *. s, wy0 *. s)), Break]\n    }\n    False -> [Pt(Point(wx0, wy0))]\n  }\n}\n\n// ── Grid maps ────────────────────────────────────────────────────────────────\n\nfn mapped_grid(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> #(List(Path), List(Path)) {\n  let levels = [-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]\n  let horiz =\n    list.index_map(levels, fn(im, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        True,\n        im,\n        domain_min,\n        domain_max,\n        14.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  let vert =\n    list.index_map(levels, fn(re, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        False,\n        re,\n        domain_min,\n        domain_max,\n        26.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  #(horiz, vert)\n}\n\nfn sample_line(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  horizontal: Bool,\n  fixed: Float,\n  varying_min: Float,\n  varying_max: Float,\n  start_base: Float,\n) -> List(Path) {\n  let marks =\n    list.repeat(Nil, samples_per_line + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(samples_per_line)\n      let varying = varying_min +. t *. { varying_max -. varying_min }\n      let z = case horizontal {\n        True -> C(varying, fixed)\n        False -> C(fixed, varying)\n      }\n      case apply_map(f, z, a, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, start_base, 10.0, 2.2)\n}\n\nfn apply_map(\n  f: ComplexFn,\n  z: C,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  // Input shift on the Re axis: f(z − b), then optional ω scaling, then a·w.\n  let shifted = C(z.re -. b, z.im)\n  let scaled_in = case f {\n    Exp | Sin | Cos | Power -> c_scale(shifted, omega)\n    _ -> shifted\n  }\n  use w <- result.try(eval(f, scaled_in, omega))\n  Ok(c_scale(w, a))\n}\n\nfn eval(f: ComplexFn, z: C, omega: Float) -> Result(C, Nil) {\n  case f {\n    Identity -> Ok(z)\n    Square -> Ok(c_mul(z, z))\n    Cube -> Ok(c_mul(c_mul(z, z), z))\n    Reciprocal -> c_inv(z)\n    Conjugate -> Ok(C(z.re, 0.0 -. z.im))\n    Exp -> Ok(c_exp(z))\n    Sin -> Ok(c_sin(z))\n    Cos -> Ok(c_cos(z))\n    Sqrt -> c_sqrt(z)\n    Log -> c_log(z)\n    Power -> c_pow(z, omega)\n    Modulus -> Ok(C(c_abs(z), 0.0))\n    Arg -> Ok(C(js_atan2(z.im, z.re), 0.0))\n    // Polar variants never reach eval.\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> Error(Nil)\n  }\n}\n\nfn c_scale(z: C, s: Float) -> C {\n  C(z.re *. s, z.im *. s)\n}\n\nfn c_mul(z: C, w: C) -> C {\n  C(z.re *. w.re -. z.im *. w.im, z.re *. w.im +. z.im *. w.re)\n}\n\nfn c_abs(z: C) -> Float {\n  float.square_root(z.re *. z.re +. z.im *. z.im)\n  |> result_or_zero\n}\n\nfn result_or_zero(r: Result(Float, Nil)) -> Float {\n  case r {\n    Ok(v) -> v\n    Error(Nil) -> 0.0\n  }\n}\n\nfn c_inv(z: C) -> Result(C, Nil) {\n  let n = z.re *. z.re +. z.im *. z.im\n  // Gap only at the pole; large |1/z| is clamped to the viewport edge.\n  case n <. 0.0025 {\n    True -> Error(Nil)\n    False -> Ok(C(z.re /. n, 0.0 -. z.im /. n))\n  }\n}\n\nfn c_exp(z: C) -> C {\n  let ex = float.exponential(z.re)\n  C(ex *. js_cos(z.im), ex *. js_sin(z.im))\n}\n\nfn sinh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e -. inv } /. 2.0\n}\n\nfn cosh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e +. inv } /. 2.0\n}\n\nfn c_sin(z: C) -> C {\n  C(js_sin(z.re) *. cosh(z.im), js_cos(z.re) *. sinh(z.im))\n}\n\nfn c_cos(z: C) -> C {\n  C(js_cos(z.re) *. cosh(z.im), 0.0 -. js_sin(z.re) *. sinh(z.im))\n}\n\nfn c_sqrt(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.0001 {\n    True -> Ok(C(0.0, 0.0))\n    False -> {\n      let theta = js_atan2(z.im, z.re)\n      let half = theta /. 2.0\n      case float.square_root(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(root) -> Ok(C(root *. js_cos(half), root *. js_sin(half)))\n      }\n    }\n  }\n}\n\nfn c_log(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.01 {\n    True -> Error(Nil)\n    False ->\n      case float.logarithm(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(ln_r) -> Ok(C(ln_r, js_atan2(z.im, z.re)))\n      }\n  }\n}\n\nfn c_pow(z: C, omega: Float) -> Result(C, Nil) {\n  // z^ω = exp(ω Log z)\n  use lg <- result.try(c_log(z))\n  Ok(c_exp(c_scale(lg, omega)))\n}\n\nfn to_world(w: C) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  #(w.re *. scale, 0.0 -. w.im *. scale)\n}\n\nfn paths_from_marks(\n  marks: List(Mark),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  let runs = split_runs(marks, [], [])\n  let n_runs = list.length(runs)\n  let n_f = int.to_float(int.max(n_runs, 1))\n  list.index_map(runs, fn(run, ri) {\n    let t0 = start_base +. int.to_float(ri) /. n_f *. duration\n    let t1 = start_base +. int.to_float(ri + 1) /. n_f *. duration\n    stroke_run(run, t0, t1, thickness)\n  })\n  |> list.flatten\n}\n\nfn split_runs(\n  marks: List(Mark),\n  current: List(Point),\n  acc: List(List(Point)),\n) -> List(List(Point)) {\n  case marks {\n    [] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      list.reverse(acc)\n    }\n    [Break, ..rest] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      split_runs(rest, [], acc)\n    }\n    [Pt(p), ..rest] -> split_runs(rest, [p, ..current], acc)\n  }\n}\n\nfn stroke_run(\n  points: List(Point),\n  t0: Float,\n  t1: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      let span = t1 -. t0\n      do_stroke(a, [b, ..rest], 0, n_f, t0, span, thickness, [])\n    }\n  }\n}\n\nfn do_stroke(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  t0: Float,\n  span: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 120.0 {\n        True -> acc\n        False -> {\n          let s0 = t0 +. int.to_float(i) /. n_f *. span\n          let s1 = t0 +. int.to_float(i + 1) /. n_f *. span\n          [Path(Line(prev, next), s0, s1, thickness), ..acc]\n        }\n      }\n      do_stroke(next, tail, i + 1, n_f, t0, span, thickness, acc)\n    }\n  }\n}\n","new_content_size":18455,"new_hash":"b482ac220596fda0e93d35286fdf36d603cbbdc15999da2da6458cf00a10c562","old_hash":"f41d9341a9102b849dca736458cd0924adb0d0fb14568fe3b506e682d5c4ebef","operation":"modify","path":"src/complex_math.gleam"},"hash":"b4785bfd07fc603fad85575903684299a23eb9ebb097ec5615305421198aad10","kind":"fs.external_change","prev_hash":"78551d6960b1e952dc2472d3267e17ad41d07bbb1681b39871b741a963562f48","seq":398,"t":5987771,"wall":"2026-11-25T22:44:49.032Z"}
{"data":{"diff_size":15,"new_content":"//// Complex / Polar submodes of Math on the Argand plane (Re / Im).\n//// — Complex maps: grid → w = a · f(ω(z − b))\n//// — Polar curves: r(θ) drawn on the same plane (calc-class classics + spirals)\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport math.{type Plot, Plot}\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan2\")\nfn js_atan2(y: Float, x: Float) -> Float\n\n/// Maps ℂ→ℂ (Complex tab) and polar r(θ) curves (Polar tab).\npub type ComplexFn {\n  // ── Complex maps (grid images) ───────────────────────────────────────────\n  Identity\n  Square\n  Cube\n  Reciprocal\n  Conjugate\n  Exp\n  Sin\n  Cos\n  Sqrt\n  Log\n  /// w = z^ω via exp(ω Log z)\n  Power\n  Modulus\n  Arg\n  /// Unit circle e^{iθ} with Create-swept tangent sticks i·e^{iθ}.\n  ExpITheta\n  // ── Polar curves on the Argand plane ─────────────────────────────────────\n  /// |z − b| = |a| — circle centered on the Re axis.\n  Circle\n  /// r = 2a cos θ — circle diameter on the Re axis (calc classic).\n  CircleCos\n  /// r = 2a sin θ — circle diameter on the Im axis (calc classic).\n  CircleSin\n  ArchimedesSpiral\n  LogSpiral\n  RoseCos\n  RoseSin\n  Cardioid\n  Limacon\n  Lemniscate\n}\n\npub type C {\n  C(re: Float, im: Float)\n}\n\n/// Axes + integer ticks (same layout count as real math mode).\npub const decoration_count = 18\n\nconst world_half = 450.0\n\nconst x_math_max = 5.0\n\nconst y_clip = 480.0\n\nconst domain_min = -2.0\n\nconst domain_max = 2.0\n\nconst samples_per_line = 72\n\nconst polar_samples = 360\n\nconst pi = 3.141592653589793\n\n/// Sampling mark: drawable point or explicit break at domain / asymptote gaps.\ntype Mark {\n  Pt(Point)\n  Break\n}\n\npub fn fn_id(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w=z\"\n    Square -> \"w=z^2\"\n    Cube -> \"w=z^3\"\n    Reciprocal -> \"w=1/z\"\n    Conjugate -> \"w=conj(z)\"\n    Exp -> \"w=exp(z)\"\n    Sin -> \"w=sin(z)\"\n    Cos -> \"w=cos(z)\"\n    Sqrt -> \"w=sqrt(z)\"\n    Log -> \"w=log(z)\"\n    Power -> \"w=z^w\"\n    Modulus -> \"w=|z|\"\n    Arg -> \"w=arg(z)\"\n    ExpITheta -> \"w=exp(i*theta)\"\n    Circle -> \"r=a\"\n    CircleCos -> \"r=2a*cos(theta)\"\n    CircleSin -> \"r=2a*sin(theta)\"\n    ArchimedesSpiral -> \"r=a*theta\"\n    LogSpiral -> \"r=a*e^(k*theta)\"\n    RoseCos -> \"r=a*cos(n*theta)\"\n    RoseSin -> \"r=a*sin(n*theta)\"\n    Cardioid -> \"r=a*(1-cos(theta))\"\n    Limacon -> \"r=a+cos(theta)\"\n    Lemniscate -> \"r^2=a^2*cos(2*theta)\"\n  }\n}\n\npub fn fn_label(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w = z\"\n    Square -> \"w = z²\"\n    Cube -> \"w = z³\"\n    Reciprocal -> \"w = 1/z\"\n    Conjugate -> \"w = z̄\"\n    Exp -> \"w = exp(z)\"\n    Sin -> \"w = sin(z)\"\n    Cos -> \"w = cos(z)\"\n    Sqrt -> \"w = √z\"\n    Log -> \"w = Log(z)\"\n    Power -> \"w = z^ω\"\n    Modulus -> \"w = |z|\"\n    Arg -> \"w = Arg(z)\"\n    ExpITheta -> \"w = e^{iθ}  (tangent sweep)\"\n    Circle -> \"|z − b| = |a|  (circle)\"\n    CircleCos -> \"r = 2a cos θ  (circle)\"\n    CircleSin -> \"r = 2a sin θ  (circle)\"\n    ArchimedesSpiral -> \"r = aθ  (Archimedes)\"\n    LogSpiral -> \"r = a e^{kθ}  (log spiral)\"\n    RoseCos -> \"r = a cos(ωθ)  (rose)\"\n    RoseSin -> \"r = a sin(ωθ)  (rose)\"\n    Cardioid -> \"r = a(1 − cos θ)  (cardioid)\"\n    Limacon -> \"r = a + cos θ  (limaçon)\"\n    Lemniscate -> \"r² = a² cos(ωθ)  (lemniscate)\"\n  }\n}\n\n/// Complex-tab presets (grid maps only).\npub fn all_map_functions() -> List(ComplexFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Reciprocal,\n    Conjugate,\n    Exp,\n    Sin,\n    Cos,\n    Sqrt,\n    Log,\n    Power,\n    Modulus,\n    Arg,\n    ExpITheta,\n  ]\n}\n\n/// Polar-tab presets (r(θ) curves on the Argand plane).\npub fn all_polar_functions() -> List(ComplexFn) {\n  [\n    Circle,\n    CircleCos,\n    CircleSin,\n    ArchimedesSpiral,\n    LogSpiral,\n    RoseCos,\n    RoseSin,\n    Cardioid,\n    Limacon,\n    Lemniscate,\n  ]\n}\n\npub fn all_functions() -> List(ComplexFn) {\n  list.append(all_map_functions(), all_polar_functions())\n}\n\npub fn parse_fn_id(id: String) -> ComplexFn {\n  case id {\n    \"w=z\" -> Identity\n    \"w=z^2\" -> Square\n    \"w=z^3\" -> Cube\n    \"w=1/z\" -> Reciprocal\n    \"w=conj(z)\" -> Conjugate\n    \"w=exp(z)\" -> Exp\n    \"w=sin(z)\" -> Sin\n    \"w=cos(z)\" -> Cos\n    \"w=sqrt(z)\" -> Sqrt\n    \"w=log(z)\" -> Log\n    \"w=z^w\" -> Power\n    \"w=|z|\" -> Modulus\n    \"w=arg(z)\" -> Arg\n    \"r=a\" -> Circle\n    \"r=1\" -> Circle\n    \"r=2a*cos(theta)\" -> CircleCos\n    \"r=2a*sin(theta)\" -> CircleSin\n    \"r=a*theta\" -> ArchimedesSpiral\n    \"r=a*e^(k*theta)\" -> LogSpiral\n    \"r=a*cos(n*theta)\" -> RoseCos\n    \"r=a*sin(n*theta)\" -> RoseSin\n    \"r=a*(1-cos(theta))\" -> Cardioid\n    \"r=a+cos(theta)\" -> Limacon\n    \"r=a+b*cos(theta)\" -> Limacon\n    \"r^2=a^2*cos(2*theta)\" -> Lemniscate\n    _ -> Identity\n  }\n}\n\npub fn is_polar(f: ComplexFn) -> Bool {\n  case f {\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// ω: maps (exp/sin/cos/power) and polar roses / spirals / lemniscate petals.\npub fn uses_omega(f: ComplexFn) -> Bool {\n  case f {\n    Exp | Sin | Cos | Power -> True\n    ArchimedesSpiral | LogSpiral | RoseCos | RoseSin | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// Stroke color: axes muted; images of horizontal lines teal; vertical magenta.\n/// Polar curves use teal only (horizontal_count covers all curve paths).\npub fn path_color(index: Int, horizontal_count: Int) -> String {\n  case index < decoration_count {\n    True -> \"#8a8aaa\"\n    False -> {\n      let j = index - decoration_count\n      case j < horizontal_count {\n        True -> \"#58C4DD\"\n        False -> \"#C77DFF\"\n      }\n    }\n  }\n}\n\npub fn plot(f: ComplexFn, a: Int, omega: Int, b: Int) -> #(Plot, Int) {\n  let a_f = int.to_float(int.clamp(a, -5, 5))\n  let w_f = int.to_float(int.clamp(omega, 1, 10))\n  let b_f = int.to_float(int.clamp(b, -5, 5))\n  let #(axis_paths, labels) = argand_decorations()\n  case is_polar(f) {\n    True -> {\n      let curves = polar_plot(f, a_f, w_f, b_f)\n      let n = list.length(curves)\n      #(Plot(list.append(axis_paths, curves), labels, []), n)\n    }\n    False -> {\n      let #(horiz, vert) = mapped_grid(f, a_f, w_f, b_f)\n      let horiz_n = list.length(horiz)\n      #(Plot(list.flatten([axis_paths, horiz, vert]), labels, []), horiz_n)\n    }\n  }\n}\n\nfn argand_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n\n  let re_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      0.0,\n      8.0,\n      axis_t,\n    )\n  let im_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      4.0,\n      12.0,\n      axis_t,\n    )\n\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let re_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let im_ticks =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let re_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        math_to_world(int.to_float(k)),\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let im_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        0.0 -. 28.0,\n        0.0 -. math_to_world(int.to_float(k)),\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let paths = list.flatten([[re_axis, im_axis], re_ticks, im_ticks])\n  let labels = list.flatten([re_labels, im_labels])\n  #(paths, labels)\n}\n\nfn math_to_world(t: Float) -> Float {\n  t *. { world_half /. x_math_max }\n}\n\n// ── Polar curves ─────────────────────────────────────────────────────────────\n\nfn polar_plot(f: ComplexFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let amp = case float.absolute_value(a) <. 0.01 {\n    True -> 1.0\n    False -> float.absolute_value(a)\n  }\n  let marks =\n    list.repeat(Nil, polar_samples + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(polar_samples)\n      case polar_point(f, t, amp, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, 14.0, 40.0, 3.0)\n}\n\n/// t ∈ [0,1] parameter along the polar sweep.\n/// All curves are translated by b along Re after (r, θ) → ℂ.\nfn polar_point(\n  f: ComplexFn,\n  t: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  case f {\n    Circle -> {\n      // |z − b| = a  (center on Re axis at b)\n      let theta = t *. 2.0 *. pi\n      Ok(from_polar(a, theta, b))\n    }\n    CircleCos -> {\n      // r = 2a cos θ — diameter [0, 2a] on Re, then shift by b\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    CircleSin -> {\n      // r = 2a sin θ — diameter on Im, then shift by b along Re\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_sin(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    ArchimedesSpiral -> {\n      // θ ∈ [0, 2πω]; r = (a/8) θ  — more turns with larger ω\n      let theta = t *. 2.0 *. pi *. omega\n      let r = { a /. 8.0 } *. theta\n      Ok(from_polar(r, theta, b))\n    }\n    LogSpiral -> {\n      let theta = t *. 2.0 *. pi *. omega\n      let k = 0.12\n      let r = { a /. 3.0 } *. float.exponential(k *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseCos -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_cos(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseSin -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_sin(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Cardioid -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. { 1.0 -. js_cos(theta) }\n      Ok(from_polar(r, theta, b))\n    }\n    Limacon -> {\n      // Classic dimpled/looped limaçon: r = a + cos θ\n      let theta = t *. 2.0 *. pi\n      let r = a +. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Lemniscate -> {\n      // r² = a² cos(ωθ); classic figure-eight uses ω = 2\n      let theta = t *. 2.0 *. pi\n      let c = js_cos(omega *. theta)\n      case c <. 0.0 {\n        True -> Error(Nil)\n        False ->\n          case float.square_root(a *. a *. c) {\n            Error(Nil) -> Error(Nil)\n            Ok(r) -> Ok(from_polar(r, theta, b))\n          }\n      }\n    }\n    _ -> Error(Nil)\n  }\n}\n\nfn from_polar(r: Float, theta: Float, b_re: Float) -> C {\n  C(r *. js_cos(theta) +. b_re, r *. js_sin(theta))\n}\n\n/// Clamp runaway images to the viewport edge, then break so asymptotes don't bridge.\nfn world_marks(w: C) -> List(Mark) {\n  let #(wx0, wy0) = to_world(w)\n  let ax = float.absolute_value(wx0)\n  let ay = float.absolute_value(wy0)\n  let m = case ax >. ay {\n    True -> ax\n    False -> ay\n  }\n  case m >. y_clip {\n    True -> {\n      let s = y_clip /. m\n      [Pt(Point(wx0 *. s, wy0 *. s)), Break]\n    }\n    False -> [Pt(Point(wx0, wy0))]\n  }\n}\n\n// ── Grid maps ────────────────────────────────────────────────────────────────\n\nfn mapped_grid(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> #(List(Path), List(Path)) {\n  let levels = [-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]\n  let horiz =\n    list.index_map(levels, fn(im, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        True,\n        im,\n        domain_min,\n        domain_max,\n        14.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  let vert =\n    list.index_map(levels, fn(re, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        False,\n        re,\n        domain_min,\n        domain_max,\n        26.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  #(horiz, vert)\n}\n\nfn sample_line(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  horizontal: Bool,\n  fixed: Float,\n  varying_min: Float,\n  varying_max: Float,\n  start_base: Float,\n) -> List(Path) {\n  let marks =\n    list.repeat(Nil, samples_per_line + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(samples_per_line)\n      let varying = varying_min +. t *. { varying_max -. varying_min }\n      let z = case horizontal {\n        True -> C(varying, fixed)\n        False -> C(fixed, varying)\n      }\n      case apply_map(f, z, a, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, start_base, 10.0, 2.2)\n}\n\nfn apply_map(\n  f: ComplexFn,\n  z: C,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  // Input shift on the Re axis: f(z − b), then optional ω scaling, then a·w.\n  let shifted = C(z.re -. b, z.im)\n  let scaled_in = case f {\n    Exp | Sin | Cos | Power -> c_scale(shifted, omega)\n    _ -> shifted\n  }\n  use w <- result.try(eval(f, scaled_in, omega))\n  Ok(c_scale(w, a))\n}\n\nfn eval(f: ComplexFn, z: C, omega: Float) -> Result(C, Nil) {\n  case f {\n    Identity -> Ok(z)\n    Square -> Ok(c_mul(z, z))\n    Cube -> Ok(c_mul(c_mul(z, z), z))\n    Reciprocal -> c_inv(z)\n    Conjugate -> Ok(C(z.re, 0.0 -. z.im))\n    Exp -> Ok(c_exp(z))\n    Sin -> Ok(c_sin(z))\n    Cos -> Ok(c_cos(z))\n    Sqrt -> c_sqrt(z)\n    Log -> c_log(z)\n    Power -> c_pow(z, omega)\n    Modulus -> Ok(C(c_abs(z), 0.0))\n    Arg -> Ok(C(js_atan2(z.im, z.re), 0.0))\n    // Polar variants never reach eval.\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> Error(Nil)\n  }\n}\n\nfn c_scale(z: C, s: Float) -> C {\n  C(z.re *. s, z.im *. s)\n}\n\nfn c_mul(z: C, w: C) -> C {\n  C(z.re *. w.re -. z.im *. w.im, z.re *. w.im +. z.im *. w.re)\n}\n\nfn c_abs(z: C) -> Float {\n  float.square_root(z.re *. z.re +. z.im *. z.im)\n  |> result_or_zero\n}\n\nfn result_or_zero(r: Result(Float, Nil)) -> Float {\n  case r {\n    Ok(v) -> v\n    Error(Nil) -> 0.0\n  }\n}\n\nfn c_inv(z: C) -> Result(C, Nil) {\n  let n = z.re *. z.re +. z.im *. z.im\n  // Gap only at the pole; large |1/z| is clamped to the viewport edge.\n  case n <. 0.0025 {\n    True -> Error(Nil)\n    False -> Ok(C(z.re /. n, 0.0 -. z.im /. n))\n  }\n}\n\nfn c_exp(z: C) -> C {\n  let ex = float.exponential(z.re)\n  C(ex *. js_cos(z.im), ex *. js_sin(z.im))\n}\n\nfn sinh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e -. inv } /. 2.0\n}\n\nfn cosh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e +. inv } /. 2.0\n}\n\nfn c_sin(z: C) -> C {\n  C(js_sin(z.re) *. cosh(z.im), js_cos(z.re) *. sinh(z.im))\n}\n\nfn c_cos(z: C) -> C {\n  C(js_cos(z.re) *. cosh(z.im), 0.0 -. js_sin(z.re) *. sinh(z.im))\n}\n\nfn c_sqrt(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.0001 {\n    True -> Ok(C(0.0, 0.0))\n    False -> {\n      let theta = js_atan2(z.im, z.re)\n      let half = theta /. 2.0\n      case float.square_root(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(root) -> Ok(C(root *. js_cos(half), root *. js_sin(half)))\n      }\n    }\n  }\n}\n\nfn c_log(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.01 {\n    True -> Error(Nil)\n    False ->\n      case float.logarithm(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(ln_r) -> Ok(C(ln_r, js_atan2(z.im, z.re)))\n      }\n  }\n}\n\nfn c_pow(z: C, omega: Float) -> Result(C, Nil) {\n  // z^ω = exp(ω Log z)\n  use lg <- result.try(c_log(z))\n  Ok(c_exp(c_scale(lg, omega)))\n}\n\nfn to_world(w: C) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  #(w.re *. scale, 0.0 -. w.im *. scale)\n}\n\nfn paths_from_marks(\n  marks: List(Mark),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  let runs = split_runs(marks, [], [])\n  let n_runs = list.length(runs)\n  let n_f = int.to_float(int.max(n_runs, 1))\n  list.index_map(runs, fn(run, ri) {\n    let t0 = start_base +. int.to_float(ri) /. n_f *. duration\n    let t1 = start_base +. int.to_float(ri + 1) /. n_f *. duration\n    stroke_run(run, t0, t1, thickness)\n  })\n  |> list.flatten\n}\n\nfn split_runs(\n  marks: List(Mark),\n  current: List(Point),\n  acc: List(List(Point)),\n) -> List(List(Point)) {\n  case marks {\n    [] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      list.reverse(acc)\n    }\n    [Break, ..rest] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      split_runs(rest, [], acc)\n    }\n    [Pt(p), ..rest] -> split_runs(rest, [p, ..current], acc)\n  }\n}\n\nfn stroke_run(\n  points: List(Point),\n  t0: Float,\n  t1: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      let span = t1 -. t0\n      do_stroke(a, [b, ..rest], 0, n_f, t0, span, thickness, [])\n    }\n  }\n}\n\nfn do_stroke(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  t0: Float,\n  span: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 120.0 {\n        True -> acc\n        False -> {\n          let s0 = t0 +. int.to_float(i) /. n_f *. span\n          let s1 = t0 +. int.to_float(i + 1) /. n_f *. span\n          [Path(Line(prev, next), s0, s1, thickness), ..acc]\n        }\n      }\n      do_stroke(next, tail, i + 1, n_f, t0, span, thickness, acc)\n    }\n  }\n}\n","new_content_size":18470,"new_hash":"9a3466cb06fe02ad06296a87813088951f334ac69d76c4ec2aaf4369f4365538","old_hash":"b482ac220596fda0e93d35286fdf36d603cbbdc15999da2da6458cf00a10c562","operation":"modify","path":"src/complex_math.gleam"},"hash":"e165434f2b0c17586cdbf5246632090352a79e5492964853da9cde125e548be7","kind":"fs.external_change","prev_hash":"b4785bfd07fc603fad85575903684299a23eb9ebb097ec5615305421198aad10","seq":399,"t":5988471,"wall":"2026-11-25T22:44:49.732Z"}
{"data":{"diff_size":34,"new_content":"//// Complex / Polar submodes of Math on the Argand plane (Re / Im).\n//// — Complex maps: grid → w = a · f(ω(z − b))\n//// — Polar curves: r(θ) drawn on the same plane (calc-class classics + spirals)\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport math.{type Plot, Plot}\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan2\")\nfn js_atan2(y: Float, x: Float) -> Float\n\n/// Maps ℂ→ℂ (Complex tab) and polar r(θ) curves (Polar tab).\npub type ComplexFn {\n  // ── Complex maps (grid images) ───────────────────────────────────────────\n  Identity\n  Square\n  Cube\n  Reciprocal\n  Conjugate\n  Exp\n  Sin\n  Cos\n  Sqrt\n  Log\n  /// w = z^ω via exp(ω Log z)\n  Power\n  Modulus\n  Arg\n  /// Unit circle e^{iθ} with Create-swept tangent sticks i·e^{iθ}.\n  ExpITheta\n  // ── Polar curves on the Argand plane ─────────────────────────────────────\n  /// |z − b| = |a| — circle centered on the Re axis.\n  Circle\n  /// r = 2a cos θ — circle diameter on the Re axis (calc classic).\n  CircleCos\n  /// r = 2a sin θ — circle diameter on the Im axis (calc classic).\n  CircleSin\n  ArchimedesSpiral\n  LogSpiral\n  RoseCos\n  RoseSin\n  Cardioid\n  Limacon\n  Lemniscate\n}\n\npub type C {\n  C(re: Float, im: Float)\n}\n\n/// Axes + integer ticks (same layout count as real math mode).\npub const decoration_count = 18\n\nconst world_half = 450.0\n\nconst x_math_max = 5.0\n\nconst y_clip = 480.0\n\nconst domain_min = -2.0\n\nconst domain_max = 2.0\n\nconst samples_per_line = 72\n\nconst polar_samples = 360\n\nconst pi = 3.141592653589793\n\n/// Sampling mark: drawable point or explicit break at domain / asymptote gaps.\ntype Mark {\n  Pt(Point)\n  Break\n}\n\npub fn fn_id(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w=z\"\n    Square -> \"w=z^2\"\n    Cube -> \"w=z^3\"\n    Reciprocal -> \"w=1/z\"\n    Conjugate -> \"w=conj(z)\"\n    Exp -> \"w=exp(z)\"\n    Sin -> \"w=sin(z)\"\n    Cos -> \"w=cos(z)\"\n    Sqrt -> \"w=sqrt(z)\"\n    Log -> \"w=log(z)\"\n    Power -> \"w=z^w\"\n    Modulus -> \"w=|z|\"\n    Arg -> \"w=arg(z)\"\n    ExpITheta -> \"w=exp(i*theta)\"\n    Circle -> \"r=a\"\n    CircleCos -> \"r=2a*cos(theta)\"\n    CircleSin -> \"r=2a*sin(theta)\"\n    ArchimedesSpiral -> \"r=a*theta\"\n    LogSpiral -> \"r=a*e^(k*theta)\"\n    RoseCos -> \"r=a*cos(n*theta)\"\n    RoseSin -> \"r=a*sin(n*theta)\"\n    Cardioid -> \"r=a*(1-cos(theta))\"\n    Limacon -> \"r=a+cos(theta)\"\n    Lemniscate -> \"r^2=a^2*cos(2*theta)\"\n  }\n}\n\npub fn fn_label(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w = z\"\n    Square -> \"w = z²\"\n    Cube -> \"w = z³\"\n    Reciprocal -> \"w = 1/z\"\n    Conjugate -> \"w = z̄\"\n    Exp -> \"w = exp(z)\"\n    Sin -> \"w = sin(z)\"\n    Cos -> \"w = cos(z)\"\n    Sqrt -> \"w = √z\"\n    Log -> \"w = Log(z)\"\n    Power -> \"w = z^ω\"\n    Modulus -> \"w = |z|\"\n    Arg -> \"w = Arg(z)\"\n    ExpITheta -> \"w = e^{iθ}  (tangent sweep)\"\n    Circle -> \"|z − b| = |a|  (circle)\"\n    CircleCos -> \"r = 2a cos θ  (circle)\"\n    CircleSin -> \"r = 2a sin θ  (circle)\"\n    ArchimedesSpiral -> \"r = aθ  (Archimedes)\"\n    LogSpiral -> \"r = a e^{kθ}  (log spiral)\"\n    RoseCos -> \"r = a cos(ωθ)  (rose)\"\n    RoseSin -> \"r = a sin(ωθ)  (rose)\"\n    Cardioid -> \"r = a(1 − cos θ)  (cardioid)\"\n    Limacon -> \"r = a + cos θ  (limaçon)\"\n    Lemniscate -> \"r² = a² cos(ωθ)  (lemniscate)\"\n  }\n}\n\n/// Complex-tab presets (grid maps only).\npub fn all_map_functions() -> List(ComplexFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Reciprocal,\n    Conjugate,\n    Exp,\n    Sin,\n    Cos,\n    Sqrt,\n    Log,\n    Power,\n    Modulus,\n    Arg,\n    ExpITheta,\n  ]\n}\n\n/// Polar-tab presets (r(θ) curves on the Argand plane).\npub fn all_polar_functions() -> List(ComplexFn) {\n  [\n    Circle,\n    CircleCos,\n    CircleSin,\n    ArchimedesSpiral,\n    LogSpiral,\n    RoseCos,\n    RoseSin,\n    Cardioid,\n    Limacon,\n    Lemniscate,\n  ]\n}\n\npub fn all_functions() -> List(ComplexFn) {\n  list.append(all_map_functions(), all_polar_functions())\n}\n\npub fn parse_fn_id(id: String) -> ComplexFn {\n  case id {\n    \"w=z\" -> Identity\n    \"w=z^2\" -> Square\n    \"w=z^3\" -> Cube\n    \"w=1/z\" -> Reciprocal\n    \"w=conj(z)\" -> Conjugate\n    \"w=exp(z)\" -> Exp\n    \"w=sin(z)\" -> Sin\n    \"w=cos(z)\" -> Cos\n    \"w=sqrt(z)\" -> Sqrt\n    \"w=log(z)\" -> Log\n    \"w=z^w\" -> Power\n    \"w=|z|\" -> Modulus\n    \"w=arg(z)\" -> Arg\n    \"w=exp(i*theta)\" -> ExpITheta\n    \"r=a\" -> Circle\n    \"r=1\" -> Circle\n    \"r=2a*cos(theta)\" -> CircleCos\n    \"r=2a*sin(theta)\" -> CircleSin\n    \"r=a*theta\" -> ArchimedesSpiral\n    \"r=a*e^(k*theta)\" -> LogSpiral\n    \"r=a*cos(n*theta)\" -> RoseCos\n    \"r=a*sin(n*theta)\" -> RoseSin\n    \"r=a*(1-cos(theta))\" -> Cardioid\n    \"r=a+cos(theta)\" -> Limacon\n    \"r=a+b*cos(theta)\" -> Limacon\n    \"r^2=a^2*cos(2*theta)\" -> Lemniscate\n    _ -> Identity\n  }\n}\n\npub fn is_polar(f: ComplexFn) -> Bool {\n  case f {\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// ω: maps (exp/sin/cos/power) and polar roses / spirals / lemniscate petals.\npub fn uses_omega(f: ComplexFn) -> Bool {\n  case f {\n    Exp | Sin | Cos | Power -> True\n    ArchimedesSpiral | LogSpiral | RoseCos | RoseSin | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// Stroke color: axes muted; images of horizontal lines teal; vertical magenta.\n/// Polar curves use teal only (horizontal_count covers all curve paths).\npub fn path_color(index: Int, horizontal_count: Int) -> String {\n  case index < decoration_count {\n    True -> \"#8a8aaa\"\n    False -> {\n      let j = index - decoration_count\n      case j < horizontal_count {\n        True -> \"#58C4DD\"\n        False -> \"#C77DFF\"\n      }\n    }\n  }\n}\n\npub fn plot(f: ComplexFn, a: Int, omega: Int, b: Int) -> #(Plot, Int) {\n  let a_f = int.to_float(int.clamp(a, -5, 5))\n  let w_f = int.to_float(int.clamp(omega, 1, 10))\n  let b_f = int.to_float(int.clamp(b, -5, 5))\n  let #(axis_paths, labels) = argand_decorations()\n  case is_polar(f) {\n    True -> {\n      let curves = polar_plot(f, a_f, w_f, b_f)\n      let n = list.length(curves)\n      #(Plot(list.append(axis_paths, curves), labels, []), n)\n    }\n    False -> {\n      let #(horiz, vert) = mapped_grid(f, a_f, w_f, b_f)\n      let horiz_n = list.length(horiz)\n      #(Plot(list.flatten([axis_paths, horiz, vert]), labels, []), horiz_n)\n    }\n  }\n}\n\nfn argand_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n\n  let re_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      0.0,\n      8.0,\n      axis_t,\n    )\n  let im_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      4.0,\n      12.0,\n      axis_t,\n    )\n\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let re_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let im_ticks =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let re_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        math_to_world(int.to_float(k)),\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let im_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        0.0 -. 28.0,\n        0.0 -. math_to_world(int.to_float(k)),\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let paths = list.flatten([[re_axis, im_axis], re_ticks, im_ticks])\n  let labels = list.flatten([re_labels, im_labels])\n  #(paths, labels)\n}\n\nfn math_to_world(t: Float) -> Float {\n  t *. { world_half /. x_math_max }\n}\n\n// ── Polar curves ─────────────────────────────────────────────────────────────\n\nfn polar_plot(f: ComplexFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let amp = case float.absolute_value(a) <. 0.01 {\n    True -> 1.0\n    False -> float.absolute_value(a)\n  }\n  let marks =\n    list.repeat(Nil, polar_samples + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(polar_samples)\n      case polar_point(f, t, amp, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, 14.0, 40.0, 3.0)\n}\n\n/// t ∈ [0,1] parameter along the polar sweep.\n/// All curves are translated by b along Re after (r, θ) → ℂ.\nfn polar_point(\n  f: ComplexFn,\n  t: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  case f {\n    Circle -> {\n      // |z − b| = a  (center on Re axis at b)\n      let theta = t *. 2.0 *. pi\n      Ok(from_polar(a, theta, b))\n    }\n    CircleCos -> {\n      // r = 2a cos θ — diameter [0, 2a] on Re, then shift by b\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    CircleSin -> {\n      // r = 2a sin θ — diameter on Im, then shift by b along Re\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_sin(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    ArchimedesSpiral -> {\n      // θ ∈ [0, 2πω]; r = (a/8) θ  — more turns with larger ω\n      let theta = t *. 2.0 *. pi *. omega\n      let r = { a /. 8.0 } *. theta\n      Ok(from_polar(r, theta, b))\n    }\n    LogSpiral -> {\n      let theta = t *. 2.0 *. pi *. omega\n      let k = 0.12\n      let r = { a /. 3.0 } *. float.exponential(k *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseCos -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_cos(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseSin -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_sin(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Cardioid -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. { 1.0 -. js_cos(theta) }\n      Ok(from_polar(r, theta, b))\n    }\n    Limacon -> {\n      // Classic dimpled/looped limaçon: r = a + cos θ\n      let theta = t *. 2.0 *. pi\n      let r = a +. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Lemniscate -> {\n      // r² = a² cos(ωθ); classic figure-eight uses ω = 2\n      let theta = t *. 2.0 *. pi\n      let c = js_cos(omega *. theta)\n      case c <. 0.0 {\n        True -> Error(Nil)\n        False ->\n          case float.square_root(a *. a *. c) {\n            Error(Nil) -> Error(Nil)\n            Ok(r) -> Ok(from_polar(r, theta, b))\n          }\n      }\n    }\n    _ -> Error(Nil)\n  }\n}\n\nfn from_polar(r: Float, theta: Float, b_re: Float) -> C {\n  C(r *. js_cos(theta) +. b_re, r *. js_sin(theta))\n}\n\n/// Clamp runaway images to the viewport edge, then break so asymptotes don't bridge.\nfn world_marks(w: C) -> List(Mark) {\n  let #(wx0, wy0) = to_world(w)\n  let ax = float.absolute_value(wx0)\n  let ay = float.absolute_value(wy0)\n  let m = case ax >. ay {\n    True -> ax\n    False -> ay\n  }\n  case m >. y_clip {\n    True -> {\n      let s = y_clip /. m\n      [Pt(Point(wx0 *. s, wy0 *. s)), Break]\n    }\n    False -> [Pt(Point(wx0, wy0))]\n  }\n}\n\n// ── Grid maps ────────────────────────────────────────────────────────────────\n\nfn mapped_grid(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> #(List(Path), List(Path)) {\n  let levels = [-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]\n  let horiz =\n    list.index_map(levels, fn(im, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        True,\n        im,\n        domain_min,\n        domain_max,\n        14.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  let vert =\n    list.index_map(levels, fn(re, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        False,\n        re,\n        domain_min,\n        domain_max,\n        26.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  #(horiz, vert)\n}\n\nfn sample_line(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  horizontal: Bool,\n  fixed: Float,\n  varying_min: Float,\n  varying_max: Float,\n  start_base: Float,\n) -> List(Path) {\n  let marks =\n    list.repeat(Nil, samples_per_line + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(samples_per_line)\n      let varying = varying_min +. t *. { varying_max -. varying_min }\n      let z = case horizontal {\n        True -> C(varying, fixed)\n        False -> C(fixed, varying)\n      }\n      case apply_map(f, z, a, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, start_base, 10.0, 2.2)\n}\n\nfn apply_map(\n  f: ComplexFn,\n  z: C,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  // Input shift on the Re axis: f(z − b), then optional ω scaling, then a·w.\n  let shifted = C(z.re -. b, z.im)\n  let scaled_in = case f {\n    Exp | Sin | Cos | Power -> c_scale(shifted, omega)\n    _ -> shifted\n  }\n  use w <- result.try(eval(f, scaled_in, omega))\n  Ok(c_scale(w, a))\n}\n\nfn eval(f: ComplexFn, z: C, omega: Float) -> Result(C, Nil) {\n  case f {\n    Identity -> Ok(z)\n    Square -> Ok(c_mul(z, z))\n    Cube -> Ok(c_mul(c_mul(z, z), z))\n    Reciprocal -> c_inv(z)\n    Conjugate -> Ok(C(z.re, 0.0 -. z.im))\n    Exp -> Ok(c_exp(z))\n    Sin -> Ok(c_sin(z))\n    Cos -> Ok(c_cos(z))\n    Sqrt -> c_sqrt(z)\n    Log -> c_log(z)\n    Power -> c_pow(z, omega)\n    Modulus -> Ok(C(c_abs(z), 0.0))\n    Arg -> Ok(C(js_atan2(z.im, z.re), 0.0))\n    // Polar variants never reach eval.\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> Error(Nil)\n  }\n}\n\nfn c_scale(z: C, s: Float) -> C {\n  C(z.re *. s, z.im *. s)\n}\n\nfn c_mul(z: C, w: C) -> C {\n  C(z.re *. w.re -. z.im *. w.im, z.re *. w.im +. z.im *. w.re)\n}\n\nfn c_abs(z: C) -> Float {\n  float.square_root(z.re *. z.re +. z.im *. z.im)\n  |> result_or_zero\n}\n\nfn result_or_zero(r: Result(Float, Nil)) -> Float {\n  case r {\n    Ok(v) -> v\n    Error(Nil) -> 0.0\n  }\n}\n\nfn c_inv(z: C) -> Result(C, Nil) {\n  let n = z.re *. z.re +. z.im *. z.im\n  // Gap only at the pole; large |1/z| is clamped to the viewport edge.\n  case n <. 0.0025 {\n    True -> Error(Nil)\n    False -> Ok(C(z.re /. n, 0.0 -. z.im /. n))\n  }\n}\n\nfn c_exp(z: C) -> C {\n  let ex = float.exponential(z.re)\n  C(ex *. js_cos(z.im), ex *. js_sin(z.im))\n}\n\nfn sinh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e -. inv } /. 2.0\n}\n\nfn cosh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e +. inv } /. 2.0\n}\n\nfn c_sin(z: C) -> C {\n  C(js_sin(z.re) *. cosh(z.im), js_cos(z.re) *. sinh(z.im))\n}\n\nfn c_cos(z: C) -> C {\n  C(js_cos(z.re) *. cosh(z.im), 0.0 -. js_sin(z.re) *. sinh(z.im))\n}\n\nfn c_sqrt(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.0001 {\n    True -> Ok(C(0.0, 0.0))\n    False -> {\n      let theta = js_atan2(z.im, z.re)\n      let half = theta /. 2.0\n      case float.square_root(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(root) -> Ok(C(root *. js_cos(half), root *. js_sin(half)))\n      }\n    }\n  }\n}\n\nfn c_log(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.01 {\n    True -> Error(Nil)\n    False ->\n      case float.logarithm(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(ln_r) -> Ok(C(ln_r, js_atan2(z.im, z.re)))\n      }\n  }\n}\n\nfn c_pow(z: C, omega: Float) -> Result(C, Nil) {\n  // z^ω = exp(ω Log z)\n  use lg <- result.try(c_log(z))\n  Ok(c_exp(c_scale(lg, omega)))\n}\n\nfn to_world(w: C) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  #(w.re *. scale, 0.0 -. w.im *. scale)\n}\n\nfn paths_from_marks(\n  marks: List(Mark),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  let runs = split_runs(marks, [], [])\n  let n_runs = list.length(runs)\n  let n_f = int.to_float(int.max(n_runs, 1))\n  list.index_map(runs, fn(run, ri) {\n    let t0 = start_base +. int.to_float(ri) /. n_f *. duration\n    let t1 = start_base +. int.to_float(ri + 1) /. n_f *. duration\n    stroke_run(run, t0, t1, thickness)\n  })\n  |> list.flatten\n}\n\nfn split_runs(\n  marks: List(Mark),\n  current: List(Point),\n  acc: List(List(Point)),\n) -> List(List(Point)) {\n  case marks {\n    [] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      list.reverse(acc)\n    }\n    [Break, ..rest] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      split_runs(rest, [], acc)\n    }\n    [Pt(p), ..rest] -> split_runs(rest, [p, ..current], acc)\n  }\n}\n\nfn stroke_run(\n  points: List(Point),\n  t0: Float,\n  t1: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      let span = t1 -. t0\n      do_stroke(a, [b, ..rest], 0, n_f, t0, span, thickness, [])\n    }\n  }\n}\n\nfn do_stroke(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  t0: Float,\n  span: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 120.0 {\n        True -> acc\n        False -> {\n          let s0 = t0 +. int.to_float(i) /. n_f *. span\n          let s1 = t0 +. int.to_float(i + 1) /. n_f *. span\n          [Path(Line(prev, next), s0, s1, thickness), ..acc]\n        }\n      }\n      do_stroke(next, tail, i + 1, n_f, t0, span, thickness, acc)\n    }\n  }\n}\n","new_content_size":18504,"new_hash":"7c42f45abb58f618746e2e7f826329157b8abd6dbee461f45ad9423daf66c0a5","old_hash":"9a3466cb06fe02ad06296a87813088951f334ac69d76c4ec2aaf4369f4365538","operation":"modify","path":"src/complex_math.gleam"},"hash":"b43c1e5c2629b1c376a833e091e3b423fb1d437261f26bbea0db149a362c1e39","kind":"fs.external_change","prev_hash":"e165434f2b0c17586cdbf5246632090352a79e5492964853da9cde125e548be7","seq":400,"t":5989492,"wall":"2026-11-25T22:44:50.753Z"}
{"data":{"diff_size":11,"new_content":"//// Complex / Polar submodes of Math on the Argand plane (Re / Im).\n//// — Complex maps: grid → w = a · f(ω(z − b))\n//// — Polar curves: r(θ) drawn on the same plane (calc-class classics + spirals)\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport math.{type Plot, Plot}\nimport render.{type RenderLabel, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"atan2\")\nfn js_atan2(y: Float, x: Float) -> Float\n\n/// Maps ℂ→ℂ (Complex tab) and polar r(θ) curves (Polar tab).\npub type ComplexFn {\n  // ── Complex maps (grid images) ───────────────────────────────────────────\n  Identity\n  Square\n  Cube\n  Reciprocal\n  Conjugate\n  Exp\n  Sin\n  Cos\n  Sqrt\n  Log\n  /// w = z^ω via exp(ω Log z)\n  Power\n  Modulus\n  Arg\n  /// Unit circle e^{iθ} with Create-swept tangent sticks i·e^{iθ}.\n  ExpITheta\n  // ── Polar curves on the Argand plane ─────────────────────────────────────\n  /// |z − b| = |a| — circle centered on the Re axis.\n  Circle\n  /// r = 2a cos θ — circle diameter on the Re axis (calc classic).\n  CircleCos\n  /// r = 2a sin θ — circle diameter on the Im axis (calc classic).\n  CircleSin\n  ArchimedesSpiral\n  LogSpiral\n  RoseCos\n  RoseSin\n  Cardioid\n  Limacon\n  Lemniscate\n}\n\npub type C {\n  C(re: Float, im: Float)\n}\n\n/// Axes + integer ticks (same layout count as real math mode).\npub const decoration_count = 18\n\nconst world_half = 450.0\n\nconst x_math_max = 5.0\n\nconst y_clip = 480.0\n\nconst domain_min = -2.0\n\nconst domain_max = 2.0\n\nconst samples_per_line = 72\n\nconst polar_samples = 360\n\nconst pi = 3.141592653589793\n\n/// Sampling mark: drawable point or explicit break at domain / asymptote gaps.\ntype Mark {\n  Pt(Point)\n  Break\n}\n\npub fn fn_id(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w=z\"\n    Square -> \"w=z^2\"\n    Cube -> \"w=z^3\"\n    Reciprocal -> \"w=1/z\"\n    Conjugate -> \"w=conj(z)\"\n    Exp -> \"w=exp(z)\"\n    Sin -> \"w=sin(z)\"\n    Cos -> \"w=cos(z)\"\n    Sqrt -> \"w=sqrt(z)\"\n    Log -> \"w=log(z)\"\n    Power -> \"w=z^w\"\n    Modulus -> \"w=|z|\"\n    Arg -> \"w=arg(z)\"\n    ExpITheta -> \"w=exp(i*theta)\"\n    Circle -> \"r=a\"\n    CircleCos -> \"r=2a*cos(theta)\"\n    CircleSin -> \"r=2a*sin(theta)\"\n    ArchimedesSpiral -> \"r=a*theta\"\n    LogSpiral -> \"r=a*e^(k*theta)\"\n    RoseCos -> \"r=a*cos(n*theta)\"\n    RoseSin -> \"r=a*sin(n*theta)\"\n    Cardioid -> \"r=a*(1-cos(theta))\"\n    Limacon -> \"r=a+cos(theta)\"\n    Lemniscate -> \"r^2=a^2*cos(2*theta)\"\n  }\n}\n\npub fn fn_label(f: ComplexFn) -> String {\n  case f {\n    Identity -> \"w = z\"\n    Square -> \"w = z²\"\n    Cube -> \"w = z³\"\n    Reciprocal -> \"w = 1/z\"\n    Conjugate -> \"w = z̄\"\n    Exp -> \"w = exp(z)\"\n    Sin -> \"w = sin(z)\"\n    Cos -> \"w = cos(z)\"\n    Sqrt -> \"w = √z\"\n    Log -> \"w = Log(z)\"\n    Power -> \"w = z^ω\"\n    Modulus -> \"w = |z|\"\n    Arg -> \"w = Arg(z)\"\n    ExpITheta -> \"w = e^{iθ}  (tangent sweep)\"\n    Circle -> \"|z − b| = |a|  (circle)\"\n    CircleCos -> \"r = 2a cos θ  (circle)\"\n    CircleSin -> \"r = 2a sin θ  (circle)\"\n    ArchimedesSpiral -> \"r = aθ  (Archimedes)\"\n    LogSpiral -> \"r = a e^{kθ}  (log spiral)\"\n    RoseCos -> \"r = a cos(ωθ)  (rose)\"\n    RoseSin -> \"r = a sin(ωθ)  (rose)\"\n    Cardioid -> \"r = a(1 − cos θ)  (cardioid)\"\n    Limacon -> \"r = a + cos θ  (limaçon)\"\n    Lemniscate -> \"r² = a² cos(ωθ)  (lemniscate)\"\n  }\n}\n\n/// Complex-tab presets (grid maps only).\npub fn all_map_functions() -> List(ComplexFn) {\n  [\n    Identity,\n    Square,\n    Cube,\n    Reciprocal,\n    Conjugate,\n    Exp,\n    Sin,\n    Cos,\n    Sqrt,\n    Log,\n    Power,\n    Modulus,\n    Arg,\n    ExpITheta,\n  ]\n}\n\n/// Polar-tab presets (r(θ) curves on the Argand plane).\npub fn all_polar_functions() -> List(ComplexFn) {\n  [\n    Circle,\n    CircleCos,\n    CircleSin,\n    ArchimedesSpiral,\n    LogSpiral,\n    RoseCos,\n    RoseSin,\n    Cardioid,\n    Limacon,\n    Lemniscate,\n  ]\n}\n\npub fn all_functions() -> List(ComplexFn) {\n  list.append(all_map_functions(), all_polar_functions())\n}\n\npub fn parse_fn_id(id: String) -> ComplexFn {\n  case id {\n    \"w=z\" -> Identity\n    \"w=z^2\" -> Square\n    \"w=z^3\" -> Cube\n    \"w=1/z\" -> Reciprocal\n    \"w=conj(z)\" -> Conjugate\n    \"w=exp(z)\" -> Exp\n    \"w=sin(z)\" -> Sin\n    \"w=cos(z)\" -> Cos\n    \"w=sqrt(z)\" -> Sqrt\n    \"w=log(z)\" -> Log\n    \"w=z^w\" -> Power\n    \"w=|z|\" -> Modulus\n    \"w=arg(z)\" -> Arg\n    \"w=exp(i*theta)\" -> ExpITheta\n    \"r=a\" -> Circle\n    \"r=1\" -> Circle\n    \"r=2a*cos(theta)\" -> CircleCos\n    \"r=2a*sin(theta)\" -> CircleSin\n    \"r=a*theta\" -> ArchimedesSpiral\n    \"r=a*e^(k*theta)\" -> LogSpiral\n    \"r=a*cos(n*theta)\" -> RoseCos\n    \"r=a*sin(n*theta)\" -> RoseSin\n    \"r=a*(1-cos(theta))\" -> Cardioid\n    \"r=a+cos(theta)\" -> Limacon\n    \"r=a+b*cos(theta)\" -> Limacon\n    \"r^2=a^2*cos(2*theta)\" -> Lemniscate\n    _ -> Identity\n  }\n}\n\npub fn is_polar(f: ComplexFn) -> Bool {\n  case f {\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// ω: maps (exp/sin/cos/power), e^{iθ} tangent density, polar roses/spirals.\npub fn uses_omega(f: ComplexFn) -> Bool {\n  case f {\n    Exp | Sin | Cos | Power | ExpITheta -> True\n    ArchimedesSpiral | LogSpiral | RoseCos | RoseSin | Lemniscate -> True\n    _ -> False\n  }\n}\n\n/// Stroke color: axes muted; images of horizontal lines teal; vertical magenta.\n/// Polar curves use teal only (horizontal_count covers all curve paths).\npub fn path_color(index: Int, horizontal_count: Int) -> String {\n  case index < decoration_count {\n    True -> \"#8a8aaa\"\n    False -> {\n      let j = index - decoration_count\n      case j < horizontal_count {\n        True -> \"#58C4DD\"\n        False -> \"#C77DFF\"\n      }\n    }\n  }\n}\n\npub fn plot(f: ComplexFn, a: Int, omega: Int, b: Int) -> #(Plot, Int) {\n  let a_f = int.to_float(int.clamp(a, -5, 5))\n  let w_f = int.to_float(int.clamp(omega, 1, 10))\n  let b_f = int.to_float(int.clamp(b, -5, 5))\n  let #(axis_paths, labels) = argand_decorations()\n  case is_polar(f) {\n    True -> {\n      let curves = polar_plot(f, a_f, w_f, b_f)\n      let n = list.length(curves)\n      #(Plot(list.append(axis_paths, curves), labels, []), n)\n    }\n    False -> {\n      let #(horiz, vert) = mapped_grid(f, a_f, w_f, b_f)\n      let horiz_n = list.length(horiz)\n      #(Plot(list.flatten([axis_paths, horiz, vert]), labels, []), horiz_n)\n    }\n  }\n}\n\nfn argand_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n\n  let re_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      0.0,\n      8.0,\n      axis_t,\n    )\n  let im_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      4.0,\n      12.0,\n      axis_t,\n    )\n\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let re_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let im_ticks =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let re_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        math_to_world(int.to_float(k)),\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let im_labels =\n    list.map(tick_maths, fn(k) {\n      RenderLabel(\n        0.0 -. 28.0,\n        0.0 -. math_to_world(int.to_float(k)),\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let paths = list.flatten([[re_axis, im_axis], re_ticks, im_ticks])\n  let labels = list.flatten([re_labels, im_labels])\n  #(paths, labels)\n}\n\nfn math_to_world(t: Float) -> Float {\n  t *. { world_half /. x_math_max }\n}\n\n// ── Polar curves ─────────────────────────────────────────────────────────────\n\nfn polar_plot(f: ComplexFn, a: Float, omega: Float, b: Float) -> List(Path) {\n  let amp = case float.absolute_value(a) <. 0.01 {\n    True -> 1.0\n    False -> float.absolute_value(a)\n  }\n  let marks =\n    list.repeat(Nil, polar_samples + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(polar_samples)\n      case polar_point(f, t, amp, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, 14.0, 40.0, 3.0)\n}\n\n/// t ∈ [0,1] parameter along the polar sweep.\n/// All curves are translated by b along Re after (r, θ) → ℂ.\nfn polar_point(\n  f: ComplexFn,\n  t: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  case f {\n    Circle -> {\n      // |z − b| = a  (center on Re axis at b)\n      let theta = t *. 2.0 *. pi\n      Ok(from_polar(a, theta, b))\n    }\n    CircleCos -> {\n      // r = 2a cos θ — diameter [0, 2a] on Re, then shift by b\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    CircleSin -> {\n      // r = 2a sin θ — diameter on Im, then shift by b along Re\n      let theta = t *. 2.0 *. pi\n      let r = 2.0 *. a *. js_sin(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    ArchimedesSpiral -> {\n      // θ ∈ [0, 2πω]; r = (a/8) θ  — more turns with larger ω\n      let theta = t *. 2.0 *. pi *. omega\n      let r = { a /. 8.0 } *. theta\n      Ok(from_polar(r, theta, b))\n    }\n    LogSpiral -> {\n      let theta = t *. 2.0 *. pi *. omega\n      let k = 0.12\n      let r = { a /. 3.0 } *. float.exponential(k *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseCos -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_cos(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    RoseSin -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. js_sin(omega *. theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Cardioid -> {\n      let theta = t *. 2.0 *. pi\n      let r = a *. { 1.0 -. js_cos(theta) }\n      Ok(from_polar(r, theta, b))\n    }\n    Limacon -> {\n      // Classic dimpled/looped limaçon: r = a + cos θ\n      let theta = t *. 2.0 *. pi\n      let r = a +. js_cos(theta)\n      Ok(from_polar(r, theta, b))\n    }\n    Lemniscate -> {\n      // r² = a² cos(ωθ); classic figure-eight uses ω = 2\n      let theta = t *. 2.0 *. pi\n      let c = js_cos(omega *. theta)\n      case c <. 0.0 {\n        True -> Error(Nil)\n        False ->\n          case float.square_root(a *. a *. c) {\n            Error(Nil) -> Error(Nil)\n            Ok(r) -> Ok(from_polar(r, theta, b))\n          }\n      }\n    }\n    _ -> Error(Nil)\n  }\n}\n\nfn from_polar(r: Float, theta: Float, b_re: Float) -> C {\n  C(r *. js_cos(theta) +. b_re, r *. js_sin(theta))\n}\n\n/// Clamp runaway images to the viewport edge, then break so asymptotes don't bridge.\nfn world_marks(w: C) -> List(Mark) {\n  let #(wx0, wy0) = to_world(w)\n  let ax = float.absolute_value(wx0)\n  let ay = float.absolute_value(wy0)\n  let m = case ax >. ay {\n    True -> ax\n    False -> ay\n  }\n  case m >. y_clip {\n    True -> {\n      let s = y_clip /. m\n      [Pt(Point(wx0 *. s, wy0 *. s)), Break]\n    }\n    False -> [Pt(Point(wx0, wy0))]\n  }\n}\n\n// ── Grid maps ────────────────────────────────────────────────────────────────\n\nfn mapped_grid(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> #(List(Path), List(Path)) {\n  let levels = [-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]\n  let horiz =\n    list.index_map(levels, fn(im, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        True,\n        im,\n        domain_min,\n        domain_max,\n        14.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  let vert =\n    list.index_map(levels, fn(re, i) {\n      sample_line(\n        f,\n        a,\n        omega,\n        b,\n        False,\n        re,\n        domain_min,\n        domain_max,\n        26.0 +. int.to_float(i) *. 1.2,\n      )\n    })\n    |> list.flatten\n  #(horiz, vert)\n}\n\nfn sample_line(\n  f: ComplexFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  horizontal: Bool,\n  fixed: Float,\n  varying_min: Float,\n  varying_max: Float,\n  start_base: Float,\n) -> List(Path) {\n  let marks =\n    list.repeat(Nil, samples_per_line + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(samples_per_line)\n      let varying = varying_min +. t *. { varying_max -. varying_min }\n      let z = case horizontal {\n        True -> C(varying, fixed)\n        False -> C(fixed, varying)\n      }\n      case apply_map(f, z, a, omega, b) {\n        Error(Nil) -> [Break]\n        Ok(w) -> world_marks(w)\n      }\n    })\n    |> list.flatten\n  paths_from_marks(marks, start_base, 10.0, 2.2)\n}\n\nfn apply_map(\n  f: ComplexFn,\n  z: C,\n  a: Float,\n  omega: Float,\n  b: Float,\n) -> Result(C, Nil) {\n  // Input shift on the Re axis: f(z − b), then optional ω scaling, then a·w.\n  let shifted = C(z.re -. b, z.im)\n  let scaled_in = case f {\n    Exp | Sin | Cos | Power -> c_scale(shifted, omega)\n    _ -> shifted\n  }\n  use w <- result.try(eval(f, scaled_in, omega))\n  Ok(c_scale(w, a))\n}\n\nfn eval(f: ComplexFn, z: C, omega: Float) -> Result(C, Nil) {\n  case f {\n    Identity -> Ok(z)\n    Square -> Ok(c_mul(z, z))\n    Cube -> Ok(c_mul(c_mul(z, z), z))\n    Reciprocal -> c_inv(z)\n    Conjugate -> Ok(C(z.re, 0.0 -. z.im))\n    Exp -> Ok(c_exp(z))\n    Sin -> Ok(c_sin(z))\n    Cos -> Ok(c_cos(z))\n    Sqrt -> c_sqrt(z)\n    Log -> c_log(z)\n    Power -> c_pow(z, omega)\n    Modulus -> Ok(C(c_abs(z), 0.0))\n    Arg -> Ok(C(js_atan2(z.im, z.re), 0.0))\n    // Polar variants never reach eval.\n    Circle\n    | CircleCos\n    | CircleSin\n    | ArchimedesSpiral\n    | LogSpiral\n    | RoseCos\n    | RoseSin\n    | Cardioid\n    | Limacon\n    | Lemniscate -> Error(Nil)\n  }\n}\n\nfn c_scale(z: C, s: Float) -> C {\n  C(z.re *. s, z.im *. s)\n}\n\nfn c_mul(z: C, w: C) -> C {\n  C(z.re *. w.re -. z.im *. w.im, z.re *. w.im +. z.im *. w.re)\n}\n\nfn c_abs(z: C) -> Float {\n  float.square_root(z.re *. z.re +. z.im *. z.im)\n  |> result_or_zero\n}\n\nfn result_or_zero(r: Result(Float, Nil)) -> Float {\n  case r {\n    Ok(v) -> v\n    Error(Nil) -> 0.0\n  }\n}\n\nfn c_inv(z: C) -> Result(C, Nil) {\n  let n = z.re *. z.re +. z.im *. z.im\n  // Gap only at the pole; large |1/z| is clamped to the viewport edge.\n  case n <. 0.0025 {\n    True -> Error(Nil)\n    False -> Ok(C(z.re /. n, 0.0 -. z.im /. n))\n  }\n}\n\nfn c_exp(z: C) -> C {\n  let ex = float.exponential(z.re)\n  C(ex *. js_cos(z.im), ex *. js_sin(z.im))\n}\n\nfn sinh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e -. inv } /. 2.0\n}\n\nfn cosh(x: Float) -> Float {\n  let e = float.exponential(x)\n  let inv = float.exponential(0.0 -. x)\n  { e +. inv } /. 2.0\n}\n\nfn c_sin(z: C) -> C {\n  C(js_sin(z.re) *. cosh(z.im), js_cos(z.re) *. sinh(z.im))\n}\n\nfn c_cos(z: C) -> C {\n  C(js_cos(z.re) *. cosh(z.im), 0.0 -. js_sin(z.re) *. sinh(z.im))\n}\n\nfn c_sqrt(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.0001 {\n    True -> Ok(C(0.0, 0.0))\n    False -> {\n      let theta = js_atan2(z.im, z.re)\n      let half = theta /. 2.0\n      case float.square_root(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(root) -> Ok(C(root *. js_cos(half), root *. js_sin(half)))\n      }\n    }\n  }\n}\n\nfn c_log(z: C) -> Result(C, Nil) {\n  let r = c_abs(z)\n  case r <. 0.01 {\n    True -> Error(Nil)\n    False ->\n      case float.logarithm(r) {\n        Error(Nil) -> Error(Nil)\n        Ok(ln_r) -> Ok(C(ln_r, js_atan2(z.im, z.re)))\n      }\n  }\n}\n\nfn c_pow(z: C, omega: Float) -> Result(C, Nil) {\n  // z^ω = exp(ω Log z)\n  use lg <- result.try(c_log(z))\n  Ok(c_exp(c_scale(lg, omega)))\n}\n\nfn to_world(w: C) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  #(w.re *. scale, 0.0 -. w.im *. scale)\n}\n\nfn paths_from_marks(\n  marks: List(Mark),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  let runs = split_runs(marks, [], [])\n  let n_runs = list.length(runs)\n  let n_f = int.to_float(int.max(n_runs, 1))\n  list.index_map(runs, fn(run, ri) {\n    let t0 = start_base +. int.to_float(ri) /. n_f *. duration\n    let t1 = start_base +. int.to_float(ri + 1) /. n_f *. duration\n    stroke_run(run, t0, t1, thickness)\n  })\n  |> list.flatten\n}\n\nfn split_runs(\n  marks: List(Mark),\n  current: List(Point),\n  acc: List(List(Point)),\n) -> List(List(Point)) {\n  case marks {\n    [] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      list.reverse(acc)\n    }\n    [Break, ..rest] -> {\n      let acc = case current {\n        [] | [_] -> acc\n        _ -> [list.reverse(current), ..acc]\n      }\n      split_runs(rest, [], acc)\n    }\n    [Pt(p), ..rest] -> split_runs(rest, [p, ..current], acc)\n  }\n}\n\nfn stroke_run(\n  points: List(Point),\n  t0: Float,\n  t1: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      let span = t1 -. t0\n      do_stroke(a, [b, ..rest], 0, n_f, t0, span, thickness, [])\n    }\n  }\n}\n\nfn do_stroke(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  t0: Float,\n  span: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 120.0 {\n        True -> acc\n        False -> {\n          let s0 = t0 +. int.to_float(i) /. n_f *. span\n          let s1 = t0 +. int.to_float(i + 1) /. n_f *. span\n          [Path(Line(prev, next), s0, s1, thickness), ..acc]\n        }\n      }\n      do_stroke(next, tail, i + 1, n_f, t0, span, thickness, acc)\n    }\n  }\n}\n","new_content_size":18516,"new_hash":"25498bc89fed104b73af996c5cec0df4f454250c73aa78e015b65e89731f2a6f","old_hash":"7c42f45abb58f618746e2e7f826329157b8abd6dbee461f45ad9423daf66c0a5","operation":"modify","path":"src/complex_math.gleam"},"hash":"4a26177102068a9bf5e042d993bed0ef4e6eb26c97e3ef6a061dacd8b5a0af92","kind":"fs.external_change","prev_hash":"b43c1e5c2629b1c376a833e091e3b423fb1d437261f26bbea0db149a362c1e39","seq":401,"t":5991695,"wall":"2026-11-25T22:44:52.956Z"}
