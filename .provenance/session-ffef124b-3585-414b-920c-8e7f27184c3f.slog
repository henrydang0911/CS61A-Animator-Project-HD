{"data":{"diff_size":27,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderDot, type RenderLabel, RenderDot, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Unit step (Heaviside): 0 for x < b, 1 for x ≥ b.\n  Step\n  /// Discrete-style impulse at x = b (Kronecker / δ spike on the plot).\n  Kronecker\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// True when the slope slider m applies (line y = mx − b).\npub fn uses_slope(f: MathFn) -> Bool {\n  case f {\n    Identity -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    Step -> \"y=step\"\n    Kronecker -> \"y=delta\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = mx − b\"\n    Square -> \"y = (x − b)²\"\n    Cube -> \"y = (x − b)³\"\n    ScaledSine -> \"y = a·sin(ω(x − b))\"\n    ScaledCosine -> \"y = a·cos(ω(x − b))\"\n    Tangent -> \"y = tan(x − b)\"\n    Exp -> \"y = exp(x − b)\"\n    Ln -> \"y = ln(x − b)\"\n    Sqrt -> \"y = √(x − b)\"\n    Reciprocal -> \"y = 1/(x − b)\"\n    Step -> \"y = u(x − b)  (step / Heaviside)\"\n    Kronecker -> \"y = δ(x − b)  (Kronecker spike)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Step,\n    Kronecker,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=step\" -> Step\n    \"y=delta\" -> Kronecker\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// Most plots use f(x − b). The line is y = mx − b. Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n  m: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let m_f = int.to_float(int.clamp(m, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f, m_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(list.append(axis_strokes, curve), labels))\n    }\n  }\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(\n  f: MathFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, a, omega, b, m) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(\n  f: MathFn,\n  x: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> Result(Float, Nil) {\n  let u = x -. b\n  case f {\n    // Line through slope-intercept form y = mx − b (b from the shift slider).\n    Identity -> Ok(m *. x -. b)\n    Square -> Ok(u *. u)\n    Cube -> Ok(u *. u *. u)\n    ScaledSine -> Ok(a *. js_sin(omega *. u))\n    ScaledCosine -> Ok(a *. js_cos(omega *. u))\n    Tangent -> {\n      let c = js_cos(u)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(u))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(u)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(u)\n    Sqrt -> float.square_root(u)\n    Reciprocal ->\n      case float.absolute_value(u) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. u)\n      }\n    // Heaviside unit step at x = b.\n    Step ->\n      case u <. 0.0 {\n        True -> Ok(0.0)\n        False -> Ok(1.0)\n      }\n    // Narrow unit spike at x = b (continuous plot of a Kronecker / δ impulse).\n    Kronecker ->\n      case float.absolute_value(u) <. 0.12 {\n        True -> Ok(1.0)\n        False -> Ok(0.0)\n      }\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":9821,"new_hash":"2716905686a28969cccbed4b956ae6fd613b4130079ea4b10936be9de1edc47d","old_hash":"ee19ba907975ad25920d97a7afd417ec23a20e2e7a03b3fc4afd0fdc7c9328e7","operation":"modify","path":"src/math.gleam"},"hash":"0b28f42700d34da62a4962873525c1bbc8a7474f292c64ade17c62b4841b28a9","kind":"fs.external_change","prev_hash":"cbd2594ac86f49d73e85c835458b0fe2d43bef56841b956aeab152f1ba3c76ed","seq":222,"t":3842352,"wall":"2026-11-25T22:09:11.223Z"}
{"data":{"diff_size":1382,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderDot, type RenderLabel, RenderDot, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Unit step (Heaviside): 0 for x < b, 1 for x ≥ b.\n  Step\n  /// Discrete-style impulse at x = b (Kronecker / δ spike on the plot).\n  Kronecker\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// True when the slope slider m applies (line y = mx − b).\npub fn uses_slope(f: MathFn) -> Bool {\n  case f {\n    Identity -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    Step -> \"y=step\"\n    Kronecker -> \"y=delta\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = mx − b\"\n    Square -> \"y = (x − b)²\"\n    Cube -> \"y = (x − b)³\"\n    ScaledSine -> \"y = a·sin(ω(x − b))\"\n    ScaledCosine -> \"y = a·cos(ω(x − b))\"\n    Tangent -> \"y = tan(x − b)\"\n    Exp -> \"y = exp(x − b)\"\n    Ln -> \"y = ln(x − b)\"\n    Sqrt -> \"y = √(x − b)\"\n    Reciprocal -> \"y = 1/(x − b)\"\n    Step -> \"y = u(x − b)  (step / Heaviside)\"\n    Kronecker -> \"y = δ(x − b)  (Kronecker spike)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Step,\n    Kronecker,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=step\" -> Step\n    \"y=delta\" -> Kronecker\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel), dots: List(RenderDot))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// Most plots use f(x − b). The line is y = mx − b. Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n  m: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    Kronecker -> {\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(\n        list.append(axis_strokes, kronecker_stem(b_f)),\n        labels,\n        kronecker_dots(b_f),\n      ))\n    }\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let m_f = int.to_float(int.clamp(m, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f, m_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      let dots = case f {\n        Step -> step_dots(b_f)\n        _ -> []\n      }\n      Ok(Plot(list.append(axis_strokes, curve), labels, dots))\n    }\n  }\n}\n\nfn world_y(y_math: Float) -> Float {\n  0.0 -. math_to_world_x(y_math)\n}\n\n/// Lollipop stick: vertical segment from (b, 0) to (b, 1).\nfn kronecker_stem(b: Float) -> List(Path) {\n  let wx = math_to_world_x(b)\n  [\n    Path(\n      Line(Point(wx, world_y(0.0)), Point(wx, world_y(1.0))),\n      12.0,\n      28.0,\n      4.0,\n    ),\n  ]\n}\n\n/// Dot on top of the lollipop at y = 1 (the Kronecker mass at x = b).\nfn kronecker_dots(b: Float) -> List(RenderDot) {\n  [\n    RenderDot(\n      math_to_world_x(b),\n      world_y(1.0),\n      12.0,\n      \"#58C4DD\",\n      True,\n      24.0,\n      32.0,\n    ),\n  ]\n}\n\n/// Step at x = b: open circle at the left limit (0), filled at the value H(0)=1.\nfn step_dots(b: Float) -> List(RenderDot) {\n  let wx = math_to_world_x(b)\n  let color = \"#58C4DD\"\n  [\n    // Left-hand limit y → 0 (not attained if right-continuous).\n    RenderDot(wx, world_y(0.0), 11.0, color, False, 20.0, 28.0),\n    // Value at the jump: H(0) = 1.\n    RenderDot(wx, world_y(1.0), 11.0, color, True, 20.0, 28.0),\n  ]\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(\n  f: MathFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, a, omega, b, m) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(\n  f: MathFn,\n  x: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> Result(Float, Nil) {\n  let u = x -. b\n  case f {\n    // Line through slope-intercept form y = mx − b (b from the shift slider).\n    Identity -> Ok(m *. x -. b)\n    Square -> Ok(u *. u)\n    Cube -> Ok(u *. u *. u)\n    ScaledSine -> Ok(a *. js_sin(omega *. u))\n    ScaledCosine -> Ok(a *. js_cos(omega *. u))\n    Tangent -> {\n      let c = js_cos(u)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(u))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(u)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(u)\n    Sqrt -> float.square_root(u)\n    Reciprocal ->\n      case float.absolute_value(u) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. u)\n      }\n    // Heaviside unit step at x = b.\n    Step ->\n      case u <. 0.0 {\n        True -> Ok(0.0)\n        False -> Ok(1.0)\n      }\n    // Narrow unit spike at x = b (continuous plot of a Kronecker / δ impulse).\n    Kronecker ->\n      case float.absolute_value(u) <. 0.12 {\n        True -> Ok(1.0)\n        False -> Ok(0.0)\n      }\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":11205,"new_hash":"c3caff6c892bf7f3b9ea2923645c92ef7555db66176b63d37476a2d04f07459c","old_hash":"2716905686a28969cccbed4b956ae6fd613b4130079ea4b10936be9de1edc47d","operation":"modify","path":"src/math.gleam"},"hash":"029a5bf5b7ee642ee5e4468f0a6819bf324764f7d5a07ad72b4893d6d33baed9","kind":"fs.external_change","prev_hash":"0b28f42700d34da62a4962873525c1bbc8a7474f292c64ade17c62b4841b28a9","seq":223,"t":3849903,"wall":"2026-11-25T22:09:18.774Z"}
{"data":{"diff_size":4,"new_content":"//// Math mode: Desmos-like y = f(x) plotting with a Manim-style Create reveal.\n//// Sampling uses host floats; the canvas still draws 2D Line Paths only.\n\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport render.{type RenderDot, type RenderLabel, RenderDot, RenderLabel}\nimport shape.{type Path, type Point, Line, Path, Point}\n\n@external(javascript, \"./math_ffi.mjs\", \"sin\")\nfn js_sin(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"cos\")\nfn js_cos(x: Float) -> Float\n\n@external(javascript, \"./math_ffi.mjs\", \"tan\")\nfn js_tan(x: Float) -> Float\n\n/// Preset formulas shown in the Math mode dropdown.\n/// Wave presets are a·sin(ωx) / a·cos(ωx); defaults a=1, ω=1 act like sin/cos.\npub type MathFn {\n  Identity\n  Square\n  Cube\n  ScaledSine\n  ScaledCosine\n  Tangent\n  Exp\n  Ln\n  Sqrt\n  Reciprocal\n  /// Unit step (Heaviside): 0 for x < b, 1 for x ≥ b.\n  Step\n  /// Discrete-style impulse at x = b (Kronecker / δ spike on the plot).\n  Kronecker\n  /// Explicitly unsupported — surfaces the 3D error.\n  ThreeDUnsupported\n}\n\npub type MathError {\n  Unsupported3D\n}\n\n/// True when a and ω sliders apply (periodic wave presets).\npub fn uses_wave_params(f: MathFn) -> Bool {\n  case f {\n    ScaledSine | ScaledCosine -> True\n    _ -> False\n  }\n}\n\n/// True when the slope slider m applies (line y = mx − b).\npub fn uses_slope(f: MathFn) -> Bool {\n  case f {\n    Identity -> True\n    _ -> False\n  }\n}\n\n/// Dropdown value ↔ preset.\npub fn fn_id(f: MathFn) -> String {\n  case f {\n    Identity -> \"y=x\"\n    Square -> \"y=x^2\"\n    Cube -> \"y=x^3\"\n    ScaledSine -> \"y=a*sin(wx)\"\n    ScaledCosine -> \"y=a*cos(wx)\"\n    Tangent -> \"y=tan(x)\"\n    Exp -> \"y=exp(x)\"\n    Ln -> \"y=ln(x)\"\n    Sqrt -> \"y=sqrt(x)\"\n    Reciprocal -> \"y=1/x\"\n    Step -> \"y=step\"\n    Kronecker -> \"y=delta\"\n    ThreeDUnsupported -> \"3d\"\n  }\n}\n\npub fn fn_label(f: MathFn) -> String {\n  case f {\n    Identity -> \"y = mx − b\"\n    Square -> \"y = (x − b)²\"\n    Cube -> \"y = (x − b)³\"\n    ScaledSine -> \"y = a·sin(ω(x − b))\"\n    ScaledCosine -> \"y = a·cos(ω(x − b))\"\n    Tangent -> \"y = tan(x − b)\"\n    Exp -> \"y = exp(x − b)\"\n    Ln -> \"y = ln(x − b)\"\n    Sqrt -> \"y = √(x − b)\"\n    Reciprocal -> \"y = 1/(x − b)\"\n    Step -> \"y = u(x − b)  (step / Heaviside)\"\n    Kronecker -> \"y = δ(x − b)  (Kronecker spike)\"\n    ThreeDUnsupported -> \"z = f(x,y)  (3D — unsupported)\"\n  }\n}\n\npub fn all_functions() -> List(MathFn) {\n  [\n    ScaledSine,\n    ScaledCosine,\n    Identity,\n    Square,\n    Cube,\n    Step,\n    Kronecker,\n    Tangent,\n    Exp,\n    Ln,\n    Sqrt,\n    Reciprocal,\n    ThreeDUnsupported,\n  ]\n}\n\npub fn parse_fn_id(id: String) -> MathFn {\n  case id {\n    \"y=x\" -> Identity\n    \"y=x^2\" -> Square\n    \"y=x^3\" -> Cube\n    \"y=a*sin(wx)\" -> ScaledSine\n    \"y=a*cos(wx)\" -> ScaledCosine\n    \"y=tan(x)\" -> Tangent\n    \"y=exp(x)\" -> Exp\n    \"y=ln(x)\" -> Ln\n    \"y=sqrt(x)\" -> Sqrt\n    \"y=1/x\" -> Reciprocal\n    \"y=step\" -> Step\n    \"y=delta\" -> Kronecker\n    \"3d\" -> ThreeDUnsupported\n    _ -> ScaledSine\n  }\n}\n\npub fn error_message(error: MathError) -> String {\n  case error {\n    Unsupported3D -> \"3D: Unsupported Functionality\"\n  }\n}\n\n/// World units: plot math-x in about [-5, 5] across the canvas width.\nconst x_math_min = -5.0\n\nconst x_math_max = 5.0\n\nconst world_half = 450.0\n\nconst sample_count = 180\n\nconst y_clip = 480.0\n\npub type Plot {\n  Plot(paths: List(Path), labels: List(RenderLabel), dots: List(RenderDot))\n}\n\n/// Build axes, tick marks, labels, and curve for Manim-style reveal.\n/// Most plots use f(x − b). The line is y = mx − b. Waves also use amplitude\n/// `a` (−5…5) and angular frequency `omega` (1…10).\npub fn plot(\n  f: MathFn,\n  a: Int,\n  omega: Int,\n  b: Int,\n  m: Int,\n) -> Result(Plot, MathError) {\n  case f {\n    ThreeDUnsupported -> Error(Unsupported3D)\n    Kronecker -> {\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let #(axis_strokes, labels) = axis_decorations()\n      Ok(Plot(\n        list.append(axis_strokes, kronecker_stem(b_f)),\n        labels,\n        kronecker_dots(b_f),\n      ))\n    }\n    f -> {\n      let a_f = int.to_float(int.clamp(a, -5, 5))\n      let w_f = int.to_float(int.clamp(omega, 1, 10))\n      let b_f = int.to_float(int.clamp(b, -5, 5))\n      let m_f = int.to_float(int.clamp(m, -5, 5))\n      let curve = sample_curve(f, a_f, w_f, b_f, m_f)\n      let #(axis_strokes, labels) = axis_decorations()\n      let dots = case f {\n        Step -> step_dots(b_f)\n        _ -> []\n      }\n      Ok(Plot(list.append(axis_strokes, curve), labels, dots))\n    }\n  }\n}\n\nfn world_y(y_math: Float) -> Float {\n  0.0 -. math_to_world_x(y_math)\n}\n\n/// Lollipop stick: vertical segment from (b, 0) to (b, 1).\nfn kronecker_stem(b: Float) -> List(Path) {\n  let wx = math_to_world_x(b)\n  [\n    Path(\n      Line(Point(wx, world_y(0.0)), Point(wx, world_y(1.0))),\n      12.0,\n      28.0,\n      4.0,\n    ),\n  ]\n}\n\n/// Dot on top of the lollipop at y = 1 (the Kronecker mass at x = b).\nfn kronecker_dots(b: Float) -> List(RenderDot) {\n  [\n    RenderDot(\n      math_to_world_x(b),\n      world_y(1.0),\n      12.0,\n      \"#58C4DD\",\n      True,\n      24.0,\n      32.0,\n    ),\n  ]\n}\n\n/// Step at x = b: open circle at the left limit (0), filled at the value H(0)=1.\nfn step_dots(b: Float) -> List(RenderDot) {\n  let wx = math_to_world_x(b)\n  let color = \"#58C4DD\"\n  [\n    // Left-hand limit y → 0 (not attained if right-continuous).\n    RenderDot(wx, world_y(0.0), 11.0, color, False, 20.0, 28.0),\n    // Value at the jump: H(0) = 1.\n    RenderDot(wx, world_y(1.0), 11.0, color, True, 20.0, 28.0),\n  ]\n}\n\nfn axis_decorations() -> #(List(Path), List(RenderLabel)) {\n  let axis_t = 2.0\n  let tick_t = 1.5\n  let tick_len = 12.0\n  let label_color = \"#b8b8d0\"\n  let axis_color_time_x = #(0.0, 8.0)\n  let axis_color_time_y = #(4.0, 12.0)\n\n  let x_axis =\n    Path(\n      Line(Point(0.0 -. world_half, 0.0), Point(world_half, 0.0)),\n      axis_color_time_x.0,\n      axis_color_time_x.1,\n      axis_t,\n    )\n  let y_axis =\n    Path(\n      Line(Point(0.0, world_half), Point(0.0, 0.0 -. world_half)),\n      axis_color_time_y.0,\n      axis_color_time_y.1,\n      axis_t,\n    )\n\n  // Integer ticks at math −4…4 (skip 0 — the origin).\n  let tick_maths = [-4, -3, -2, -1, 1, 2, 3, 4]\n  let x_ticks =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(wx, tick_len), Point(wx, 0.0 -. tick_len)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n  let y_ticks =\n    list.map(tick_maths, fn(k) {\n      // Positive math-y is up → negative world y.\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      Path(\n        Line(Point(0.0 -. tick_len, wy), Point(tick_len, wy)),\n        8.0,\n        12.0,\n        tick_t,\n      )\n    })\n\n  let x_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wx = math_to_world_x(int.to_float(k))\n      RenderLabel(\n        wx,\n        28.0,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n  let y_tick_labels =\n    list.map(tick_maths, fn(k) {\n      let wy = 0.0 -. math_to_world_x(int.to_float(k))\n      RenderLabel(\n        0.0 -. 28.0,\n        wy,\n        int.to_string(k),\n        label_color,\n        22.0,\n        10.0,\n        14.0,\n      )\n    })\n\n  let axis_names = [\n    RenderLabel(world_half -. 24.0, 36.0, \"x\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n    RenderLabel(36.0, 0.0 -. world_half +. 24.0, \"y\", \"#e8e8ff\", 32.0, 10.0, 14.0),\n  ]\n\n  let paths = list.flatten([[x_axis, y_axis], x_ticks, y_ticks])\n  let labels = list.flatten([x_tick_labels, y_tick_labels, axis_names])\n  #(paths, labels)\n}\n\nfn math_to_world_x(x_math: Float) -> Float {\n  let scale = world_half /. x_math_max\n  x_math *. scale\n}\n\nfn sample_curve(\n  f: MathFn,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> List(Path) {\n  let xs =\n    list.repeat(Nil, sample_count + 1)\n    |> list.index_map(fn(_, i) {\n      let t = int.to_float(i) /. int.to_float(sample_count)\n      x_math_min +. t *. { x_math_max -. x_math_min }\n    })\n\n  let points =\n    list.filter_map(xs, fn(x_math) {\n      case eval(f, x_math, a, omega, b, m) {\n        Error(Nil) -> Error(Nil)\n        Ok(y_math) -> {\n          let #(wx, wy) = to_world(x_math, y_math)\n          case float.absolute_value(wy) >. y_clip {\n            True -> Error(Nil)\n            False -> Ok(Point(wx, wy))\n          }\n        }\n      }\n    })\n\n  // Stagger segment Create times so the graph draws left → right after axes.\n  let start_base = 12.0\n  let duration = 36.0\n  segments(points, start_base, duration, 3.0)\n}\n\nfn eval(\n  f: MathFn,\n  x: Float,\n  a: Float,\n  omega: Float,\n  b: Float,\n  m: Float,\n) -> Result(Float, Nil) {\n  let u = x -. b\n  case f {\n    // Line through slope-intercept form y = mx − b (b from the shift slider).\n    Identity -> Ok(m *. x -. b)\n    Square -> Ok(u *. u)\n    Cube -> Ok(u *. u *. u)\n    ScaledSine -> Ok(a *. js_sin(omega *. u))\n    ScaledCosine -> Ok(a *. js_cos(omega *. u))\n    Tangent -> {\n      let c = js_cos(u)\n      case float.absolute_value(c) <. 0.05 {\n        True -> Error(Nil)\n        False -> Ok(js_tan(u))\n      }\n    }\n    Exp -> {\n      let y = float.exponential(u)\n      case y >. 20.0 {\n        True -> Error(Nil)\n        False -> Ok(y)\n      }\n    }\n    Ln -> float.logarithm(u)\n    Sqrt -> float.square_root(u)\n    Reciprocal ->\n      case float.absolute_value(u) <. 0.08 {\n        True -> Error(Nil)\n        False -> Ok(1.0 /. u)\n      }\n    // Heaviside, right-continuous: H(u)=0 for u<0, H(0)=1, H(u)=1 for u>0.\n    // Markers at x=b show the open/filled circles for the jump.\n    Step ->\n      case u <. 0.0 {\n        True -> Ok(0.0)\n        False -> Ok(1.0)\n      }\n    // Drawn as a lollipop via special geometry; sampling unused.\n    Kronecker -> Ok(0.0)\n    ThreeDUnsupported -> Error(Nil)\n  }\n}\n\nfn to_world(x_math: Float, y_math: Float) -> #(Float, Float) {\n  let scale = world_half /. x_math_max\n  // Canvas y grows downward; flip so positive math-y goes up.\n  #(x_math *. scale, 0.0 -. y_math *. scale)\n}\n\nfn segments(\n  points: List(Point),\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n) -> List(Path) {\n  case points {\n    [] | [_] -> []\n    [a, b, ..rest] -> {\n      let n = list.length(points) - 1\n      let n_f = int.to_float(int.max(n, 1))\n      do_segments(a, [b, ..rest], 0, n_f, start_base, duration, thickness, [])\n    }\n  }\n}\n\nfn do_segments(\n  prev: Point,\n  rest: List(Point),\n  i: Int,\n  n_f: Float,\n  start_base: Float,\n  duration: Float,\n  thickness: Float,\n  acc: List(Path),\n) -> List(Path) {\n  case rest {\n    [] -> list.reverse(acc)\n    [next, ..tail] -> {\n      // Break across domain gaps / asymptotes (large jumps in world space).\n      let dx = float.absolute_value(next.x -. prev.x)\n      let dy = float.absolute_value(next.y -. prev.y)\n      let acc = case dx +. dy >. 80.0 {\n        True -> acc\n        False -> {\n          let t0 = start_base +. int.to_float(i) /. n_f *. duration\n          let t1 = start_base +. int.to_float(i + 1) /. n_f *. duration\n          [Path(Line(prev, next), t0, t1, thickness), ..acc]\n        }\n      }\n      do_segments(next, tail, i + 1, n_f, start_base, duration, thickness, acc)\n    }\n  }\n}\n","new_content_size":11200,"new_hash":"d5f5988cd7a0eaf607de1ab102108f0d33305342405c38436d20b0bb56546056","old_hash":"c3caff6c892bf7f3b9ea2923645c92ef7555db66176b63d37476a2d04f07459c","operation":"modify","path":"src/math.gleam"},"hash":"9609b0483148e6062c6a7bd5c875ce4e96b29cba834c6eeae72d62bd13ef8934","kind":"fs.external_change","prev_hash":"029a5bf5b7ee642ee5e4468f0a6819bf324764f7d5a07ad72b4893d6d33baed9","seq":224,"t":3851878,"wall":"2026-11-25T22:09:20.749Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":239},"start":{"character":0,"line":231}},"text":"    render.set_dots(plot.dots)\n    render.set_drawing(rendered)\n  })\n}\n\nfn update_math_drawing(plot: math.Plot) -> Effect(Msg) {\n  let rendered = math_render_paths(plot.paths)\n  effect.from(fn(_) {\n    render.set_labels(plot.labels)\n    render.set_dots(plot.dots)\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"7e0f77e75fd952f31f24c97d35def3cf67529abdc27f8bfc4fbea62a9194ad48","kind":"doc.change","prev_hash":"9609b0483148e6062c6a7bd5c875ce4e96b29cba834c6eeae72d62bd13ef8934","seq":225,"t":3854012,"wall":"2026-11-25T22:09:22.883Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":284},"start":{"character":0,"line":267}},"text":"    render.set_dots([])\n    render.set_drawing(rendered)\n  })\n}\n\n/// Swap geometry for a new shape_slider value without touching speed or clock.\nfn update_drawing(paths: List(Path)) -> Effect(Msg) {\n  let rendered = to_render_paths(paths)\n  effect.from(fn(_) {\n    render.set_labels([])\n    render.set_dots([])\n    render.set_drawing(rendered)\n  })\n}\n\nfn clear_drawing() -> Effect(Msg) {\n  effect.from(fn(_) {\n    render.reset_clock()\n    render.set_labels([])\n    render.set_dots([])\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"bd0f9986c74e1eaaef66f24b5d8ae737bd18b187d98720c9ccc08fc88786ce80","kind":"doc.change","prev_hash":"7e0f77e75fd952f31f24c97d35def3cf67529abdc27f8bfc4fbea62a9194ad48","seq":226,"t":3856075,"wall":"2026-11-25T22:09:24.946Z"}
