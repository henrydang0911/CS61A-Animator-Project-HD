{"data":{"content":"    PolarPlane -> {\n      let #(plot, horiz) =\n        complex_math.plot(\n          model.polar_fn,\n          model.math_amp,\n          model.math_omega,\n          model.math_shift,\n        )\n      Ok(#(plot, ComplexStyle(horiz)))\n    }\n","length":237,"path":"src\\app.gleam","range":{"end":{"character":0,"line":260},"start":{"character":0,"line":260}},"sha256":"2623e4e51a056b951c223ad57e9cfd7a64ac2988a3d12b03f51738d617dce925"},"hash":"23ec33d2178ab7aa978f406c2fce1c31d39bfc8ceca50c75965c87c2618b16f4","kind":"paste","prev_hash":"c4ae75ea425f0a4270f51eafdbf174e31492d8a93dc73b1b4568b057f78535c3","seq":320,"t":5035778,"wall":"2026-11-25T22:28:57.039Z"}
