{"data":{"diff_size":156,"new_content":"// Host-side math used by Math mode sampling (gleam/float has no trig).\n\nexport function sin(x) {\n  return Math.sin(x);\n}\n\nexport function cos(x) {\n  return Math.cos(x);\n}\n\nexport function tan(x) {\n  return Math.tan(x);\n}\n\nexport function asin(x) {\n  return Math.asin(x);\n}\n\nexport function acos(x) {\n  return Math.acos(x);\n}\n\nexport function atan(x) {\n  return Math.atan(x);\n}\n","new_content_size":378,"new_hash":"56473cd285ea4fe42bd1f5812ca991353d2db7b5269edd3cab87631118ec8a19","old_hash":"9d139c07384052f3a3cf9ab5b79ab7b623ab620d969b18f983621ac178c72498","operation":"modify","path":"src/math_ffi.mjs"},"hash":"a282d4a773434395ad1ae0b56e8e77f0b787095647b61ca30d78158acc9194a7","kind":"fs.external_change","prev_hash":"01cb4afc24c420b0e8c4e08d21c2969660e48b38c57d12a41049ef8554d4e7b9","seq":253,"t":4356365,"wall":"2026-11-25T22:17:37.626Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":649},"start":{"character":0,"line":646}},"text":"  let base = case math.uses_base_param(model.math_fn) {\n    False -> []\n    True -> {\n      let a = int.clamp(model.math_amp, 2, 10)\n      [\n        html.label([attr.class(\"slider-label slider-label-full\")], [\n          html.span([], [html.text(\"a (base) \" <> int.to_string(a))]),\n          html.input([\n            attr.type_(\"range\"),\n            attr.min(\"2\"),\n            attr.max(\"10\"),\n            attr.step(\"1\"),\n            attr.value(int.to_string(a)),\n            attr.attribute(\"title\", \"Base a for y = aˣ (2…10)\"),\n            event.on_input(fn(raw) {\n              SetMathAmp(result.unwrap(int.parse(raw), a))\n            }),\n          ]),\n        ]),\n      ]\n    }\n  }\n\n  html.div(\n    [attr.class(\"math-wave-sliders\")],\n    list.flatten([[shift], slope, wave, base]),\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"67105ffd85fa92b33d59bba72eed95a7d6a21a3c92f60df84dc3f50a83e5d7bb","kind":"doc.change","prev_hash":"a282d4a773434395ad1ae0b56e8e77f0b787095647b61ca30d78158acc9194a7","seq":254,"t":4363654,"wall":"2026-11-25T22:17:44.915Z"}
